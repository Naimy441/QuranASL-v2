":"اللَّه"},{"ar":"خَيْرُ","tr":"khayru","en":"(is the) Best","root":"خير","lem":"خَيْر"},{"ar":"ٱلرَّٰزِقِينَ","tr":"l-rāziqīna","en":"(of) the Providers","root":"رزق","lem":"رازِق"}]}]}