{"n":112,"name":"Al-Ikhlas","nameAr":"الإخلاص","meaning":"The Sincerity","ayahs":4,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","en":"Say, \"He is Allāh, [who is] One,","w":[{"ar":"قُلْ","tr":"qul","en":"Say","root":"قول","lem":"قالَ"},{"ar":"هُوَ","tr":"huwa","en":"He"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"(is) Allah","root":"أله","lem":"اللَّه"},{"ar":"أَحَدٌ","tr":"aḥadun","en":"the One","root":"أحد","lem":"أَحَد"}]},{"n":2,"juz":30,"ar":"ٱللَّهُ ٱلصَّمَدُ","en":"Allāh, the Eternal Refuge.","w":[{"ar":"ٱللَّهُ","tr":"al-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"ٱلصَّمَدُ","tr":"l-ṣamadu","en":"the Eternal, the Absolute","root":"صمد","lem":"صَمَد"}]},{"n":3,"juz":30,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","en":"He neither begets nor is born,","w":[{"ar":"لَمْ","tr":"lam","en":"Not"},{"ar":"يَلِدْ","tr":"yalid","en":"He begets","root":"ولد","lem":"وَلَدَ"},{"ar":"وَلَمْ","tr":"walam","en":"and not"},{"ar":"يُولَدْ","tr":"yūlad","en":"He is begotten","root":"ولد","lem":"وَلَدَ"}]},{"n":4,"juz":30,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","en":"Nor is there to Him any equivalent.\"","w":[{"ar":"وَلَمْ","tr":"walam","en":"And not"},{"ar":"يَكُن","tr":"yakun","en":"is","root":"كون","lem":"كانَ"},{"ar":"لَّهُۥ","tr":"lahu","en":"for Him"},{"ar":"كُفُوًا","tr":"kufuwan","en":"equivalent","root":"كفأ","lem":"كُفُو"},{"ar":"أَحَدٌۢ","tr":"aḥadun","en":"any [one]","root":"أحد","lem":"أَحَد"}]}]}