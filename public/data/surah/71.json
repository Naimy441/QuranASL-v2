فّار"}]},{"n":11,"juz":29,"ar":"يُرْسِلِ ٱلسَّمَآءَ عَلَيْكُم مِّدْرَارًا","en":"He will send [rain from] the sky upon you in [continuing] showers","w":[{"ar":"يُرْسِلِ","tr":"yur'sili","en":"He will send down","root":"رسل","lem":"أَرْسَلَ"},{"ar":"ٱلسَّمَآءَ","tr":"l-samāa","en":"(rain from) the sky","root":"سمو","lem":"سَماء"},{"ar":"عَلَيْكُم","tr":"ʿalaykum","en":"upon you"},{"ar":"مِّدْرَارًۭا","tr":"mid'rāran","en":"(in) abundance","root":"درر","lem":"مِدْرار"}]},{"n":12,"juz":29,"ar":"وَيُمْدِدْكُم بِأَمْوَٰلٍ وَبَنِينَ وَيَجْعَل لَّكُمْ جَنَّـٰتٍ وَيَجْعَل لَّكُمْ أَنْهَـٰرًا","en":"And give you increase in wealth and children and provide for you gardens and provide for you rivers.","w":[{"ar":"وَيُمْدِدْكُم","tr":"wayum'did'kum","en":"And provide you","root":"مدد","lem":"أَمَدَّ"},{"ar":"بِأَمْوَٰلٍۢ","tr":"bi-amwālin","en":"with wealth","root":"مول","lem":"مال"},{"ar":"وَبَنِينَ","tr":"wabanīna","en":"and children","root":"بني","lem":"بُنَىّ"},{"ar":"وَيَجْعَل","tr":"wayajʿal","en":"and make","root":"جعل","lem":"جَعَلَ"},{"ar":"لَّكُمْ","tr":"lakum","en":"for you"},{"ar":"جَنَّـٰتٍۢ","tr":"jannātin","en":"gardens","root":"جنن","lem":"جَنَّة"},{"ar":"وَيَجْعَل","tr":"wayajʿal","en":"and make","root":"جعل","lem":"جَعَلَ"},{"ar":"لَّكُمْ","tr":"lakum","en":"for you"},{"ar":"أَنْهَـٰرًۭا","tr":"anhāran","en":"rivers","root":"نهر","lem":"نَهَر"}]},{"n":13,"juz":29,"ar":"مَّا لَكُمْ لَا تَرْجُونَ لِلَّهِ وَقَارًا","en":"What is [the matter] with you that you do not attribute to Allāh [due] grandeur","w":[{"ar":"مَّا","tr":"mā","en":"What"},{"ar":"لَكُمْ","tr":"lakum","en":"(is) for you"},{"ar":"لَا","tr":"lā","en":"not"},{"ar":"تَرْجُونَ","tr":"tarjūna","en":"you attribute","root":"رجو","lem":"يَرْجُوا۟"},{"ar":"لِلَّهِ","tr":"lillahi","en":"to Allah","root":"أله","lem":"اللَّه"},{"ar":"وَقَارًۭا","tr":"waqāran","en":"grandeur","root":"وقر","lem":"وَقار"}]},{"n":14,"juz":29,"ar":"وَقَدْ خَلَقَكُمْ أَطْوَارًا","en":"While He has created you in stages?","w":[{"a