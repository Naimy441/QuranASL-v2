{"n":113,"name":"Al-Falaq","nameAr":"الفلق","meaning":"The Daybreak","ayahs":5,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","en":"Say, \"I seek refuge in the Lord of daybreak","w":[{"ar":"قُلْ","tr":"qul","en":"Say","root":"قول","lem":"قالَ"},{"ar":"أَعُوذُ","tr":"aʿūdhu","en":"I seek refuge","root":"عوذ","lem":"عُذْ"},{"ar":"بِرَبِّ","tr":"birabbi","en":"in (the) Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلْفَلَقِ","tr":"l-falaqi","en":"(of) the dawn","root":"فلق","lem":"فَلَق"}]},{"n":2,"juz":30,"ar":"مِن شَرِّ مَا خَلَقَ","en":"From the evil of that which He created","w":[{"ar":"مِن","tr":"min","en":"From"},{"ar":"شَرِّ","tr":"sharri","en":"(the) evil","root":"شرر","lem":"شَرّ"},{"ar":"مَا","tr":"mā","en":"(of) what"},{"ar":"خَلَقَ","tr":"khalaqa","en":"He created","root":"خلق","lem":"خَلَقَ"}]},{"n":3,"juz":30,"ar":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","en":"And from the evil of darkness when it settles","w":[{"ar":"وَمِن","tr":"wamin","en":"And from"},{"ar":"شَرِّ","tr":"sharri","en":"(the) evil","root":"شرر","lem":"شَرّ"},{"ar":"غَاسِقٍ","tr":"ghāsiqin","en":"(of) darkness","root":"غسق","lem":"غاسِق"},{"ar":"إِذَا","tr":"idhā","en":"when"},{"ar":"وَقَبَ","tr":"waqaba","en":"it spreads","root":"وقب","lem":"وَقَبَ"}]},{"n":4,"juz":30,"ar":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ","en":"And from the evil of the blowers in knots","w":[{"ar":"وَمِن","tr":"wamin","en":"And from"},{"ar":"شَرِّ","tr":"sharri","en":"(the) evil","root":"شرر","lem":"شَرّ"},{"ar":"ٱلنَّفَّـٰثَـٰتِ","tr":"l-nafāthāti","en":"(of) the blowers","root":"نفث","lem":"نَفّاثَة"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"ٱلْعُقَدِ","tr":"l-ʿuqadi","en":"the knots","root":"عقد","lem":"عُقْدَة"}]},{"n":5,"juz":30,"ar":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","en":"And from the evil of an envier when he envies.\"","w":[{"ar":"وَمِن","tr":"wamin","en":"And from"},{"ar":"شَرِّ","tr":"sharri","en":"(the) evil","root":"شرر","lem":"شَرّ"},{"ar":"حَاسِدٍ","tr":"ḥāsi