{"n":74,"name":"Al-Muddaththir","nameAr":"المدثر","meaning":"The Cloaked One","ayahs":56,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":29,"ar":"يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ","en":"O you who covers himself [with a garment],","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O you","root":"أيي","lem":"أَيّ"},{"ar":"ٱلْمُدَّثِّرُ","tr":"l-mudathiru","en":"who covers himself","root":"دثر","lem":"مُدَّثِّر"}]},{"n":2,"juz":29,"ar":"قُمْ فَأَنذِرْ","en":"Arise and warn.","w":[{"ar":"قُمْ","tr":"qum","en":"Stand up","root":"قوم","lem":"قامَ"},{"ar":"فَأَنذِرْ","tr":"fa-andhir","en":"and warn","root":"نذر","lem":"أَنذَرَ"}]},{"n":3,"juz":29,"ar":"وَرَبَّكَ فَكَبِّرْ","en":"And your Lord glorify.","w":[{"ar":"وَرَبَّكَ","tr":"warabbaka","en":"And your Lord","root":"ربب","lem":"رَبّ"},{"ar":"فَكَبِّرْ","tr":"fakabbir","en":"magnify","root":"كبر","lem":"كَبِّرْ"}]},{"n":4,"juz":29,"ar":"وَثِيَابَكَ فَطَهِّرْ","en":"And your clothing purify.","w":[{"ar":"وَثِيَابَكَ","tr":"wathiyābaka","en":"And your clothing","root":"ثوب","lem":"ثِياب"},{"ar":"فَطَهِّرْ","tr":"faṭahhir","en":"purify","root":"طهر","lem":"طَهَّرَ"}]},{"n":5,"juz":29,"ar":"وَٱلرُّجْزَ فَٱهْجُرْ","en":"And uncleanliness avoid.","w":[{"ar":"وَٱلرُّجْزَ","tr":"wal-ruj'za","en":"And uncleanliness","root":"رجز","lem":"رُجْز"},{"ar":"فَٱهْجُرْ","tr":"fa-uh'jur","en":"avoid","root":"هجر","lem":"اهْجُرْ"}]},{"n":6,"juz":29,"ar":"وَلَا تَمْنُن تَسْتَكْثِرُ","en":"And do not confer favor to acquire more.","w":[{"ar":"وَلَا","tr":"walā","en":"And (do) not"},{"ar":"تَمْنُن","tr":"tamnun","en":"confer favor","root":"منن","lem":"مَنَّ"},{"ar":"تَسْتَكْثِرُ","tr":"tastakthiru","en":"(to) acquire more","root":"كثر","lem":"اسْتَكْثَرْ"}]},{"n":7,"juz":29,"ar":"وَلِرَبِّكَ فَٱصْبِرْ","en":"But for your Lord be patient.","w":[{"ar":"وَلِرَبِّكَ","tr":"walirabbika","en":"And for your Lord","root":"ربب","lem":"رَبّ"},{"ar":"فَٱصْبِرْ","tr":"fa-iṣ'bir","en":"be patient","root":"صبر","lem":"صَبَرَ"}]},{"n":8,"juz":29,"ar":"فَإِذ