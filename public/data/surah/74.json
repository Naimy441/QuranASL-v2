ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","en":"And they will not remember except that Allāh wills. He is worthy of fear and adequate for [granting] forgiveness.","w":[{"ar":"وَمَا","tr":"wamā","en":"And not"},{"ar":"يَذْكُرُونَ","tr":"yadhkurūna","en":"will pay heed","root":"ذكر","lem":"ذَكَرَ"},{"ar":"إِلَّآ","tr":"illā","en":"except"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"يَشَآءَ","tr":"yashāa","en":"wills","root":"شيأ","lem":"شاءَ"},{"ar":"ٱللَّهُ ۚ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"هُوَ","tr":"huwa","en":"He"},{"ar":"أَهْلُ","tr":"ahlu","en":"(is) worthy","root":"أهل","lem":"أَهْل"},{"ar":"ٱلتَّقْوَىٰ","tr":"l-taqwā","en":"to be feared","root":"وقي","lem":"تَقْوَى"},{"ar":"وَأَهْلُ","tr":"wa-ahlu","en":"and worthy","root":"أهل","lem":"أَهْل"},{"ar":"ٱلْمَغْفِرَةِ","tr":"l-maghfirati","en":"to forgive","root":"غفر","lem":"مَغْفِرَة"}]}]}