ِيلَ","tr":"qīla","en":"it is said","root":"قول","lem":"قالَ"},{"ar":"ٱنشُزُوا۟","tr":"unshuzū","en":"Rise up","root":"نشز","lem":"انشُزُ"},{"ar":"فَٱنشُزُوا۟","tr":"fa-unshuzū","en":"then rise up","root":"نشز","lem":"انشُزُ"},{"ar":"يَرْفَعِ","tr":"yarfaʿi","en":"Allah will raise","root":"رفع","lem":"رَفَعَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah will raise","root":"أله","lem":"اللَّه"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"believe","root":"أمن","lem":"آمَنَ"},{"ar":"مِنكُمْ","tr":"minkum","en":"among you"},{"ar":"وَٱلَّذِينَ","tr":"wa-alladhīna","en":"and those who"},{"ar":"أُوتُوا۟","tr":"ūtū","en":"were given","root":"أتي","lem":"آتَى"},{"ar":"ٱلْعِلْمَ","tr":"l-ʿil'ma","en":"the knowledge","root":"علم","lem":"عِلْم"},{"ar":"دَرَجَـٰتٍۢ ۚ","tr":"darajātin","en":"(in) degrees","root":"درج","lem":"دَرَجَة"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"بِمَا","tr":"bimā","en":"of what"},{"ar":"تَعْمَلُونَ","tr":"taʿmalūna","en":"you do","root":"عمل","lem":"عَمِلَ"},{"ar":"خَبِيرٌۭ","tr":"khabīrun","en":"(is) All-Aware","root":"خبر","lem":"خَبِير"}]},{"n":12,"juz":28,"ar":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا نَـٰجَيْتُمُ ٱلرَّسُولَ فَقَدِّمُوا۟ بَيْنَ يَدَىْ نَجْوَىٰكُمْ صَدَقَةً ۚ ذَٰلِكَ خَيْرٌ لَّكُمْ وَأَطْهَرُ ۚ فَإِن لَّمْ تَجِدُوا۟ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ","en":"O you who have believed, when you [wish to] privately consult the Messenger, present before your consultation a charity. That is better for you and purer. But if you find not [the means] - then indeed, Allāh is Forgiving and Merciful.","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O you who believe","root":"أيي","lem":"أَيّ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"O you who believe"},{"ar":"ءَامَنُوٓا۟","tr":"āmanū","en":"O you who believe","root":"أمن","lem":"آمَنَ"},{"ar":"إِذَا","tr":"idhā","en":"When"},{"ar":"نَـٰجَيْتُمُ","tr":"nājaytumu","en":"you privately consult","root":"نجو"