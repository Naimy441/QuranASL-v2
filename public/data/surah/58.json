ent for them is Hell, which they will [enter to] burn, and wretched is the destination.","w":[{"ar":"أَلَمْ","tr":"alam","en":"Do not"},{"ar":"تَرَ","tr":"tara","en":"you see","root":"رأي","lem":"رَأَى"},{"ar":"إِلَى","tr":"ilā","en":"[to]"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"نُهُوا۟","tr":"nuhū","en":"were forbidden","root":"نهي","lem":"نَهَى"},{"ar":"عَنِ","tr":"ʿani","en":"from"},{"ar":"ٱلنَّجْوَىٰ","tr":"l-najwā","en":"secret counsels","root":"نجو","lem":"نَجْوَى"},{"ar":"ثُمَّ","tr":"thumma","en":"then"},{"ar":"يَعُودُونَ","tr":"yaʿūdūna","en":"they return","root":"عود","lem":"عادَ"},{"ar":"لِمَا","tr":"limā","en":"to what"},{"ar":"نُهُوا۟","tr":"nuhū","en":"they were forbidden","root":"نهي","lem":"نَهَى"},{"ar":"عَنْهُ","tr":"ʿanhu","en":"from [it]"},{"ar":"وَيَتَنَـٰجَوْنَ","tr":"wayatanājawna","en":"and they hold secret counsels","root":"نجو","lem":"تَناجَيْ"},{"ar":"بِٱلْإِثْمِ","tr":"bil-ith'mi","en":"for sin","root":"أثم","lem":"إِثْم"},{"ar":"وَٱلْعُدْوَٰنِ","tr":"wal-ʿud'wāni","en":"and aggression","root":"عدو","lem":"عُدْوان"},{"ar":"وَمَعْصِيَتِ","tr":"wamaʿṣiyati","en":"and disobedience","root":"عصي","lem":"مَعْصِيَت"},{"ar":"ٱلرَّسُولِ","tr":"l-rasūli","en":"(to) the Messenger","root":"رسل","lem":"رَسُول"},{"ar":"وَإِذَا","tr":"wa-idhā","en":"And when"},{"ar":"جَآءُوكَ","tr":"jāūka","en":"they come to you","root":"جيأ","lem":"جاءَ"},{"ar":"حَيَّوْكَ","tr":"ḥayyawka","en":"they greet you","root":"حيي","lem":"حَيَّ"},{"ar":"بِمَا","tr":"bimā","en":"with what"},{"ar":"لَمْ","tr":"lam","en":"not"},{"ar":"يُحَيِّكَ","tr":"yuḥayyika","en":"greets you","root":"حيي","lem":"حَيَّ"},{"ar":"بِهِ","tr":"bihi","en":"therewith"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"وَيَقُولُونَ","tr":"wayaqūlūna","en":"and they say","root":"قول","lem":"قالَ"},{"ar":"فِىٓ","tr":"fī","en":"among"},{"ar":"أَنفُسِهِمْ","tr":"anfusihim","en":"themselves","root":"نفس","lem":"نَفْس"},{"ar":"لَوْلَا","tr":"lawlā","en":"Why (does) not"},{"ar":"يُعَذِّبُنَا","tr":"yuʿadhibunā","en":"Allah punish us","root":"عذب","lem":"عَذَّبَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah punish us","root":"أله","lem":"اللَّه"},{"ar":"بِمَا","tr":"bimā","en":"for what"},{"ar":"نَقُولُ ۚ","tr":"naqūlu","en":"we say","root":"قول","lem":"قالَ"},{"ar":"حَسْبُهُمْ","tr":"ḥasbuhum","en":"Sufficient (for) them","root":"حسب","lem":"حَسْب"},{"ar":"جَهَنَّمُ","tr":"jahannamu","en":"(is) Hell"},{"ar":"يَصْلَوْنَهَا ۖ","tr":"yaṣlawnahā","en":"they will burn in it","root":"صلي","lem":"يَصْلَى"},{"ar":"فَبِئْسَ","tr":"fabi'sa","en":"and worst is","root":"بأس","lem":"بِئْسَ"},{"ar":"ٱلْمَصِيرُ","tr":"l-maṣīru","en":"the destination","root":"صير","lem":"مَصِير"}]},{"n":9,"juz":28,"ar":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا تَنَـٰجَيْتُمْ فَلَا تَتَنَـٰجَوْا۟ بِٱلْإِثْمِ وَٱلْعُدْوَٰنِ وَمَعْصِيَتِ ٱلرَّسُولِ وَتَنَـٰجَوْا۟ بِٱلْبِرِّ وَٱلتَّقْوَىٰ ۖ وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ إِلَيْهِ تُحْشَرُونَ","en":"O you who have believed, when you converse privately, do not converse about sin and aggression and disobedience to the Messenger but converse about righteousness and piety. And fear Allāh, to whom you will be gathered.","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O you who believe","root":"أيي","lem":"أَيّ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"O you who believe"},{"ar":"ءَامَنُوٓا۟","tr":"āmanū","en":"O you who believe","root":"أمن","lem":"آمَنَ"},{"ar":"إِذَا","tr":"idhā","en":"When"},{"ar":"تَنَـٰجَيْتُمْ","tr":"tanājaytum","en":"you hold secret counsel","root":"نجو","lem":"تَناجَيْ"},{"ar":"فَلَا","tr":"falā","en":"then (do) not"},{"ar":"تَتَنَـٰجَوْا۟","tr":"tatanājaw","en":"hold secret counsel","root":"نجو","lem":"تَناجَيْ"},{"ar":"بِٱلْإِثْمِ","tr":"bil-ith'mi","en":"for sin","root":"أثم","lem":"إِثْم"},{"ar":"وَٱلْعُدْوَٰنِ","tr":"wal-ʿud'wāni","en":"and aggression","root":"عدو","lem":"عُدْوان"},{"ar":"وَمَعْصِيَتِ","tr":"wamaʿṣiyati","en":"and disobedience","root":"عصي","lem":"مَعْصِيَت"},{"ar":