","root":"نفس","lem":"نَفْس"},{"ar":"وَمَن","tr":"waman","en":"And whoever"},{"ar":"كَفَرَ","tr":"kafara","en":"(is) ungrateful","root":"كفر","lem":"كَفَرَ"},{"ar":"فَإِنَّ","tr":"fa-inna","en":"then indeed"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"غَنِىٌّ","tr":"ghaniyyun","en":"(is) Free of need","root":"غني","lem":"غَنِيّ"},{"ar":"حَمِيدٌۭ","tr":"ḥamīdun","en":"Praiseworthy","root":"حمد","lem":"حَمِيد"}]},{"n":13,"juz":21,"ar":"وَإِذْ قَالَ لُقْمَـٰنُ لِٱبْنِهِۦ وَهُوَ يَعِظُهُۥ يَـٰبُنَىَّ لَا تُشْرِكْ بِٱللَّهِ ۖ إِنَّ ٱلشِّرْكَ لَظُلْمٌ عَظِيمٌ","en":"And [mention, O Muḥammad], when Luqmān said to his son while he was instructing him, \"O my son, do not associate [anything] with Allāh. Indeed, association [with Him] is great injustice.\"","w":[{"ar":"وَإِذْ","tr":"wa-idh","en":"And when"},{"ar":"قَالَ","tr":"qāla","en":"said","root":"قول","lem":"قالَ"},{"ar":"لُقْمَـٰنُ","tr":"luq'mānu","en":"Luqman"},{"ar":"لِٱبْنِهِۦ","tr":"li-ib'nihi","en":"to his son","root":"بني","lem":"ابْن"},{"ar":"وَهُوَ","tr":"wahuwa","en":"while he"},{"ar":"يَعِظُهُۥ","tr":"yaʿiẓuhu","en":"(was) instructing him","root":"وعظ","lem":"وَعَظْ"},{"ar":"يَـٰبُنَىَّ","tr":"yābunayya","en":"O my son","root":"بني","lem":"بُنَىّ"},{"ar":"لَا","tr":"lā","en":"(Do) not"},{"ar":"تُشْرِكْ","tr":"tush'rik","en":"associate partners","root":"شرك","lem":"أَشْرَكَ"},{"ar":"بِٱللَّهِ ۖ","tr":"bil-lahi","en":"with Allah","root":"أله","lem":"اللَّه"},{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱلشِّرْكَ","tr":"l-shir'ka","en":"associating partners","root":"شرك","lem":"شِرْك"},{"ar":"لَظُلْمٌ","tr":"laẓul'mun","en":"(is) surely an injustice","root":"ظلم","lem":"ظُلْم"},{"ar":"عَظِيمٌۭ","tr":"ʿaẓīmun","en":"great","root":"عظم","lem":"عَظِيم"}]},{"n":14,"juz":21,"ar":"وَوَصَّيْنَا ٱلْإِنسَـٰنَ بِوَٰلِدَيْهِ حَمَلَتْهُ أُمُّهُۥ وَهْنًا عَلَىٰ وَهْنٍ وَفِصَـٰلُهُۥ فِى عَامَيْنِ أَنِ ٱشْكُرْ لِى وَلِوَٰلِدَيْكَ إِلَىَّ ٱلْمَصِيرُ","en":"And We have enjoined upon man [care] for his parents. His mother carried him, [increasing her] in weakness upon weakness, and his weaning is in two years. Be grateful to Me and to your parents; to Me is the [final] destination.","w":[{"ar":"وَوَصَّيْنَا","tr":"wawaṣṣaynā","en":"And We have enjoined","root":"وصي","lem":"وَصَّى"},{"ar":"ٱلْإِنسَـٰنَ","tr":"l-insāna","en":"(upon) man","root":"أنس","lem":"إِنسان"},{"ar":"بِوَٰلِدَيْهِ","tr":"biwālidayhi","en":"for his parents ","root":"ولد","lem":"والِدَي"},{"ar":"حَمَلَتْهُ","tr":"ḥamalathu","en":"carried him","root":"حمل","lem":"حَمَلَ"},{"ar":"أُمُّهُۥ","tr":"ummuhu","en":"his mother","root":"أمم","lem":"أُمّ"},{"ar":"وَهْنًا","tr":"wahnan","en":"(in) weakness","root":"وهن","lem":"وَهْن"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"upon"},{"ar":"وَهْنٍۢ","tr":"wahnin","en":"weakness","root":"وهن","lem":"وَهْن"},{"ar":"وَفِصَـٰلُهُۥ","tr":"wafiṣāluhu","en":"and his weaning","root":"فصل","lem":"فِصال"},{"ar":"فِى","tr":"fī","en":"(is) in"},{"ar":"عَامَيْنِ","tr":"ʿāmayni","en":"two years","root":"عوم","lem":"عام"},{"ar":"أَنِ","tr":"ani","en":"that"},{"ar":"ٱشْكُرْ","tr":"ush'kur","en":"Be grateful","root":"شكر","lem":"شَكَرَ"},{"ar":"لِى","tr":"lī","en":"to Me"},{"ar":"وَلِوَٰلِدَيْكَ","tr":"waliwālidayka","en":"and to your parents","root":"ولد","lem":"والِدَي"},{"ar":"إِلَىَّ","tr":"ilayya","en":"towards Me"},{"ar":"ٱلْمَصِيرُ","tr":"l-maṣīru","en":"(is) the destination","root":"صير","lem":"مَصِير"}]},{"n":15,"juz":21,"ar":"وَإِن جَـٰهَدَاكَ عَلَىٰٓ أَن تُشْرِكَ بِى مَا لَيْسَ لَكَ بِهِۦ عِلْمٌ فَلَا تُطِعْهُمَا ۖ وَصَاحِبْهُمَا فِى ٱلدُّنْيَا مَعْرُوفًا ۖ وَٱتَّبِعْ سَبِيلَ مَنْ أَنَابَ إِلَىَّ ۚ ثُمَّ إِلَىَّ مَرْجِعُكُمْ فَأُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ","en":"But if they endeavor to make you associate with Me that of which you have no knowledge, do not obey them but accompany them in [this] world with appropriate kindness and follow the way of those who turn back to Me [in repentance]. Then to Me will be your return, and I will inform you about what you used to do.","w":[{"ar":"وَإِن","tr":"wa-in","en":"But if"},{"ar":"جَـٰهَدَاكَ","tr":"jāhadāka","en":"they strive against you","root":"جهد","lem":"جاهَدَ"},{"ar":"عَلَىٰٓ","tr":"ʿalā","en":"on"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"تُشْرِكَ","tr":"tush'rika","en":"you associate partners","root":"شرك","lem":"أَشْرَكَ"},{"ar":"بِى","tr":"bī","en":"with Me"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"لَيْسَ","tr":"laysa","en":"not","root":"ليس","lem":"لَيْسَ"},{"ar":"لَكَ","tr":"laka","en":"you have"},{"ar":"بِهِۦ","tr":"bihi","en":"of it"},{"ar":"عِلْمٌۭ","tr":"ʿil'mun","en":"any knowledge","root":"علم","lem":"عِلْم"},{"ar":"فَلَا","tr":"falā","en":"then (do) not"},{"ar":"تُطِعْهُمَا ۖ","tr":"tuṭiʿ'humā","en":"obey both of them","root":"طوع","lem":"أَطاعَ"},{"ar":"وَصَاحِبْهُمَا","tr":"waṣāḥib'humā","en":"But accompany them","root":"صحب","lem":"تُصاحِبْ"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"ٱلدُّنْيَا","tr":"l-dun'yā","en":"the world","root":"دنو","lem":"دُنْيا"},{"ar":"مَعْرُوفًۭا ۖ","tr":"maʿrūfan","en":"(with) kindness","root":"عرف","lem":"مَعْرُوف"},{"ar":"وَٱتَّبِعْ","tr":"wa-ittabiʿ","en":"and follow","root":"تبع","lem":"اتَّبَعَ"},{"ar":"سَبِيلَ","tr":"sabīla","en":"(the) path","root":"سبل","lem":"سَبِيل"},{"ar":"مَنْ","tr":"man","en":"(of him) who"},{"ar":"أَنَابَ","tr":"anāba","en":"turns","root":"نوب","lem":"أَنابَ"},{"ar":"إِلَىَّ ۚ","tr":"ilayya","en":"to Me"},{"ar":"ثُمَّ","tr":"thumma","en":"Then"},{"ar":"إِلَىَّ","tr":"ilayya","en":"towards Me"},{"ar":"مَرْجِعُكُمْ","tr":"marjiʿukum","en":"(is) your return","root":"رجع","lem":"مَرْجِع"},{"ar":"فَأُنَبِّئُكُم","tr":"fa-unabbi-ukum","en":"then I will inform you","root":"نبأ","lem":"نَبَّأَ"},{"ar":"بِمَا","tr":"bimā","en":"of what"},{"ar":"كُنتُمْ","tr":"kuntum","en":"you used (to)","root":"كون","lem":"كانَ"},{"ar":"تَعْمَلُونَ","tr":"taʿmalūna","en":"do","root":"عمل","lem":"عَمِلَ"}]},{"n":16,"juz":21,"ar":"يَـٰبُنَىَّ إِنَّهَآ إِن تَكُ مِثْقَالَ حَبَّةٍ مِّنْ خَرْدَلٍ فَتَكُن فِى صَخْرَة