":"وَلَئِن","tr":"wala-in","en":"And if"},{"ar":"سَأَلْتَهُم","tr":"sa-altahum","en":"you ask them","root":"سأل","lem":"سَأَلَ"},{"ar":"مَّنْ","tr":"man","en":"Who"},{"ar":"خَلَقَ","tr":"khalaqa","en":"created","root":"خلق","lem":"خَلَقَ"},{"ar":"ٱلسَّمَـٰوَٰتِ","tr":"l-samāwāti","en":"the heavens","root":"سمو","lem":"سَماء"},{"ar":"وَٱلْأَرْضَ","tr":"wal-arḍa","en":"and the earth","root":"أرض","lem":"أَرْض"},{"ar":"لَيَقُولُنَّ","tr":"layaqūlunna","en":"They will surely say","root":"قول","lem":"قالَ"},{"ar":"ٱللَّهُ ۚ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"قُلِ","tr":"quli","en":"Say","root":"قول","lem":"قالَ"},{"ar":"ٱلْحَمْدُ","tr":"l-ḥamdu","en":"All praises","root":"حمد","lem":"حَمْد"},{"ar":"لِلَّهِ ۚ","tr":"lillahi","en":"(are) for Allah","root":"أله","lem":"اللَّه"},{"ar":"بَلْ","tr":"bal","en":"But"},{"ar":"أَكْثَرُهُمْ","tr":"aktharuhum","en":"most of them","root":"كثر","lem":"أَكْثَر"},{"ar":"لَا","tr":"lā","en":"(do) not"},{"ar":"يَعْلَمُونَ","tr":"yaʿlamūna","en":"know","root":"علم","lem":"عَلِمَ"}]},{"n":26,"juz":21,"ar":"لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ إِنَّ ٱللَّهَ هُوَ ٱلْغَنِىُّ ٱلْحَمِيدُ","en":"To Allāh belongs whatever is in the heavens and earth. Indeed, Allāh is the Free of need, the Praiseworthy.","w":[{"ar":"لِلَّهِ","tr":"lillahi","en":"To Allah (belongs)","root":"أله","lem":"اللَّه"},{"ar":"مَا","tr":"mā","en":"whatever"},{"ar":"فِى","tr":"fī","en":"(is) in"},{"ar":"ٱلسَّمَـٰوَٰتِ","tr":"l-samāwāti","en":"the heavens","root":"سمو","lem":"سَماء"},{"ar":"وَٱلْأَرْضِ ۚ","tr":"wal-arḍi","en":"and the earth","root":"أرض","lem":"أَرْض"},{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"هُوَ","tr":"huwa","en":"He"},{"ar":"ٱلْغَنِىُّ","tr":"l-ghaniyu","en":"(is) Free of need","root":"غني","lem":"غَنِيّ"},{"ar":"ٱلْحَمِيدُ","tr":"l-ḥamīdu","en":"the Praiseworthy","root":"حمد","lem":"حَمِيد"}]},{"n":27,"juz":21,"ar":"وَلَوْ أَنَّمَا فِى ٱلْأَرْضِ مِن شَجَرَةٍ أَقْلَـٰمٌ وَٱلْبَحْرُ يَمُدُّهُۥ مِنۢ بَعْدِهِۦ سَبْعَةُ أَبْحُرٍ مَّا نَفِدَتْ كَلِمَـٰتُ ٱللَّهِ ۗ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌ","en":"And if whatever trees upon the earth were pens and the sea [was ink], replenished thereafter by seven [more] seas, the words of Allāh would not be exhausted. Indeed, Allāh is Exalted in Might and Wise.","w":[{"ar":"وَلَوْ","tr":"walaw","en":"And if"},{"ar":"أَنَّمَا","tr":"annamā","en":"whatever"},{"ar":"فِى","tr":"fī","en":"(is) in"},{"ar":"ٱلْأَرْضِ","tr":"l-arḍi","en":"the earth","root":"أرض","lem":"أَرْض"},{"ar":"مِن","tr":"min","en":"of"},{"ar":"شَجَرَةٍ","tr":"shajaratin","en":"(the) trees","root":"شجر","lem":"شَجَرَة"},{"ar":"أَقْلَـٰمٌۭ","tr":"aqlāmun","en":"(were) pens","root":"قلم","lem":"قَلَم"},{"ar":"وَٱلْبَحْرُ","tr":"wal-baḥru","en":"and the sea","root":"بحر","lem":"بَحْر"},{"ar":"يَمُدُّهُۥ","tr":"yamudduhu","en":"(to) add to it","root":"مدد","lem":"مَدَّ"},{"ar":"مِنۢ","tr":"min","en":"after it"},{"ar":"بَعْدِهِۦ","tr":"baʿdihi","en":"after it","root":"بعد","lem":"بَعْد"},{"ar":"سَبْعَةُ","tr":"sabʿatu","en":"seven","root":"سبع","lem":"سَبْعَة"},{"ar":"أَبْحُرٍۢ","tr":"abḥurin","en":"seas","root":"بحر","lem":"بَحْر"},{"ar":"مَّا","tr":"mā","en":"not"},{"ar":"نَفِدَتْ","tr":"nafidat","en":"would be exhausted","root":"نفد","lem":"نَفِدَ"},{"ar":"كَلِمَـٰتُ","tr":"kalimātu","en":"(the) Words","root":"كلم","lem":"كَلِمَة"},{"ar":"ٱللَّهِ ۗ","tr":"l-lahi","en":"(of) Allah","root":"أله","lem":"اللَّه"},{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"عَزِيزٌ","tr":"ʿazīzun","en":"(is) All-Mighty","root":"عزز","lem":"عَزِيز"},{"ar":"حَكِيمٌۭ","tr":"ḥakīmun","en":"All-Wise","root":"حكم","lem":"حَكِيم"}]},{"n":28,"juz":21,"ar":"مَّا خَلْقُكُمْ وَلَا بَعْثُكُمْ إِلَّا كَنَفْسٍ وَٰحِدَةٍ ۗ إِنَّ ٱللَّهَ سَمِيعٌۢ بَصِيرٌ","en":"Your creation and your resurrection will not be but as that of a single soul. Indeed, Allāh is Hearing and Seeing.","w":[{"ar":"مَّا","tr":"mā","en":"Not"},{"ar":"خَلْقُكُمْ","tr":"khalqukum","en":"(is) your creation","root":"خلق","lem":"خَلْق"},{"ar":"وَلَا","tr":"walā","en":"and not"},{"ar":"بَعْثُكُمْ","tr":"baʿthukum","en":"your resurrection","root":"بعث","lem":"بَعْث"},{"ar":"إِلَّا","tr":"illā","en":"but"},{"ar":"كَنَفْسٍۢ","tr":"kanafsin","en":"as a soul","root":"نفس","lem":"نَفْس"},{"ar":"وَٰحِدَةٍ ۗ","tr":"wāḥidatin","en":"single","root":"وحد","lem":"واحِدَة"},{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"سَمِيعٌۢ","tr":"samīʿun","en":"(is) All-Hearer","root":"سمع","lem":"سَمِيع"},{"ar":"بَصِيرٌ","tr":"baṣīrun","en":"All-Seer","root":"بصر","lem":"بَصِير"}]},{"n":29,"juz":21,"ar":"أَلَمْ تَرَ أَنَّ ٱللَّهَ يُولِجُ ٱلَّيْلَ فِى ٱلنَّهَارِ وَيُولِجُ ٱلنَّهَارَ فِى ٱلَّيْلِ وَسَخَّرَ ٱلشَّمْسَ وَٱلْقَمَرَ كُلٌّ يَجْرِىٓ إِلَىٰٓ أَجَلٍ مُّسَمًّى وَأَنَّ ٱللَّهَ بِمَا تَعْمَلُونَ خَبِيرٌ","en":"Do you not see [i.e., know] that Allāh causes the night to enter the day and causes the day to enter the night and has subjected the sun and the moon, each running [its course] for a specified term, and that Allāh, of whatever you do, is Aware?","w":[{"ar":"أَلَمْ","tr":"alam","en":"Do not"},{"ar":"تَرَ","tr":"tara","en":"you see","root":"رأي","lem":"رَأَى"},{"ar":"أَنَّ","tr":"anna","en":"that"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"يُولِجُ","tr":"yūliju","en":"causes to enter","root":"ولج","lem":"يُولِجُ"},{"ar":"ٱلَّيْلَ","tr":"al-layla","en":"the night","root":"ليل","lem":"لَيْل"},{"ar":"فِى","tr":"fī","en":"into"},{"ar":"ٱلنَّهَارِ","tr":"l-nahāri","en":"the day","root":"نهر","lem":"نَهار"},{"ar":"وَيُولِجُ","tr":"wayūliju","en":"and causes to enter","root":"ولج","lem":"يُولِجُ"},{"ar":"ٱلنَّهَارَ","tr":"l-nahāra","en":"the day","root":"نهر","lem":"نَهار"},{"ar":"فِى","tr":"fī","en":"into"},{"ar":"ٱلَّيْلِ","tr":"al-layli","en":"the night","root":"ليل","lem":"لَيْل"},{"ar":"وَسَخَّرَ","tr":"wasakhara","en":"and has subjected","root":"سخر","lem":"سَخَّرَ"},{"ar":"ٱلشَّمْسَ","tr":"l-shamsa","en":"the sun","root":"شمس","lem":"شَمْس"},{"ar":"وَٱلْقَمَرَ","tr":"wal-qamara","en":"and the moon","root":"قمر","lem":"قَمَر"},{"ar":"كُلٌّۭ","tr":"kullun","en":"each","root":"كلل","lem":"كُلّ"},{"ar":"يَجْرِىٓ","tr":"yajrī","en":"moving","root":"جري","lem":"جَرَيْ"},{"ar":"إِلَىٰٓ","tr":"ilā","en":"for"},{"ar":"أَجَلٍۢ","tr":"ajalin","en":"a term","root":"أجل","lem":"أَجَل"},{"ar":"مُّسَمًّۭى","tr":"musamman","en":"appointed","root":"سمو","lem":"مُسَمًّى"},{"ar":"وَأَنَّ","tr":"wa-anna","en":"and that"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"بِمَا","tr":"bimā","en":"of what"},{"ar":"تَعْمَلُونَ","tr":"taʿmalūna","en":"you do","root":"عمل","lem":"عَمِلَ"},{"ar":"خَبِيرٌۭ","tr":"khabīrun","en":"(is) All-Aware","root":"خبر","lem":"خَبِير"}]},{"n":30,"juz":21,"ar":"ذَٰلِكَ بِأَنَّ ٱللَّهَ هُوَ ٱلْحَقُّ وَأَنَّ مَا يَدْعُونَ مِن دُونِهِ ٱلْبَـٰطِلُ وَأَنَّ ٱللَّهَ هُوَ ٱلْعَلِىُّ ٱلْكَبِيرُ","en":"That is because Allāh is the True Reality, and that what they call upon other than Him is falsehood, and because Allāh is the Most High, the Grand.","w":[{"ar":"ذَٰلِكَ","tr":"dhālika","en":"That"},{"ar":"بِأَنَّ","tr":"bi-anna","en":"(is) because"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"هُوَ","tr":"huwa","en":"He"},{"ar":"ٱلْحَقُّ","tr":"l-ḥaqu","en":"(is) the Truth","root":"حقق","lem":"حَقّ"},{"ar":"وَأَنَّ","tr":"wa-anna","en":"and that"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"يَدْعُونَ","tr":"yadʿūna","en":"they call","root":"دعو","lem":"دَعا"},{"ar":"مِن","tr":"min","en":"besides Him"},{"ar":"دُونِهِ","tr":"dūnihi","en":"besides Him","root":"دون","lem":"دُون"},{"ar":"ٱلْبَـٰطِلُ","tr":"l-bāṭilu","en":"(is) [the] falsehood","root":"بطل","lem":"باطِل"},{"ar":"وَأَنَّ","tr":"wa-anna","en":"and that"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"هُوَ","tr":"huwa","en":"He"},{"ar":"ٱلْعَلِىُّ","tr":"l-ʿaliyu","en":"(is) the Most High","root":"علو","lem":"عَلِيّ"},{"ar":"ٱلْكَبِيرُ","tr":"l-kabīru","en":"the Most Great","root":"كبر","lem":"كَبِير"}]},{"n":31,"juz":21,"ar":"أَلَمْ تَرَ أَنَّ ٱلْفُلْكَ تَجْرِى فِى ٱلْبَحْرِ بِنِعْمَتِ ٱللَّهِ لِيُرِيَكُم مِّنْ ءَايَـٰتِهِۦٓ ۚ إِنَّ فِى ذَٰلِكَ لَـَٔايَـٰتٍ لِّكُلِّ صَبَّارٍ شَكُورٍ","en":"Do you not see that ships sail through the sea by the favor of Allāh that He may show you of His signs? Indeed in that are signs for everyone patient and grateful.","w":[{"ar":"أَلَمْ","tr":"alam","en":"Do not"},{"ar":"تَرَ","tr":"tara","en":"you see","root":"رأي","lem":"رَأَى"},{"ar":"أَنَّ","tr":"anna","en":"that"},{"ar":"ٱلْفُلْكَ","tr":"l-ful'ka","en":"the ships","root":"فلك","lem":"فُلْك"},{"ar":"تَجْرِى","tr":"tajrī","en":"sail","root":"جري","lem":"جَرَيْ"},{"ar":"فِى","tr":"fī","en":"through"},{"ar":"ٱلْبَحْرِ","tr":"l-baḥri","en":"the sea","root":"بحر","lem":"بَحْر"},{"ar":"بِنِعْمَتِ","tr":"biniʿ'mati","en":"by (the) Grace","root":"نعم","lem":"نِعْمَة"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"(of) Allah","root":"أله","lem":"اللَّه"},{"ar":"لِيُرِيَكُم","tr":"liyuriyakum","en":"that He may show you","root":"رأي","lem":"أَرَيْ"},{"ar":"مِّنْ","tr":"min","en":"of"},{"ar":"ءَايَـٰتِهِۦٓ ۚ","tr":"āyātihi","en":"His Signs","root":"أيي","lem":"آيَة"},{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"ذَٰلِكَ","tr":"dhālika","en":"that"},{"ar":"لَـَٔايَـٰتٍۢ","tr":"laāyātin","en":"surely (are) Signs","root":"أيي","lem":"آيَة"},{"ar":"لِّكُلِّ","tr":"likulli","en":"for everyone","root":"كلل","lem":"كُلّ"},{"ar":"صَبَّارٍۢ","tr":"ṣabbārin","en":"(who is) patient","root":"صبر","lem":"صَبّار"},{"ar":"شَكُورٍۢ","tr":"shakūrin","en":"grateful","root":"شكر","lem":"شَكُور"}]},{"n":32,"juz":21,"ar":"وَإِذَا غَشِيَهُم مَّوْجٌ كَٱلظُّلَلِ دَعَوُا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ فَلَمَّا نَجَّىٰهُمْ إِلَى ٱلْبَرِّ فَمِنْهُم مُّقْتَصِدٌ ۚ وَمَا يَج