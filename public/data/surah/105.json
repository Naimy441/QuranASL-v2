{"n":105,"name":"Al-Fil","nameAr":"الفيل","meaning":"The Elephant","ayahs":5,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ","en":"Have you not considered, [O Muḥammad], how your Lord dealt with the companions of the elephant?","w":[{"ar":"أَلَمْ","tr":"alam","en":"Have not"},{"ar":"تَرَ","tr":"tara","en":"you seen","root":"رأي","lem":"رَأَى"},{"ar":"كَيْفَ","tr":"kayfa","en":"how","root":"كيف","lem":"كَيْف"},{"ar":"فَعَلَ","tr":"faʿala","en":"dealt","root":"فعل","lem":"فَعَلَ"},{"ar":"رَبُّكَ","tr":"rabbuka","en":"your Lord","root":"ربب","lem":"رَبّ"},{"ar":"بِأَصْحَـٰبِ","tr":"bi-aṣḥābi","en":"with (the) Companions","root":"صحب","lem":"أَصْحاب"},{"ar":"ٱلْفِيلِ","tr":"l-fīli","en":"(of the) Elephant","root":"فيل","lem":"فِيل"}]},{"n":2,"juz":30,"ar":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ","en":"Did He not make their plan into misguidance?","w":[{"ar":"أَلَمْ","tr":"alam","en":"Did not"},{"ar":"يَجْعَلْ","tr":"yajʿal","en":"He make","root":"جعل","lem":"جَعَلَ"},{"ar":"كَيْدَهُمْ","tr":"kaydahum","en":"their plan","root":"كيد","lem":"كَيْد"},{"ar":"فِى","tr":"fī","en":"go"},{"ar":"تَضْلِيلٍۢ","tr":"taḍlīlin","en":"astray","root":"ضلل","lem":"تَضْلِيل"}]},{"n":3,"juz":30,"ar":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","en":"And He sent against them birds in flocks,","w":[{"ar":"وَأَرْسَلَ","tr":"wa-arsala","en":"And He sent","root":"رسل","lem":"أَرْسَلَ"},{"ar":"عَلَيْهِمْ","tr":"ʿalayhim","en":"against them"},{"ar":"طَيْرًا","tr":"ṭayran","en":"birds","root":"طير","lem":"طَيْر"},{"ar":"أَبَابِيلَ","tr":"abābīla","en":"(in) flocks","root":"أبل","lem":"أَبابِيل"}]},{"n":4,"juz":30,"ar":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","en":"Striking them with stones of hard clay,","w":[{"ar":"تَرْمِيهِم","tr":"tarmīhim","en":"Striking them","root":"رمي","lem":"رَمَى"},{"ar":"بِحِجَارَةٍۢ","tr":"biḥijāratin","en":"with stones","root":"حجر","lem":"حِجارَة"},{"ar":"مِّن","tr":"min","en":"of"},{"ar":"سِجِّيل