ld they defend themselves.","w":[{"ar":"فَمَا","tr":"famā","en":"Then not"},{"ar":"ٱسْتَطَـٰعُوا۟","tr":"is'taṭāʿū","en":"they were able to","root":"طوع","lem":"اسْتَطاعَ"},{"ar":"مِن","tr":"min","en":"[of]"},{"ar":"قِيَامٍۢ","tr":"qiyāmin","en":"stand","root":"قوم","lem":"قائِم"},{"ar":"وَمَا","tr":"wamā","en":"and not"},{"ar":"كَانُوا۟","tr":"kānū","en":"they could","root":"كون","lem":"كانَ"},{"ar":"مُنتَصِرِينَ","tr":"muntaṣirīna","en":"help themselves","root":"نصر","lem":"مُنتَصِر"}]},{"n":46,"juz":27,"ar":"وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ قَوْمًا فَـٰسِقِينَ","en":"And [We destroyed] the people of Noah before; indeed, they were a people defiantly disobedient.","w":[{"ar":"وَقَوْمَ","tr":"waqawma","en":"And (the) people","root":"قوم","lem":"قَوْم"},{"ar":"نُوحٍۢ","tr":"nūḥin","en":"(of) Nuh"},{"ar":"مِّن","tr":"min","en":"before"},{"ar":"قَبْلُ ۖ","tr":"qablu","en":"before","root":"قبل","lem":"قَبْل"},{"ar":"إِنَّهُمْ","tr":"innahum","en":"indeed, they"},{"ar":"كَانُوا۟","tr":"kānū","en":"were","root":"كون","lem":"كانَ"},{"ar":"قَوْمًۭا","tr":"qawman","en":"a people","root":"قوم","lem":"قَوْم"},{"ar":"فَـٰسِقِينَ","tr":"fāsiqīna","en":"defiantly disobedient","root":"فسق","lem":"فاسِق"}]},{"n":47,"juz":27,"ar":"وَٱلسَّمَآءَ بَنَيْنَـٰهَا بِأَيْي۟دٍ وَإِنَّا لَمُوسِعُونَ","en":"And the heaven We constructed with strength, and indeed, We are [its] expander.","w":[{"ar":"وَٱلسَّمَآءَ","tr":"wal-samāa","en":"And the heaven","root":"سمو","lem":"سَماء"},{"ar":"بَنَيْنَـٰهَا","tr":"banaynāhā","en":"We constructed it","root":"بني","lem":"بَنَى"},{"ar":"بِأَيْي۟دٍۢ","tr":"bi-aydin","en":"with strength","root":"أيد","lem":"أَيْيد"},{"ar":"وَإِنَّا","tr":"wa-innā","en":"and indeed, We"},{"ar":"لَمُوسِعُونَ","tr":"lamūsiʿūna","en":"(are) surely (its) Expanders","root":"وسع","lem":"مُوسِع"}]},{"n":48,"juz":27,"ar":"وَٱلْأَرْضَ فَرَشْنَـٰهَا فَنِعْمَ ٱلْمَـٰهِدُونَ","en":"And the earth We have spread out, and excellent is the preparer.","w":[{"ar":"وَٱلْأَرْضَ","tr":"wal-arḍa","en":"And the earth","root":"أرض","lem":"أَرْض"},{"ar":"فَرَشْنَـٰهَا","tr":"farashnāhā","en":"We have spread it","root":"فرش","lem":"فَرَشْ"},{"ar":"فَنِعْمَ","tr":"faniʿ'ma","en":"how excellent","root":"نعم","lem":"نِعْمَ"},{"ar":"ٱلْمَـٰهِدُونَ","tr":"l-māhidūna","en":"(are) the Spreaders","root":"مهد","lem":"ماهِد"}]},{"n":49,"juz":27,"ar":"وَمِن كُلِّ شَىْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ","en":"And of all things We created two mates [i.e., counterparts]; perhaps you will remember.","w":[{"ar":"وَمِن","tr":"wamin","en":"And of"},{"ar":"كُلِّ","tr":"kulli","en":"every","root":"كلل","lem":"كُلّ"},{"ar":"شَىْءٍ","tr":"shayin","en":"thing","root":"شيأ","lem":"شَىْء"},{"ar":"خَلَقْنَا","tr":"khalaqnā","en":"We have created","root":"خلق","lem":"خَلَقَ"},{"ar":"زَوْجَيْنِ","tr":"zawjayni","en":"pairs","root":"زوج","lem":"زَوْج"},{"ar":"لَعَلَّكُمْ","tr":"laʿallakum","en":"so that you may"},{"ar":"تَذَكَّرُونَ","tr":"tadhakkarūna","en":"remember","root":"ذكر","lem":"تَذَكَّرَ"}]},{"n":50,"juz":27,"ar":"فَفِرُّوٓا۟ إِلَى ٱللَّهِ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌ مُّبِينٌ","en":"So flee to Allāh. Indeed, I am to you from Him a clear warner.","w":[{"ar":"فَفِرُّوٓا۟","tr":"fafirrū","en":"So flee","root":"فرر","lem":"فَرَّتْ"},{"ar":"إِلَى","tr":"ilā","en":"to"},{"ar":"ٱللَّهِ ۖ","tr":"l-lahi","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"إِنِّى","tr":"innī","en":"indeed, I am"},{"ar":"لَكُم","tr":"lakum","en":"to you"},{"ar":"مِّنْهُ","tr":"min'hu","en":"from Him"},{"ar":"نَذِيرٌۭ","tr":"nadhīrun","en":"a warner","root":"نذر","lem":"نَذِير"},{"ar":"مُّبِينٌۭ","tr":"mubīnun","en":"clear","root":"بين","lem":"مُبِين"}]},{"n":51,"juz":27,"ar":"وَلَا تَجْعَلُوا۟ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌ مُّبِينٌ","en":"And do not make [as equal] with Allāh another deity. Indeed, I am to you from Him a clear warner.","w":[{"ar":"وَلَا","tr":"walā","en":"And (do) not"},{"ar":"تَجْعَلُوا۟","tr":"tajʿalū","en":"make","root":"جعل