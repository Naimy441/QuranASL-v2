ِينِ","tr":"l-dīni","en":"(of) Judgment","root":"دين","lem":"دِين"}]},{"n":13,"juz":26,"ar":"يَوْمَ هُمْ عَلَى ٱلنَّارِ يُفْتَنُونَ","en":"[It is] the Day they will be tormented over the Fire.","w":[{"ar":"يَوْمَ","tr":"yawma","en":"A Day","root":"يوم","lem":"يَوْم"},{"ar":"هُمْ","tr":"hum","en":"they"},{"ar":"عَلَى","tr":"ʿalā","en":"over"},{"ar":"ٱلنَّارِ","tr":"l-nāri","en":"the Fire","root":"نور","lem":"نار"},{"ar":"يُفْتَنُونَ","tr":"yuf'tanūna","en":"will be tried","root":"فتن","lem":"فَتَنُ"}]},{"n":14,"juz":26,"ar":"ذُوقُوا۟ فِتْنَتَكُمْ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تَسْتَعْجِلُونَ","en":"[And will be told], \"Taste your torment. This is that for which you were impatient.\"","w":[{"ar":"ذُوقُوا۟","tr":"dhūqū","en":"Taste","root":"ذوق","lem":"ذاقُ"},{"ar":"فِتْنَتَكُمْ","tr":"fit'natakum","en":"your trial","root":"فتن","lem":"فِتْنَة"},{"ar":"هَـٰذَا","tr":"hādhā","en":"This"},{"ar":"ٱلَّذِى","tr":"alladhī","en":"(is) what"},{"ar":"كُنتُم","tr":"kuntum","en":"you were","root":"كون","lem":"كانَ"},{"ar":"بِهِۦ","tr":"bihi","en":"for it"},{"ar":"تَسْتَعْجِلُونَ","tr":"tastaʿjilūna","en":"seeking to hasten","root":"عجل","lem":"اسْتَعْجَلَ"}]},{"n":15,"juz":26,"ar":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَعُيُونٍ","en":"Indeed, the righteous will be among gardens and springs,","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱلْمُتَّقِينَ","tr":"l-mutaqīna","en":"the righteous","root":"وقي","lem":"مُتَّقي"},{"ar":"فِى","tr":"fī","en":"(will be) in"},{"ar":"جَنَّـٰتٍۢ","tr":"jannātin","en":"Gardens","root":"جنن","lem":"جَنَّة"},{"ar":"وَعُيُونٍ","tr":"waʿuyūnin","en":"and springs","root":"عين","lem":"عَيْن"}]},{"n":16,"juz":26,"ar":"ءَاخِذِينَ مَآ ءَاتَىٰهُمْ رَبُّهُمْ ۚ إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُحْسِنِينَ","en":"Accepting what their Lord has given them. Indeed, they were before that doers of good.","w":[{"ar":"ءَاخِذِينَ","tr":"ākhidhīna","en":"Taking","root":"أخذ","lem":"آخِذ"},{"ar":"مَآ","tr":"mā","en":"what"},{"ar":"ءَاتَىٰهُمْ","tr":"ātāhum","en":