{"n":51,"name":"Adh-Dhariyat","nameAr":"الذاريات","meaning":"The Winnowing Winds","ayahs":60,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":26,"ar":"وَٱلذَّٰرِيَـٰتِ ذَرْوًا","en":"By the [winds] scattering [dust], dispersing [it]","w":[{"ar":"وَٱلذَّٰرِيَـٰتِ","tr":"wal-dhāriyāti","en":"By those scattering","root":"ذرو","lem":"ذارِيَة"},{"ar":"ذَرْوًۭا","tr":"dharwan","en":"dispersing","root":"ذرو","lem":"ذَرْو"}]},{"n":2,"juz":26,"ar":"فَٱلْحَـٰمِلَـٰتِ وِقْرًا","en":"And the [clouds] carrying a load [of water]","w":[{"ar":"فَٱلْحَـٰمِلَـٰتِ","tr":"fal-ḥāmilāti","en":"And those carrying","root":"حمل","lem":"حامِلَة"},{"ar":"وِقْرًۭا","tr":"wiq'ran","en":"a load","root":"وقر","lem":"وِقْر"}]},{"n":3,"juz":26,"ar":"فَٱلْجَـٰرِيَـٰتِ يُسْرًا","en":"And the ships sailing with ease","w":[{"ar":"فَٱلْجَـٰرِيَـٰتِ","tr":"fal-jāriyāti","en":"And those sailing","root":"جري","lem":"جارِيَة"},{"ar":"يُسْرًۭا","tr":"yus'ran","en":"(with) ease","root":"يسر","lem":"يُسْر"}]},{"n":4,"juz":26,"ar":"فَٱلْمُقَسِّمَـٰتِ أَمْرًا","en":"And the [angels] apportioning [each] matter,","w":[{"ar":"فَٱلْمُقَسِّمَـٰتِ","tr":"fal-muqasimāti","en":"And those distributing","root":"قسم","lem":"مُقَسِّمَة"},{"ar":"أَمْرًا","tr":"amran","en":"Command","root":"أمر","lem":"أَمْر"}]},{"n":5,"juz":26,"ar":"إِنَّمَا تُوعَدُونَ لَصَادِقٌ","en":"Indeed, what you are promised is true.","w":[{"ar":"إِنَّمَا","tr":"innamā","en":"Indeed, what"},{"ar":"تُوعَدُونَ","tr":"tūʿadūna","en":"you are promised","root":"وعد","lem":"وَعَدَ"},{"ar":"لَصَادِقٌۭ","tr":"laṣādiqun","en":"(is) surely true","root":"صدق","lem":"صادِق"}]},{"n":6,"juz":26,"ar":"وَإِنَّ ٱلدِّينَ لَوَٰقِعٌ","en":"And indeed, the recompense is to occur.","w":[{"ar":"وَإِنَّ","tr":"wa-inna","en":"And indeed"},{"ar":"ٱلدِّينَ","tr":"l-dīna","en":"the Judgment","root":"دين","lem":"دِين"},{"ar":"لَوَٰقِعٌۭ","tr":"lawāqiʿun","en":"(is) surely to occur","root":"وقع","lem":"واقِع"}]},{"n":7,"juz":26,"ar":"وَٱلسَّمَآءِ ذَاتِ ٱلْحُبُكِ","en":"By t