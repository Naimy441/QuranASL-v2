awmun","en":"(are) a people","root":"قوم","lem":"قَوْم"},{"ar":"طَاغُونَ","tr":"ṭāghūna","en":"transgressing","root":"طغي","lem":"طاغي"}]},{"n":54,"juz":27,"ar":"فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍ","en":"So leave them, [O Muḥammad], for you are not to be blamed.","w":[{"ar":"فَتَوَلَّ","tr":"fatawalla","en":"So turn away","root":"ولي","lem":"تَوَلَّى"},{"ar":"عَنْهُمْ","tr":"ʿanhum","en":"from them"},{"ar":"فَمَآ","tr":"famā","en":"for not"},{"ar":"أَنتَ","tr":"anta","en":"you"},{"ar":"بِمَلُومٍۢ","tr":"bimalūmin","en":"(are) to be blamed","root":"لوم","lem":"مَلُوم"}]},{"n":55,"juz":27,"ar":"وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ","en":"And remind, for indeed, the reminder benefits the believers.","w":[{"ar":"وَذَكِّرْ","tr":"wadhakkir","en":"And remind","root":"ذكر","lem":"ذُكِّرَ"},{"ar":"فَإِنَّ","tr":"fa-inna","en":"for indeed"},{"ar":"ٱلذِّكْرَىٰ","tr":"l-dhik'rā","en":"the reminder","root":"ذكر","lem":"ذِكْرَى"},{"ar":"تَنفَعُ","tr":"tanfaʿu","en":"benefits","root":"نفع","lem":"نَفَعَ"},{"ar":"ٱلْمُؤْمِنِينَ","tr":"l-mu'minīna","en":"the believers","root":"أمن","lem":"مُؤْمِن"}]},{"n":56,"juz":27,"ar":"وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ","en":"And I did not create the jinn and mankind except to worship Me.","w":[{"ar":"وَمَا","tr":"wamā","en":"And not"},{"ar":"خَلَقْتُ","tr":"khalaqtu","en":"I have created","root":"خلق","lem":"خَلَقَ"},{"ar":"ٱلْجِنَّ","tr":"l-jina","en":"the jinn","root":"جنن","lem":"جِنّ"},{"ar":"وَٱلْإِنسَ","tr":"wal-insa","en":"and the mankind","root":"أنس","lem":"إِنس"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"لِيَعْبُدُونِ","tr":"liyaʿbudūni","en":"that they worship Me","root":"عبد","lem":"عَبَدَ"}]},{"n":57,"juz":27,"ar":"مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍ وَمَآ أُرِيدُ أَن يُطْعِمُونِ","en":"I do not want from them any provision, nor do I want them to feed Me.","w":[{"ar":"مَآ","tr":"mā","en":"Not"},{"ar":"أُرِيدُ","tr":"urīdu","en":"I want","root":"رود","lem":"أَرادَ"},{"ar":"مِنْهُم","tr":"min'hum","en":"from them"},{"ar":"مِّن","tr":"min","en":"any"},{"ar":"رِّزْقٍۢ","tr":"riz'qin","en":"provision","root":"رزق","lem":"رِزْق"},{"ar":"وَمَآ","tr":"wamā","en":"and not"},{"ar":"أُرِيدُ","tr":"urīdu","en":"I want","root":"رود","lem":"أَرادَ"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"يُطْعِمُونِ","tr":"yuṭ'ʿimūni","en":"they (should) feed Me","root":"طعم","lem":"أَطْعَمَ"}]},{"n":58,"juz":27,"ar":"إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ","en":"Indeed, it is Allāh who is the [continual] Provider, the firm possessor of strength.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"هُوَ","tr":"huwa","en":"He"},{"ar":"ٱلرَّزَّاقُ","tr":"l-razāqu","en":"(is) the All-Provider","root":"رزق","lem":"رَزّاق"},{"ar":"ذُو","tr":"dhū","en":"Possessor"},{"ar":"ٱلْقُوَّةِ","tr":"l-quwati","en":"(of) Power","root":"قوي","lem":"قُوَّة"},{"ar":"ٱلْمَتِينُ","tr":"l-matīnu","en":"the Strong","root":"متن","lem":"مَتِين"}]},{"n":59,"juz":27,"ar":"فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًا مِّثْلَ ذَنُوبِ أَصْحَـٰبِهِمْ فَلَا يَسْتَعْجِلُونِ","en":"And indeed, for those who have wronged is a portion [of punishment] like the portion of their companions [i.e., predecessors], so let them not impatiently urge Me.","w":[{"ar":"فَإِنَّ","tr":"fa-inna","en":"So indeed"},{"ar":"لِلَّذِينَ","tr":"lilladhīna","en":"for those who"},{"ar":"ظَلَمُوا۟","tr":"ẓalamū","en":"do wrong","root":"ظلم","lem":"ظَلَمَ"},{"ar":"ذَنُوبًۭا","tr":"dhanūban","en":"(is) a portion","root":"ذنب","lem":"ذَنُوب"},{"ar":"مِّثْلَ","tr":"mith'la","en":"like","root":"مثل","lem":"مِثْل"},{"ar":"ذَنُوبِ","tr":"dhanūbi","en":"(the) portion","root":"ذنب","lem":"ذَنُوب"},{"ar":"أَصْحَـٰبِهِمْ","tr":"aṣḥābihim","en":"(of) their companions","root":"صحب","lem":"أَصْحاب"},{"ar":"فَلَا","tr":"falā","en":"so let them not ask Me to hasten"},{"ar":"يَسْتَعْجِلُونِ","tr":"yastaʿjilūni","en":"so let them not ask Me to hasten","root":"عج