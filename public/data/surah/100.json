{"n":100,"name":"Al-'Adiyat","nameAr":"العاديات","meaning":"The Courser","ayahs":11,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"وَٱلْعَـٰدِيَـٰتِ ضَبْحًا","en":"By the racers, panting,","w":[{"ar":"وَٱلْعَـٰدِيَـٰتِ","tr":"wal-ʿādiyāti","en":"By the racers","root":"عدو","lem":"عادِيَة"},{"ar":"ضَبْحًۭا","tr":"ḍabḥan","en":"panting","root":"ضبح","lem":"ضَبْح"}]},{"n":2,"juz":30,"ar":"فَٱلْمُورِيَـٰتِ قَدْحًا","en":"And the producers of sparks [when] striking","w":[{"ar":"فَٱلْمُورِيَـٰتِ","tr":"fal-mūriyāti","en":"And the producers of sparks","root":"وري","lem":"مُورِيَة"},{"ar":"قَدْحًۭا","tr":"qadḥan","en":"striking","root":"قدح","lem":"قَدْح"}]},{"n":3,"juz":30,"ar":"فَٱلْمُغِيرَٰتِ صُبْحًا","en":"And the chargers at dawn,","w":[{"ar":"فَٱلْمُغِيرَٰتِ","tr":"fal-mughīrāti","en":"And the chargers","root":"غير","lem":"مُغِيرَة"},{"ar":"صُبْحًۭا","tr":"ṣub'ḥan","en":"(at) dawn","root":"صبح","lem":"صُبْح"}]},{"n":4,"juz":30,"ar":"فَأَثَرْنَ بِهِۦ نَقْعًا","en":"Stirring up thereby [clouds of] dust,","w":[{"ar":"فَأَثَرْنَ","tr":"fa-atharna","en":"Then raise","root":"ثور","lem":"أَثارُ"},{"ar":"بِهِۦ","tr":"bihi","en":"thereby"},{"ar":"نَقْعًۭا","tr":"naqʿan","en":"dust","root":"نقع","lem":"نَقْع"}]},{"n":5,"juz":30,"ar":"فَوَسَطْنَ بِهِۦ جَمْعًا","en":"Arriving thereby in the center collectively,","w":[{"ar":"فَوَسَطْنَ","tr":"fawasaṭna","en":"Then penetrate (in the) center","root":"وسط","lem":"وَسَطْ"},{"ar":"بِهِۦ","tr":"bihi","en":"thereby"},{"ar":"جَمْعًا","tr":"jamʿan","en":"collectively","root":"جمع","lem":"جَمْع"}]},{"n":6,"juz":30,"ar":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ","en":"Indeed mankind, to his Lord, is ungrateful.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱلْإِنسَـٰنَ","tr":"l-insāna","en":"mankind","root":"أنس","lem":"إِنسان"},{"ar":"لِرَبِّهِۦ","tr":"lirabbihi","en":"to his Lord","root":"ربب","lem":"رَبّ"},{"ar":"لَكَنُودٌۭ","tr":"lakanūdun","en":"(is) surely ungrateful","root":"كند","lem":"كَنُود"}]},{"n":7,"juz":