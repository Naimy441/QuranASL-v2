:"yaraw","en":"they see","root":"رأي","lem":"رَأَى"},{"ar":"إِلَى","tr":"ilā","en":"[to]"},{"ar":"ٱلطَّيْرِ","tr":"l-ṭayri","en":"the birds","root":"طير","lem":"طَيْر"},{"ar":"فَوْقَهُمْ","tr":"fawqahum","en":"above them","root":"فوق","lem":"فَوْق"},{"ar":"صَـٰٓفَّـٰتٍۢ","tr":"ṣāffātin","en":"spreading (their wings)","root":"صفف","lem":"صافَّة"},{"ar":"وَيَقْبِضْنَ ۚ","tr":"wayaqbiḍ'na","en":"and folding","root":"قبض","lem":"قَبَضْ"},{"ar":"مَا","tr":"mā","en":"Not"},{"ar":"يُمْسِكُهُنَّ","tr":"yum'sikuhunna","en":"holds them","root":"مسك","lem":"أَمْسَكَ"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"ٱلرَّحْمَـٰنُ ۚ","tr":"l-raḥmānu","en":"the Most Gracious","root":"رحم","lem":"رَحْمٰن"},{"ar":"إِنَّهُۥ","tr":"innahu","en":"Indeed, He"},{"ar":"بِكُلِّ","tr":"bikulli","en":"(is) of every","root":"كلل","lem":"كُلّ"},{"ar":"شَىْءٍۭ","tr":"shayin","en":"thing","root":"شيأ","lem":"شَىْء"},{"ar":"بَصِيرٌ","tr":"baṣīrun","en":"All-Seer","root":"بصر","lem":"بَصِير"}]},{"n":20,"juz":29,"ar":"أَمَّنْ هَـٰذَا ٱلَّذِى هُوَ جُندٌ لَّكُمْ يَنصُرُكُم مِّن دُونِ ٱلرَّحْمَـٰنِ ۚ إِنِ ٱلْكَـٰفِرُونَ إِلَّا فِى غُرُورٍ","en":"Or who is it that could be an army for you to aid you other than the Most Merciful? The disbelievers are not but in delusion.","w":[{"ar":"أَمَّنْ","tr":"amman","en":"Who is"},{"ar":"هَـٰذَا","tr":"hādhā","en":"this"},{"ar":"ٱلَّذِى","tr":"alladhī","en":"the one"},{"ar":"هُوَ","tr":"huwa","en":"he"},{"ar":"جُندٌۭ","tr":"jundun","en":"(is) an army","root":"جند","lem":"جُند"},{"ar":"لَّكُمْ","tr":"lakum","en":"for you"},{"ar":"يَنصُرُكُم","tr":"yanṣurukum","en":"to help you","root":"نصر","lem":"نَصَرَ"},{"ar":"مِّن","tr":"min","en":"from"},{"ar":"دُونِ","tr":"dūni","en":"besides","root":"دون","lem":"دُون"},{"ar":"ٱلرَّحْمَـٰنِ ۚ","tr":"l-raḥmāni","en":"the Most Gracious","root":"رحم","lem":"رَحْمٰن"},{"ar":"إِنِ","tr":"ini","en":"Not"},{"ar":"ٱلْكَـٰفِرُونَ","tr":"l-kāfirūna","en":"(are) the disbelievers","root":"كفر","lem":"كافِر"},{"ar":"إِلَّا","tr":"illā","en":"but"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"غُرُورٍ","tr":"ghurūrin","en":"delusion","root":"غرر","lem":"غُرُور"}]},{"n":21,"juz":29,"ar":"أَمَّنْ هَـٰذَا ٱلَّذِى يَرْزُقُكُمْ إِنْ أَمْسَكَ رِزْقَهُۥ ۚ بَل لَّجُّوا۟ فِى عُتُوٍّ وَنُفُورٍ","en":"Or who is it that could provide for you if He withheld His provision? But they have persisted in insolence and aversion.","w":[{"ar":"أَمَّنْ","tr":"amman","en":"Who is"},{"ar":"هَـٰذَا","tr":"hādhā","en":"this"},{"ar":"ٱلَّذِى","tr":"alladhī","en":"the one"},{"ar":"يَرْزُقُكُمْ","tr":"yarzuqukum","en":"to provide you","root":"رزق","lem":"رَزَقَ"},{"ar":"إِنْ","tr":"in","en":"if"},{"ar":"أَمْسَكَ","tr":"amsaka","en":"He withheld","root":"مسك","lem":"أَمْسَكَ"},{"ar":"رِزْقَهُۥ ۚ","tr":"riz'qahu","en":"His provision","root":"رزق","lem":"رِزْق"},{"ar":"بَل","tr":"bal","en":"Nay"},{"ar":"لَّجُّوا۟","tr":"lajjū","en":"they persist","root":"لجج","lem":"لَجُّ"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"عُتُوٍّۢ","tr":"ʿutuwwin","en":"pride","root":"عتو","lem":"عُتُوّ"},{"ar":"وَنُفُورٍ","tr":"wanufūrin","en":"and aversion","root":"نفر","lem":"نُفُور"}]},{"n":22,"juz":29,"ar":"أَفَمَن يَمْشِى مُكِبًّا عَلَىٰ وَجْهِهِۦٓ أَهْدَىٰٓ أَمَّن يَمْشِى سَوِيًّا عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ","en":"Then is one who walks fallen on his face better guided or one who walks erect on a straight path?","w":[{"ar":"أَفَمَن","tr":"afaman","en":"Then is he who"},{"ar":"يَمْشِى","tr":"yamshī","en":"walks","root":"مشي","lem":"مَشَ"},{"ar":"مُكِبًّا","tr":"mukibban","en":"fallen","root":"كبب","lem":"مُكِبّ"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"on"},{"ar":"وَجْهِهِۦٓ","tr":"wajhihi","en":"his face","root":"وجه","lem":"وَجْه"},{"ar":"أَهْدَىٰٓ","tr":"ahdā","en":"better guided","root":"هدي","lem":"أَهْدَى"},{"ar":"أَمَّن","tr":"amman","en":"or (he) who"},{"ar":"يَمْشِى","tr":"yamshī","en":"walks","root":"مشي","lem":"مَشَ"},{"ar":"سَوِيًّا","tr":"sawiyyan","en":"upright","root":"سوي","lem":"سَوِيّ"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"on"},{"ar":"صِرَٰطٍۢ","tr"