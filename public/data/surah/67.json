{"n":67,"name":"Al-Mulk","nameAr":"الملك","meaning":"The Sovereignty","ayahs":30,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":29,"ar":"تَبَـٰرَكَ ٱلَّذِى بِيَدِهِ ٱلْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","en":"Blessed is He in whose hand is dominion, and He is over all things competent -","w":[{"ar":"تَبَـٰرَكَ","tr":"tabāraka","en":"Blessed is","root":"برك","lem":"تَبارَكَ"},{"ar":"ٱلَّذِى","tr":"alladhī","en":"He"},{"ar":"بِيَدِهِ","tr":"biyadihi","en":"in Whose Hand","root":"يدي","lem":"يَد"},{"ar":"ٱلْمُلْكُ","tr":"l-mul'ku","en":"(is) the Dominion","root":"ملك","lem":"مُلْك"},{"ar":"وَهُوَ","tr":"wahuwa","en":"and He"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"(is) over"},{"ar":"كُلِّ","tr":"kulli","en":"every","root":"كلل","lem":"كُلّ"},{"ar":"شَىْءٍۢ","tr":"shayin","en":"thing","root":"شيأ","lem":"شَىْء"},{"ar":"قَدِيرٌ","tr":"qadīrun","en":"All-Powerful","root":"قدر","lem":"قَدِير"}]},{"n":2,"juz":29,"ar":"ٱلَّذِى خَلَقَ ٱلْمَوْتَ وَٱلْحَيَوٰةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا ۚ وَهُوَ ٱلْعَزِيزُ ٱلْغَفُورُ","en":"[He] who created death and life to test you [as to] which of you is best in deed - and He is the Exalted in Might, the Forgiving -","w":[{"ar":"ٱلَّذِى","tr":"alladhī","en":"The One Who"},{"ar":"خَلَقَ","tr":"khalaqa","en":"created","root":"خلق","lem":"خَلَقَ"},{"ar":"ٱلْمَوْتَ","tr":"l-mawta","en":"death","root":"موت","lem":"مَوْت"},{"ar":"وَٱلْحَيَوٰةَ","tr":"wal-ḥayata","en":"and life","root":"حيي","lem":"حَياة"},{"ar":"لِيَبْلُوَكُمْ","tr":"liyabluwakum","en":"that He may test you","root":"بلو","lem":"بَلَوْ"},{"ar":"أَيُّكُمْ","tr":"ayyukum","en":"which of you","root":"أيي","lem":"أَيّ"},{"ar":"أَحْسَنُ","tr":"aḥsanu","en":"(is) best","root":"حسن","lem":"أَحْسَن"},{"ar":"عَمَلًۭا ۚ","tr":"ʿamalan","en":"(in) deed","root":"عمل","lem":"عَمَل"},{"ar":"وَهُوَ","tr":"wahuwa","en":"And He"},{"ar":"ٱلْعَزِيزُ","tr":"l-ʿazīzu","en":"(is) the All-Mighty","root":"عزز","lem":"عَزِيز"},{"ar":"ٱلْغَفُورُ","tr":"l-ghafūru","en":"the Oft-Forgiving","root":"غفر","lem":"غَفُور"}]},{"n":3,"juz":29,"ar":"ٱلَّذِى خَلَقَ سَبْعَ سَمَـٰوَٰتٍ طِبَاقًا ۖ مَّا تَرَىٰ فِى خَلْقِ ٱلرَّحْمَـٰنِ مِن تَفَـٰوُتٍ ۖ فَٱرْجِعِ ٱلْبَصَرَ هَلْ تَرَىٰ مِن فُطُورٍ","en":"[And] who created seven heavens in layers. You do not see in the creation of the Most Merciful any inconsistency. So return [your] vision [to the sky]; do you see any breaks?","w":[{"ar":"ٱلَّذِى","tr":"alladhī","en":"The One Who"},{"ar":"خَلَقَ","tr":"khalaqa","en":"created","root":"خلق","lem":"خَلَقَ"},{"ar":"سَبْعَ","tr":"sabʿa","en":"seven","root":"سبع","lem":"سَبْع"},{"ar":"سَمَـٰوَٰتٍۢ","tr":"samāwātin","en":"heavens","root":"سمو","lem":"سَماء"},{"ar":"طِبَاقًۭا ۖ","tr":"ṭibāqan","en":"one above another","root":"طبق","lem":"طَبَق"},{"ar":"مَّا","tr":"mā","en":"Not"},{"ar":"تَرَىٰ","tr":"tarā","en":"you see","root":"رأي","lem":"رَأَى"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"خَلْقِ","tr":"khalqi","en":"(the) creation","root":"خلق","lem":"خَلْق"},{"ar":"ٱلرَّحْمَـٰنِ","tr":"l-raḥmāni","en":"(of) the Most Gracious","root":"رحم","lem":"رَحْمٰن"},{"ar":"مِن","tr":"min","en":"any"},{"ar":"تَفَـٰوُتٍۢ ۖ","tr":"tafāwutin","en":"fault","root":"فوت","lem":"تَفاوُت"},{"ar":"فَٱرْجِعِ","tr":"fa-ir'jiʿi","en":"So return","root":"رجع","lem":"رَجَعَ"},{"ar":"ٱلْبَصَرَ","tr":"l-baṣara","en":"the vision","root":"بصر","lem":"بَصَر"},{"ar":"هَلْ","tr":"hal","en":"can"},{"ar":"تَرَىٰ","tr":"tarā","en":"you see","root":"رأي","lem":"رَأَى"},{"ar":"مِن","tr":"min","en":"any"},{"ar":"فُطُورٍۢ","tr":"fuṭūrin","en":"flaw","root":"فطر","lem":"فُطُور"}]},{"n":4,"juz":29,"ar":"ثُمَّ ٱرْجِعِ ٱلْبَصَرَ كَرَّتَيْنِ يَنقَلِبْ إِلَيْكَ ٱلْبَصَرُ خَاسِئًا وَهُوَ حَسِيرٌ","en":"Then return [your] vision twice again. [Your] vision will return to you humbled while it is fatigued.","w":[{"ar":"ثُمَّ","tr":"thumma","en":"Then"},{"ar":"ٱرْجِعِ","tr":"ir'jiʿi","en":"return","root":"رجع","lem":"رَجَعَ"},{"ar":"ٱلْبَصَرَ","tr":"l-baṣara","en":"the vision","root":"بصر","lem":"بَصَر"},{"ar":"كَرَّتَيْنِ","tr":"karratayni","en":"twice (again)","root":"كرر","lem":"كَرَّة"},{"ar":"يَنقَلِبْ","tr":"yanqalib","en":"Will return","root":"قلب","lem":"انقَلَبَ"},{"ar":"إِلَيْكَ","tr":"ilayka","en":"to you"},{"ar":"ٱلْبَصَرُ","tr":"l-baṣaru","en":"the vision","root":"بصر","lem":"بَصَر"},{"ar":"خَاسِئًۭا","tr":"khāsi-an","en":"humbled","root":"خسأ","lem":"خاسِئ"},{"ar":"وَهُوَ","tr":"wahuwa","en":"while it"},{"ar":"حَسِيرٌۭ","tr":"ḥasīrun","en":"(is) fatigued","root":"حسر","lem":"حَسِير"}]},{"n":5,"juz":29,"ar":"وَلَقَدْ زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَـٰبِيحَ وَجَعَلْنَـٰهَا رُجُومًا لِّلشَّيَـٰطِينِ ۖ وَأَعْتَدْنَا لَهُمْ عَذَابَ ٱلسَّعِيرِ","en":"And We have certainly beautified the nearest heaven with lamps [i.e., stars] and have made [from] them what is thrown at the devils and have prepared for them the punishment of the Blaze.","w":[{"ar":"وَلَقَدْ","tr":"walaqad","en":"And certainly"},{"ar":"زَيَّنَّا","tr":"zayyannā","en":"We have beautified","root":"زين","lem":"زَيَّنَ"},{"ar":"ٱلسَّمَآءَ","tr":"l-samāa","en":"the heaven","root":"سمو","lem":"سَماء"},{"ar":"ٱلدُّنْيَا","tr":"l-dun'yā","en":"nearest","root":"دنو","lem":"دُنْيا"},{"ar":"بِمَصَـٰبِيحَ","tr":"bimaṣābīḥa","en":"with lamps","root":"صبح","lem":"مِصْباح"},{"ar":"وَجَعَلْنَـٰهَا","tr":"wajaʿalnāhā","en":"and We have made them","root":"جعل","lem":"جَعَلَ"},{"ar":"رُجُومًۭا","tr":"rujūman","en":"(as) missiles","root":"رجم","lem":"رُجُوم"},{"ar":"لِّلشَّيَـٰطِينِ ۖ","tr":"lilshayāṭīni","en":"for the devils","root":"شطن","lem":"شَيْطان"},{"ar":"وَأَعْتَدْنَا","tr":"wa-aʿtadnā","en":"and We have prepared","root":"عتد","lem":"أَعْتَدَتْ"},{"ar":"لَهُمْ","tr":"lahum","en":"for them"},{"ar":"عَذَابَ","tr":"ʿadhāba","en":"punishment","root":"عذب","lem":"عَذاب"},{"ar":"ٱلسَّعِيرِ","tr":"l-saʿīri","en":"(of) the Blaze","root":"سعر","lem":"سَعِير"}]},{"n":6,"juz":29,"ar":"وَلِلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ عَذَابُ جَهَنَّمَ ۖ وَبِئْسَ ٱلْمَصِيرُ","en":"And for those who disbelieved in their Lord is the punishment of Hell, and wretched is the destination.","w":[{"ar":"وَلِلَّذِينَ","tr":"walilladhīna","en":"And for those who"},{"ar":"كَفَرُوا۟","tr":"kafarū","en":"disbelieved","root":"كفر","lem":"كَفَرَ"},{"ar":"بِرَبِّهِمْ","tr":"birabbihim","en":"in their Lord","root":"ربب","lem":"رَبّ"},{"ar":"عَذَابُ","tr":"ʿadhābu","en":"(is the) punishment","root":"عذب","lem":"عَذاب"},{"ar":"جَهَنَّمَ ۖ","tr":"jahannama","en":"(of) Hell"},{"ar":"وَبِئْسَ","tr":"wabi'sa","en":"and wretched is","root":"بأس","lem":"بِئْسَ"},{"ar":"ٱلْمَصِيرُ","tr":"l-maṣīru","en":"the destination","root":"صير","lem":"مَصِير"}]},{"n":7,"juz":29,"ar":"إِذَآ أُلْقُوا۟ فِيهَا سَمِعُوا۟ لَهَا شَهِيقًا وَهِىَ تَفُورُ","en":"When they are thrown into it, they hear from it a [dreadful] inhaling while it boils up.","w":[{"ar":"إِذَآ","tr":"idhā","en":"When"},{"ar":"أُلْقُوا۟","tr":"ul'qū","en":"they are thrown","root":"لقي","lem":"أَلْقَى"},{"ar":"فِيهَا","tr":"fīhā","en":"therein"},{"ar":"سَمِعُوا۟","tr":"samiʿū","en":"they will hear","root":"سمع","lem":"سَمِعَ"},{"ar":"لَهَا","tr":"lahā","en":"from it"},{"ar":"شَهِيقًۭا","tr":"shahīqan","en":"an inhaling","root":"شهق","lem":"شَهِيق"},{"ar":"وَهِىَ","tr":"wahiya","en":"while it"},{"ar":"تَفُورُ","tr":"tafūru","en":"boils up","root":"فور","lem":"فارَ"}]},{"n":8,"juz":29,"ar":"تَكَادُ تَمَيَّزُ مِنَ ٱلْغَيْظِ ۖ كُلَّمَآ أُلْقِىَ فِيهَا فَوْجٌ سَأَلَهُمْ خَزَنَتُهَآ أَلَمْ يَأْتِكُمْ نَذِيرٌ","en":"It almost bursts with rage. Every time a company is thrown into it, its keepers ask them, \"Did there not come to you a warner?\"","w":[{"ar":"تَكَادُ","tr":"takādu","en":"It almost","root":"كود","lem":"كادَ"},{"ar":"تَمَيَّزُ","tr":"tamayyazu","en":"bursts","root":"ميز","lem":"تَمَيَّزُ"},{"ar":"مِنَ","tr":"mina","en":"from"},{"ar":"ٱلْغَيْظِ ۖ","tr":"l-ghayẓi","en":"rage","root":"غيظ","lem":"غَيْظ"},{"ar":"كُلَّمَآ","tr":"kullamā","en":"Every time","root":"كلل","lem":"كُلَّما"},{"ar":"أُلْقِىَ","tr":"ul'qiya","en":"is thrown","root":"لقي","lem":"أَلْقَى"},{"ar":"فِيهَا","tr":"fīhā","en":"therein"},{"ar":"فَوْجٌۭ","tr":"fawjun","en":"a group","root":"فوج","lem":"فَوْج"},{"ar":"سَأَلَهُمْ","tr":"sa-alahum","en":"(will) ask them","root":"سأل","lem":"سَأَلَ"},{"ar":"خَزَنَتُهَآ","tr":"khazanatuhā","en":"its keepers","root":"خزن","lem":"خَزَنَت"},{"ar":"أَلَمْ","tr":"alam","en":"Did not"},{"ar":"يَأْتِكُمْ","tr":"yatikum","en":"come to you","root":"أتي","lem":"أَتَى"},{"ar":"نَذِيرٌۭ","tr":"nadhīrun","en":"a warner","root":"نذر","lem":"نَذِير"}]},{"n":9,"juz":29,"ar":"قَالُوا۟ بَلَىٰ قَدْ جَآءَنَا نَذِيرٌ فَكَذَّبْنَا وَقُلْنَا مَا نَزَّلَ ٱللَّهُ مِن شَىْءٍ إِنْ أَنتُمْ إِلَّا فِى ضَلَـٰلٍ كَبِيرٍ","en":"They will say, \"Yes, a warner had come to us, but we denied and said, 'Allāh has not sent down anything. You are not but in great error.'\"","w":[{"ar":"قَالُوا۟","tr":"qālū","en":"They will say","root":"قول","lem":"قالَ"},{"ar":"بَلَىٰ","tr":"balā","en":"Yes"},{"ar":"قَدْ","tr":"qad","en":"indeed"},{"ar":"جَآءَنَا","tr":"jāanā","en":"came to us","root":"جيأ","lem":"جاءَ"},{"ar":"نَذِيرٌۭ","tr":"nadhīrun","en":"a warner","root":"نذر","lem":"نَذِير"},{"ar":"فَكَذَّبْنَا","tr":"fakadhabnā","en":"but we denied","root":"كذب","lem":"كَذَّبَ"},{"ar":"وَقُلْنَا","tr":"waqul'nā","en":"and we said","root":"قول","lem":"قالَ"},{"ar":"مَا","tr":"mā","en":"Not"},{"ar":"نَزَّلَ","tr":"nazzala","en":"has sent down","root":"نزل","lem":"نَزَّلَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"مِن","tr":"min","en":"any"},{"ar":"شَىْءٍ","tr":"shayin","en":"thing","root":"شيأ","lem":"شَىْء"},{"ar":"إِنْ","tr":"in","en":"Not"},{"ar":"أَنتُمْ","tr":"antum","en":"you (are)"},{"ar":"إِلَّا","tr":"illā","en":"but"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"ضَلَـٰلٍۢ","tr":"ḍalālin","en":"error","root":"ضلل","lem":"ضَلال"},{"ar":"كَبِيرٍۢ","tr":"kabīrin","en":"great","root":"كبر","lem":"كَبِير"}]},{"n":10,"juz":29,"ar":"وَقَالُوا۟ لَوْ كُنَّا نَسْمَعُ أَوْ نَعْقِلُ مَا كُنَّا فِىٓ أَصْحَـٰبِ ٱلسَّعِيرِ","en":"And they will say, \"If only we had been listening or reasoning, we would not be among the companions of the Blaze.\"","w":[{"ar":"وَقَالُوا۟","tr":"waqālū","en":"And they will say","root":"قول","lem":"قالَ"},{"ar":"لَوْ","tr":"law","en":"If"},{"ar":"كُنَّا","tr":"kunnā","en":"we had","root":"كون","lem":"كانَ"},{"ar":"نَسْمَعُ","tr":"nasmaʿu","en":"listened","root":"سمع","lem":"سَمِعَ"},{"ar":"أَوْ","tr":"aw","en":"or"},{"ar":"نَعْقِلُ","tr":"naʿqilu","en":"reasoned","root":"عقل","lem":"عَقَلُ"},{"ar":"مَا","tr":"mā","en":"not"},{"ar":"كُنَّا","tr":"kunnā","en":"we (would) have been","root":"كون","lem":"كانَ"},{"ar":"فِىٓ","tr":"fī","en":"among"},{"ar":"أَصْحَـٰبِ","tr":"aṣḥābi","en":"(the) companions","root":"صحب","lem":"أَصْحاب"},{"ar":"ٱلسَّعِيرِ","tr":"l-saʿīri","en":"(of) the Blaze","root":"سعر","lem":"سَعِير"}]},{"n":11,"juz":29,"ar":"فَٱعْتَرَفُوا۟ بِذَنۢبِهِمْ فَسُحْقًا لِّأَصْحَـٰبِ ٱلسَّعِيرِ","en":"And they will admit their sin, so [it is] alienation for the companions of the Blaze.","w":[{"ar":"فَٱعْتَرَفُوا۟","tr":"fa-iʿ'tarafū","en":"Then they (will) confess","root":"عرف","lem":"اعْتَرَفُ"},{"ar":"بِذَنۢبِهِمْ","tr":"bidhanbihim","en":"their sins","root":"ذنب","lem":"ذَنب"},{"ar":"فَسُحْقًۭا","tr":"fasuḥ'qan","en":"so away with","root":"سحق","lem":"سُحْق"},{"ar":"لِّأَصْحَـٰبِ","tr":"li-aṣḥābi","en":"(the) companions","root":"صحب","lem":"أَصْحاب"},{"ar":"ٱلسَّعِيرِ","tr":"l-saʿīri","en":"(of) the Blaze","root":"سعر","lem":"سَعِير"}]},{"n":12,"juz":29,"ar":"إِنَّ ٱلَّذِينَ يَخْشَوْنَ رَبَّهُم بِٱلْغَيْبِ لَهُم مَّغْفِرَةٌ وَأَجْرٌ كَبِيرٌ","en":"Indeed, those who fear their Lord unseen will have forgiveness and great reward.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"يَخْشَوْنَ","tr":"yakhshawna","en":"fear","root":"خشي","lem":"خَشِيَ"},{"ar":"رَبَّهُم","tr":"rabbahum","en":"their Lord","root":"ربب","lem":"رَبّ"},{"ar":"بِٱلْغَيْبِ","tr":"bil-ghaybi","en":"unseen","root":"غيب","lem":"غَيْب"},{"ar":"لَهُم","tr":"lahum","en":"for them"},{"ar":"مَّغْفِرَةٌۭ","tr":"maghfiratun","en":"(is) forgiveness","root":"غفر","lem":"مَغْفِرَة"},{"ar":"وَأَجْرٌۭ","tr":"wa-ajrun","en":"and a reward","root":"أجر","lem":"أَجْر"},{"ar":"كَبِيرٌۭ","tr":"kabīrun","en":"great","root":"كبر","lem":"كَبِير"}]},{"n":13,"juz":29,"ar":"وَأَسِرُّوا۟ قَوْلَكُمْ أَوِ ٱجْهَرُوا۟ بِهِۦٓ ۖ إِنَّهُۥ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ","en":"And conceal your speech or publicize it; indeed, He is Knowing of that within the breasts.","w":[{"ar":"وَأَسِرُّوا۟","tr":"wa-asirrū","en":"And conceal","root":"سرر","lem":"أَسَرَّ"},{"ar":"قَوْلَكُمْ","tr":"qawlakum","en":"your speech","root":"قول","lem":"قَوْل"},{"ar":"أَوِ","tr":"awi","en":"or"},{"ar":"ٱجْهَرُوا۟","tr":"ij'harū","en":"proclaim","root":"جهر","lem":"جَهَرَ"},{"ar":"بِهِۦٓ ۖ","tr":"bihi","en":"it"},{"ar":"إِنَّهُۥ","tr":"innahu","en":"Indeed, He"},{"ar":"عَلِيمٌۢ","tr":"ʿalīmun","en":"(is the) All-Knower","root":"علم","lem":"عَلِيم"},{"ar":"بِذَاتِ","tr":"bidhāti","en":"of what (is in)"},{"ar":"ٱلصُّدُورِ","tr":"l-ṣudūri","en":"the breasts","root":"صدر","lem":"صَدْر"}]},{"n":14,"juz":29,"ar":"أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ ٱللَّطِيفُ ٱلْخَبِيرُ","en":"Does He who created not know, while He is the Subtle, the Aware?","w":[{"ar":"أَلَا","tr":"alā","en":"Does not"},{"ar":"يَعْلَمُ","tr":"yaʿlamu","en":"know","root":"علم","lem":"عَلِمَ"},{"ar":"مَنْ","tr":"man","en":"(the One) Who"},{"ar":"خَلَقَ","tr":"khalaqa","en":"created","root":"خلق","lem":"خَلَقَ"},{"ar":"وَهُوَ","tr":"wahuwa","en":"And He"},{"ar":"ٱللَّطِيفُ","tr":"l-laṭīfu","en":"(is) the Subtle","root":"لطف","lem":"لَطِيف"},{"ar":"ٱلْخَبِيرُ","tr":"l-khabīru","en":"the All-Aware","root":"خبر","lem":"خَبِير"}]},{"n":15,"juz":29,"ar":"هُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ ذَلُولًا فَٱمْشُوا۟ فِى مَنَاكِبِهَا وَكُلُوا۟ مِن رِّزْقِهِۦ ۖ وَإِلَيْهِ ٱلنُّشُورُ","en":"It is He who made the earth tame for you - so walk among its slopes and eat of His provision - and to Him is the resurrection.","w"