{"n":88,"name":"Al-Ghashiyah","nameAr":"الغاشية","meaning":"The Overwhelming","ayahs":26,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ","en":"Has there reached you the report of the Overwhelming [event]?","w":[{"ar":"هَلْ","tr":"hal","en":"Has"},{"ar":"أَتَىٰكَ","tr":"atāka","en":"(there) come to you","root":"أتي","lem":"أَتَى"},{"ar":"حَدِيثُ","tr":"ḥadīthu","en":"(the) news","root":"حدث","lem":"حَدِيث"},{"ar":"ٱلْغَـٰشِيَةِ","tr":"l-ghāshiyati","en":"(of) the Overwhelming","root":"غشو","lem":"غاشِيَة"}]},{"n":2,"juz":30,"ar":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ","en":"[Some] faces, that Day, will be humbled,","w":[{"ar":"وُجُوهٌۭ","tr":"wujūhun","en":"Faces","root":"وجه","lem":"وَجْه"},{"ar":"يَوْمَئِذٍ","tr":"yawma-idhin","en":"that Day","root":"يوم","lem":"يَوْم"},{"ar":"خَـٰشِعَةٌ","tr":"khāshiʿatun","en":"(will be) humbled","root":"خشع","lem":"خاشِع"}]},{"n":3,"juz":30,"ar":"عَامِلَةٌ نَّاصِبَةٌ","en":"Working [hard] and exhausted.","w":[{"ar":"عَامِلَةٌۭ","tr":"ʿāmilatun","en":"Laboring","root":"عمل","lem":"عامِلَة"},{"ar":"نَّاصِبَةٌۭ","tr":"nāṣibatun","en":"exhausted","root":"نصب","lem":"ناصِبَة"}]},{"n":4,"juz":30,"ar":"تَصْلَىٰ نَارًا حَامِيَةً","en":"They will [enter to] burn in an intensely hot Fire.","w":[{"ar":"تَصْلَىٰ","tr":"taṣlā","en":"They will burn","root":"صلي","lem":"يَصْلَى"},{"ar":"نَارًا","tr":"nāran","en":"(in) a Fire","root":"نور","lem":"نار"},{"ar":"حَامِيَةًۭ","tr":"ḥāmiyatan","en":"intensely hot","root":"حمي","lem":"حامِيَة"}]},{"n":5,"juz":30,"ar":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","en":"They will be given drink from a boiling spring.","w":[{"ar":"تُسْقَىٰ","tr":"tus'qā","en":"They will be given to drink","root":"سقي","lem":"سَقَى"},{"ar":"مِنْ","tr":"min","en":"from"},{"ar":"عَيْنٍ","tr":"ʿaynin","en":"a spring","root":"عين","lem":"عَيْن"},{"ar":"ءَانِيَةٍۢ","tr":"āniyatin","en":"boiling","root":"أني","lem":"آنِيَة"}]},{"n":6,"juz":30,"ar":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","en":