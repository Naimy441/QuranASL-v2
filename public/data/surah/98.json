,"lem":"شَرّ"},{"ar":"ٱلْبَرِيَّةِ","tr":"l-bariyati","en":"(of) the creatures","root":"برأ","lem":"بَرِيَّة"}]},{"n":7,"juz":30,"ar":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ هُمْ خَيْرُ ٱلْبَرِيَّةِ","en":"Indeed, they who have believed and done righteous deeds - those are the best of creatures.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"believe","root":"أمن","lem":"آمَنَ"},{"ar":"وَعَمِلُوا۟","tr":"waʿamilū","en":"and do","root":"عمل","lem":"عَمِلَ"},{"ar":"ٱلصَّـٰلِحَـٰتِ","tr":"l-ṣāliḥāti","en":"righteous deeds","root":"صلح","lem":"صالِحَة"},{"ar":"أُو۟لَـٰٓئِكَ","tr":"ulāika","en":"those "},{"ar":"هُمْ","tr":"hum","en":"they"},{"ar":"خَيْرُ","tr":"khayru","en":"(are the) best","root":"خير","lem":"خَيْر"},{"ar":"ٱلْبَرِيَّةِ","tr":"l-bariyati","en":"(of) the creatures","root":"برأ","lem":"بَرِيَّة"}]},{"n":8,"juz":30,"ar":"جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّـٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ","en":"Their reward with their Lord will be gardens of perpetual residence beneath which rivers flow, wherein they will abide forever, Allāh being pleased with them and they with Him. That is for whoever has feared his Lord.","w":[{"ar":"جَزَآؤُهُمْ","tr":"jazāuhum","en":"Their reward","root":"جزي","lem":"جَزاء"},{"ar":"عِندَ","tr":"ʿinda","en":"(is) with","root":"عند","lem":"عِند"},{"ar":"رَبِّهِمْ","tr":"rabbihim","en":"their Lord ","root":"ربب","lem":"رَبّ"},{"ar":"جَنَّـٰتُ","tr":"jannātu","en":"Gardens","root":"جنن","lem":"جَنَّة"},{"ar":"عَدْنٍۢ","tr":"ʿadnin","en":"(of) Eternity"},{"ar":"تَجْرِى","tr":"tajrī","en":"flow","root":"جري","lem":"جَرَيْ"},{"ar":"مِن","tr":"min","en":"from"},{"ar":"تَحْتِهَا","tr":"taḥtihā","en":"underneath them","root":"تحت","lem":"تَحْت"},{"ar":"ٱلْأَنْهَـٰرُ","tr":"l-anhāru","en":"the rivers","root":"نهر","lem":"نَهَر"},{"ar":"خَـٰلِدِينَ","tr":"khālidīna","en":"will abide","root":"خلد","lem":"خالِد"},{"ar":"فِيهَآ","tr":"fīhā","en":"therein"},{"ar":"أَبَدًۭا ۖ","tr":"abadan","en":"forever","root":"أبد","lem":"أَبَدًا"},{"ar":"رَّضِىَ","tr":"raḍiya","en":"(will be) pleased","root":"رضو","lem":"رَضِيَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"عَنْهُمْ","tr":"ʿanhum","en":"with them"},{"ar":"وَرَضُوا۟","tr":"waraḍū","en":"and they (will be) pleased","root":"رضو","lem":"رَضِيَ"},{"ar":"عَنْهُ ۚ","tr":"ʿanhu","en":"with Him"},{"ar":"ذَٰلِكَ","tr":"dhālika","en":"That"},{"ar":"لِمَنْ","tr":"liman","en":"(is) for whoever"},{"ar":"خَشِىَ","tr":"khashiya","en":"feared","root":"خشي","lem":"خَشِيَ"},{"ar":"رَبَّهُۥ","tr":"rabbahu","en":"his Lord","root":"ربب","lem":"رَبّ"}]}]}