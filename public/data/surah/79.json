":"then"},{"ar":"كَرَّةٌ","tr":"karratun","en":"(would be) a return","root":"كرر","lem":"كَرَّة"},{"ar":"خَاسِرَةٌۭ","tr":"khāsiratun","en":"losing","root":"خسر","lem":"خاسِرَة"}]},{"n":13,"juz":30,"ar":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ","en":"Indeed, it will be but one shout,","w":[{"ar":"فَإِنَّمَا","tr":"fa-innamā","en":"Then only"},{"ar":"هِىَ","tr":"hiya","en":"it"},{"ar":"زَجْرَةٌۭ","tr":"zajratun","en":"(will be) a shout","root":"زجر","lem":"زَجْرَة"},{"ar":"وَٰحِدَةٌۭ","tr":"wāḥidatun","en":"single","root":"وحد","lem":"واحِدَة"}]},{"n":14,"juz":30,"ar":"فَإِذَا هُم بِٱلسَّاهِرَةِ","en":"And suddenly they will be [alert] upon the earth's surface.","w":[{"ar":"فَإِذَا","tr":"fa-idhā","en":"And behold"},{"ar":"هُم","tr":"hum","en":"They"},{"ar":"بِٱلسَّاهِرَةِ","tr":"bil-sāhirati","en":"(will be) awakened","root":"سهر","lem":"ساهِرَة"}]},{"n":15,"juz":30,"ar":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","en":"Has there reached you the story of Moses? -","w":[{"ar":"هَلْ","tr":"hal","en":"Has"},{"ar":"أَتَىٰكَ","tr":"atāka","en":"(there) come to you","root":"أتي","lem":"أَتَى"},{"ar":"حَدِيثُ","tr":"ḥadīthu","en":"(the) story","root":"حدث","lem":"حَدِيث"},{"ar":"مُوسَىٰٓ","tr":"mūsā","en":"(of) Musa"}]},{"n":16,"juz":30,"ar":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","en":"When his Lord called to him in the sacred valley of Ṭuwā,","w":[{"ar":"إِذْ","tr":"idh","en":"When"},{"ar":"نَادَىٰهُ","tr":"nādāhu","en":"called him","root":"ندي","lem":"نادَى"},{"ar":"رَبُّهُۥ","tr":"rabbuhu","en":"his Lord","root":"ربب","lem":"رَبّ"},{"ar":"بِٱلْوَادِ","tr":"bil-wādi","en":"in the valley","root":"ودي","lem":"واد"},{"ar":"ٱلْمُقَدَّسِ","tr":"l-muqadasi","en":"the sacred","root":"قدس","lem":"مُقَدَّس"},{"ar":"طُوًى","tr":"ṭuwan","en":"(of) Tuwa","root":"طوي","lem":"طُوًى"}]},{"n":17,"juz":30,"ar":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","en":"\"Go to Pharaoh. Indeed, he has transgressed.","w":[{"ar":"ٱذْهَبْ","tr":"idh'hab","en":"Go","root":"ذهب","lem":"ذَهَبَ"},{"ar":"إِلَىٰ","tr":"ilā","en":"to"},{"ar":"فِرْعَوْنَ","tr":"fir'ʿawna","en":"Firaun"},{"ar":"إِنَّهُۥ","tr":"innahu","en":"Indeed, he"},{"ar":"طَغَىٰ","tr":"ṭaghā","en":"(has) transgressed","root":"طغي","lem":"طَغَى"}]},{"n":18,"juz":30,"ar":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","en":"And say to him, 'Would you [be willing to] purify yourself","w":[{"ar":"فَقُلْ","tr":"faqul","en":"And say","root":"قول","lem":"قالَ"},{"ar":"هَل","tr":"hal","en":"Would"},{"ar":"لَّكَ","tr":"laka","en":"[for] you"},{"ar":"إِلَىٰٓ","tr":"ilā","en":"[to]"},{"ar":"أَن","tr":"an","en":"[that]"},{"ar":"تَزَكَّىٰ","tr":"tazakkā","en":"purify yourself","root":"زكو","lem":"تَزَكَّى"}]},{"n":19,"juz":30,"ar":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","en":"And let me guide you to your Lord so you would fear [Him]?'\"","w":[{"ar":"وَأَهْدِيَكَ","tr":"wa-ahdiyaka","en":"And I will guide you","root":"هدي","lem":"هَدَى"},{"ar":"إِلَىٰ","tr":"ilā","en":"to"},{"ar":"رَبِّكَ","tr":"rabbika","en":"your Lord","root":"ربب","lem":"رَبّ"},{"ar":"فَتَخْشَىٰ","tr":"fatakhshā","en":"so you would fear","root":"خشي","lem":"خَشِيَ"}]},{"n":20,"juz":30,"ar":"فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ","en":"And he showed him the greatest sign,","w":[{"ar":"فَأَرَىٰهُ","tr":"fa-arāhu","en":"Then he showed him","root":"رأي","lem":"رَأَى"},{"ar":"ٱلْـَٔايَةَ","tr":"l-āyata","en":"the sign","root":"أيي","lem":"آيَة"},{"ar":"ٱلْكُبْرَىٰ","tr":"l-kub'rā","en":"the great","root":"كبر","lem":"كُبْرَى"}]},{"n":21,"juz":30,"ar":"فَكَذَّبَ وَعَصَىٰ","en":"But he [i.e., Pharaoh] denied and disobeyed.","w":[{"ar":"فَكَذَّبَ","tr":"fakadhaba","en":"But he denied","root":"كذب","lem":"كَذَّبَ"},{"ar":"وَعَصَىٰ","tr":"waʿaṣā","en":"and disobeyed","root":"عصي","lem":"عَصا"}]},{"n":22,"juz":30,"ar":"ثُمَّ أَدْبَرَ يَسْعَىٰ","en":"Then he turned his back, striving [i.e., plotting].","w":[{"ar":"ثُمَّ","tr":"thumma","en":"Then"},{"ar":"أَدْبَرَ","tr":"adbara","en":"he turned his back","root":"دبر","lem":"أَدْبَرَ"},{"ar":"يَسْعَىٰ","tr":"yasʿā","en":"striving","root":"سعي","lem":"سَعَى"}]},{"n":23,"juz":30,"ar":"فَحَشَرَ فَنَادَىٰ","en":"And he gathered [his people] and called out.","w":[{"ar":"فَحَشَرَ","tr":"faḥashara","en":"And he gathered","root":"حشر","lem":"حَشَرَ"},{"ar":"فَنَادَىٰ","tr":"fanādā","en":"and called out","root":"ندي","lem":"نادَى"}]},{"n":24,"juz":30,"ar":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","en":"And said, \"I am your most exalted lord.\"","w":[{"ar":"فَقَالَ","tr":"faqāla","en":"Then he said","root":"قول","lem":"قالَ"},{"ar":"أَنَا۠","tr":"anā","en":"I am"},{"ar":"رَبُّكُمُ","tr":"rabbukumu","en":"your Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلْأَعْلَىٰ","tr":"l-aʿlā","en":"the Most High","root":"علو","lem":"أَعْلَى"}]},{"n":25,"juz":30,"ar":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ","en":"So Allāh seized him in exemplary punishment for the last and the first [transgression]..","w":[{"ar":"فَأَخَذَهُ","tr":"fa-akhadhahu","en":"So seized him","root":"أخذ","lem":"أَخَذَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"نَكَالَ","tr":"nakāla","en":"(with) an exemplary punishment","root":"نكل","lem":"نَكال"},{"ar":"ٱلْـَٔاخِرَةِ","tr":"l-ākhirati","en":"(for) the last","root":"أخر","lem":"آخِر"},{"ar":"وَٱلْأُولَىٰٓ","tr":"wal-ūlā","en":"and the first","root":"أول","lem":"أَوَّل"}]},{"n":26,"juz":30,"ar":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ","en":"Indeed in that is a lesson [i.e., warning] for whoever would fear [Allāh].","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"ذَٰلِكَ","tr":"dhālika","en":"that"},{"ar":"لَعِبْرَةًۭ","tr":"laʿib'ratan","en":"surely (is) a lesson","root":"عبر","lem":"عِبْرَة"},{"ar":"لِّمَن","tr":"liman","en":"for whoever"},{"ar":"يَخْشَىٰٓ","tr":"yakhshā","en":"fears","root":"خشي","lem":"خَشِيَ"}]},{"n":27,"juz":30,"ar":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","en":"Are you a more difficult creation or is the heaven? He [i.e., Allāh] constructed it.","w