{"n":79,"name":"An-Nazi'at","nameAr":"النازعات","meaning":"Those who drag forth","ayahs":46,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"وَٱلنَّـٰزِعَـٰتِ غَرْقًا","en":"By those [angels] who extract with violence","w":[{"ar":"وَٱلنَّـٰزِعَـٰتِ","tr":"wal-nāziʿāti","en":"By those who extract","root":"نزع","lem":"نازِعَة"},{"ar":"غَرْقًۭا","tr":"gharqan","en":"violently","root":"غرق","lem":"غَرْق"}]},{"n":2,"juz":30,"ar":"وَٱلنَّـٰشِطَـٰتِ نَشْطًا","en":"And [by] those who remove with ease","w":[{"ar":"وَٱلنَّـٰشِطَـٰتِ","tr":"wal-nāshiṭāti","en":"And those who draw out","root":"نشط","lem":"ناشِطَة"},{"ar":"نَشْطًۭا","tr":"nashṭan","en":"gently","root":"نشط","lem":"نَشْط"}]},{"n":3,"juz":30,"ar":"وَٱلسَّـٰبِحَـٰتِ سَبْحًا","en":"And [by] those who glide [as if] swimming","w":[{"ar":"وَٱلسَّـٰبِحَـٰتِ","tr":"wal-sābiḥāti","en":"And those who glide","root":"سبح","lem":"سابِحَة"},{"ar":"سَبْحًۭا","tr":"sabḥan","en":"swimming","root":"سبح","lem":"سَبْح"}]},{"n":4,"juz":30,"ar":"فَٱلسَّـٰبِقَـٰتِ سَبْقًا","en":"And those who race each other in a race","w":[{"ar":"فَٱلسَّـٰبِقَـٰتِ","tr":"fal-sābiqāti","en":"And those who race each other","root":"سبق","lem":"سابِقَة"},{"ar":"سَبْقًۭا","tr":"sabqan","en":"(in) a race","root":"سبق","lem":"سَبْق"}]},{"n":5,"juz":30,"ar":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","en":"And those who arrange [each] matter,","w":[{"ar":"فَٱلْمُدَبِّرَٰتِ","tr":"fal-mudabirāti","en":"And those who arrange","root":"دبر","lem":"مُدَبِّرَة"},{"ar":"أَمْرًۭا","tr":"amran","en":"(the) matter","root":"أمر","lem":"أَمْر"}]},{"n":6,"juz":30,"ar":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","en":"On the Day the blast [of the Horn] will convulse [creation],","w":[{"ar":"يَوْمَ","tr":"yawma","en":"(The) Day","root":"يوم","lem":"يَوْم"},{"ar":"تَرْجُفُ","tr":"tarjufu","en":"will quake","root":"رجف","lem":"تَرْجُفُ"},{"ar":"ٱلرَّاجِفَةُ","tr":"l-rājifatu","en":"the quaking one","root":"رجف","lem":"راجِفَة"}]},{"n":7,"juz":30,"ar":"تَتْبَعُهَا ٱلرَّادِفَةُ","en":"There 