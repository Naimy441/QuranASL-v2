{"n":109,"name":"Al-Kafirun","nameAr":"الكافرون","meaning":"The Disbelievers","ayahs":6,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","en":"Say, \"O disbelievers,","w":[{"ar":"قُلْ","tr":"qul","en":"Say","root":"قول","lem":"قالَ"},{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O","root":"أيي","lem":"أَيّ"},{"ar":"ٱلْكَـٰفِرُونَ","tr":"l-kāfirūna","en":"disbelievers","root":"كفر","lem":"كافِر"}]},{"n":2,"juz":30,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","en":"I do not worship what you worship.","w":[{"ar":"لَآ","tr":"lā","en":"Not"},{"ar":"أَعْبُدُ","tr":"aʿbudu","en":"I worship","root":"عبد","lem":"عَبَدَ"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"تَعْبُدُونَ","tr":"taʿbudūna","en":"you worship","root":"عبد","lem":"عَبَدَ"}]},{"n":3,"juz":30,"ar":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","en":"Nor are you worshippers of what I worship.","w":[{"ar":"وَلَآ","tr":"walā","en":"And not"},{"ar":"أَنتُمْ","tr":"antum","en":"you"},{"ar":"عَـٰبِدُونَ","tr":"ʿābidūna","en":"(are) worshippers","root":"عبد","lem":"عابِد"},{"ar":"مَآ","tr":"mā","en":"(of) what"},{"ar":"أَعْبُدُ","tr":"aʿbudu","en":"I worship","root":"عبد","lem":"عَبَدَ"}]},{"n":4,"juz":30,"ar":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","en":"Nor will I be a worshipper of what you worship.","w":[{"ar":"وَلَآ","tr":"walā","en":"And not"},{"ar":"أَنَا۠","tr":"anā","en":"I am"},{"ar":"عَابِدٌۭ","tr":"ʿābidun","en":"a worshipper","root":"عبد","lem":"عابِد"},{"ar":"مَّا","tr":"mā","en":"(of) what"},{"ar":"عَبَدتُّمْ","tr":"ʿabadttum","en":"you worship","root":"عبد","lem":"عَبَدَ"}]},{"n":5,"juz":30,"ar":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","en":"Nor will you be worshippers of what I worship.","w":[{"ar":"وَلَآ","tr":"walā","en":"And not"},{"ar":"أَنتُمْ","tr":"antum","en":"you"},{"ar":"عَـٰبِدُونَ","tr":"ʿābidūna","en":"(are) worshippers","root":"عبد","lem":"عابِد"},{"ar":"مَآ","tr":"mā","en":"(of) what"},{"ar":"أَعْبُدُ","tr":"aʿbudu","en":"I worship","root":"عبد","lem":"عَبَدَ"}]},{"n":6,"juz":30,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","en":"For you is your religion, and for me is my religion.\"","w":[{"ar":"لَكُمْ","tr":"lakum","en":"For you"},{"ar":"دِينُكُمْ","tr":"dīnukum","en":"(is) your religion","root":"دين","lem":"دِين"},{"ar":"وَلِىَ","tr":"waliya","en":"and for me"},{"ar":"دِينِ","tr":"dīni","en":"(is) my religion","root":"دين","lem":"دِين"}]}]}