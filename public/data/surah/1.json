{"n":1,"name":"Al-Fatihah","nameAr":"الفاتحة","meaning":"The Opener","ayahs":7,"place":"makkah","bismillah":false,"ayat":[{"n":1,"juz":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","en":"In the name of Allāh, the Entirely Merciful, the Especially Merciful.","w":[{"ar":"بِسْمِ","tr":"bis'mi","en":"In (the) name","root":"سمو","lem":"اسْم"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"(of) Allah","root":"أله","lem":"اللَّه"},{"ar":"ٱلرَّحْمَـٰنِ","tr":"l-raḥmāni","en":"the Most Gracious","root":"رحم","lem":"رَحْمٰن"},{"ar":"ٱلرَّحِيمِ","tr":"l-raḥīmi","en":"the Most Merciful","root":"رحم","lem":"رَحِيم"}]},{"n":2,"juz":1,"ar":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","en":"[All] praise is [due] to Allāh, Lord of the worlds -","w":[{"ar":"ٱلْحَمْدُ","tr":"al-ḥamdu","en":"All praises and thanks","root":"حمد","lem":"حَمْد"},{"ar":"لِلَّهِ","tr":"lillahi","en":"(be) to Allah","root":"أله","lem":"اللَّه"},{"ar":"رَبِّ","tr":"rabbi","en":"the Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلْعَـٰلَمِينَ","tr":"l-ʿālamīna","en":"of the universe","root":"علم","lem":"عالَم"}]},{"n":3,"juz":1,"ar":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","en":"The Entirely Merciful, the Especially Merciful,","w":[{"ar":"ٱلرَّحْمَـٰنِ","tr":"al-raḥmāni","en":"The Most Gracious","root":"رحم","lem":"رَحْمٰن"},{"ar":"ٱلرَّحِيمِ","tr":"l-raḥīmi","en":"the Most Merciful","root":"رحم","lem":"رَحِيم"}]},{"n":4,"juz":1,"ar":"مَـٰلِكِ يَوْمِ ٱلدِّينِ","en":"Sovereign of the Day of Recompense.","w":[{"ar":"مَـٰلِكِ","tr":"māliki","en":"(The) Master","root":"ملك","lem":"مالِك"},{"ar":"يَوْمِ","tr":"yawmi","en":"(of the) Day","root":"يوم","lem":"يَوْم"},{"ar":"ٱلدِّينِ","tr":"l-dīni","en":"(of the) Judgment","root":"دين","lem":"دِين"}]},{"n":5,"juz":1,"ar":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","en":"It is You we worship and You we ask for help.","w":[{"ar":"إِيَّاكَ","tr":"iyyāka","en":"You Alone"},{"ar":"نَعْبُدُ","tr":"naʿbudu","en":"we worship","root":"عبد","lem":"عَبَدَ"},{"ar":"وَإِيَّاكَ","tr":"wa-iyyāka","en":"and You Alone"},{"ar":"نَسْتَعِينُ","tr":"nastaʿīnu","en":"we ask for help","root":"عون","lem":"اسْتَعِينُ"}]},{"n":6,"juz":1,"ar":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","en":"Guide us to the straight path -","w":[{"ar":"ٱهْدِنَا","tr":"ih'dinā","en":"Guide us","root":"هدي","lem":"هَدَى"},{"ar":"ٱلصِّرَٰطَ","tr":"l-ṣirāṭa","en":"(to) the path","root":"صرط","lem":"صِراط"},{"ar":"ٱلْمُسْتَقِيمَ","tr":"l-mus'taqīma","en":"the straight","root":"قوم","lem":"مُسْتَقِيم"}]},{"n":7,"juz":1,"ar":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","en":"The path of those upon whom You have bestowed favor, not of those who have earned [Your] anger or of those who are astray.","w":[{"ar":"صِرَٰطَ","tr":"ṣirāṭa","en":"(The) path","root":"صرط","lem":"صِراط"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"(of) those"},{"ar":"أَنْعَمْتَ","tr":"anʿamta","en":"You have bestowed (Your) Favors","root":"نعم","lem":"أَنْعَمَ"},{"ar":"عَلَيْهِمْ","tr":"ʿalayhim","en":"on them"},{"ar":"غَيْرِ","tr":"ghayri","en":"not (of)","root":"غير","lem":"غَيْر"},{"ar":"ٱلْمَغْضُوبِ","tr":"l-maghḍūbi","en":"those who earned (Your) wrath","root":"غضب","lem":"مَغْضُوب"},{"ar":"عَلَيْهِمْ","tr":"ʿalayhim","en":"on themselves"},{"ar":"وَلَا","tr":"walā","en":"and not"},{"ar":"ٱلضَّآلِّينَ","tr":"l-ḍālīna","en":"(of) those who go astray","root":"ضلل","lem":"ضالّ"}]}]}