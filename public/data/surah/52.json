{"n":52,"name":"At-Tur","nameAr":"الطور","meaning":"The Mount","ayahs":49,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":27,"ar":"وَٱلطُّورِ","en":"By the mount","w":[{"ar":"وَٱلطُّورِ","tr":"wal-ṭūri","en":"By the Mount","root":"طور","lem":"طُور"}]},{"n":2,"juz":27,"ar":"وَكِتَـٰبٍ مَّسْطُورٍ","en":"And [by] a Book inscribed","w":[{"ar":"وَكِتَـٰبٍۢ","tr":"wakitābin","en":"And by (the) Book","root":"كتب","lem":"كِتاب"},{"ar":"مَّسْطُورٍۢ","tr":"masṭūrin","en":"written","root":"سطر","lem":"مَسْطُور"}]},{"n":3,"juz":27,"ar":"فِى رَقٍّ مَّنشُورٍ","en":"In parchment spread open","w":[{"ar":"فِى","tr":"fī","en":"In"},{"ar":"رَقٍّۢ","tr":"raqqin","en":"parchment","root":"رقق","lem":"رَقّ"},{"ar":"مَّنشُورٍۢ","tr":"manshūrin","en":"unrolled","root":"نشر","lem":"مَنشُور"}]},{"n":4,"juz":27,"ar":"وَٱلْبَيْتِ ٱلْمَعْمُورِ","en":"And [by] the frequented House","w":[{"ar":"وَٱلْبَيْتِ","tr":"wal-bayti","en":"By the House","root":"بيت","lem":"بَيْت"},{"ar":"ٱلْمَعْمُورِ","tr":"l-maʿmūri","en":"frequented","root":"عمر","lem":"مَعْمُور"}]},{"n":5,"juz":27,"ar":"وَٱلسَّقْفِ ٱلْمَرْفُوعِ","en":"And [by] the ceiling [i.e., heaven] raised high","w":[{"ar":"وَٱلسَّقْفِ","tr":"wal-saqfi","en":"By the roof","root":"سقف","lem":"سَقْف"},{"ar":"ٱلْمَرْفُوعِ","tr":"l-marfūʿi","en":"raised high","root":"رفع","lem":"مَرْفُوع"}]},{"n":6,"juz":27,"ar":"وَٱلْبَحْرِ ٱلْمَسْجُورِ","en":"And [by] the sea set on fire,","w":[{"ar":"وَٱلْبَحْرِ","tr":"wal-baḥri","en":"By the sea","root":"بحر","lem":"بَحْر"},{"ar":"ٱلْمَسْجُورِ","tr":"l-masjūri","en":"filled","root":"سجر","lem":"مَسْجُور"}]},{"n":7,"juz":27,"ar":"إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٌ","en":"Indeed, the punishment of your Lord will occur.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"عَذَابَ","tr":"ʿadhāba","en":"(the) punishment","root":"عذب","lem":"عَذاب"},{"ar":"رَبِّكَ","tr":"rabbika","en":"(of) your Lord","root":"ربب","lem":"رَبّ"},{"ar":"لَوَٰقِعٌۭ","tr":"lawāqiʿun","en":"(will) surely occur","root":"وقع","lem":"واقِع"}]},{"n":8,"juz":27,"ar":"مَّا لَهُۥ مِن دَافِعٍ","en":"Of it there is no preventer.","w":[{"ar":"مَّا","tr":"mā","en":"Not"},{"ar":"لَهُۥ","tr":"lahu","en":"for it"},{"ar":"مِن","tr":"min","en":"any"},{"ar":"دَافِعٍۢ","tr":"dāfiʿin","en":"preventer","root":"دفع","lem":"دافِع"}]},{"n":9,"juz":27,"ar":"يَوْمَ تَمُورُ ٱلسَّمَآءُ مَوْرًا","en":"On the Day the heaven will sway with circular motion","w":[{"ar":"يَوْمَ","tr":"yawma","en":"(On the) Day","root":"يوم","lem":"يَوْم"},{"ar":"تَمُورُ","tr":"tamūru","en":"will shake","root":"مور","lem":"تَمُورُ"},{"ar":"ٱلسَّمَآءُ","tr":"l-samāu","en":"the heaven","root":"سمو","lem":"سَماء"},{"ar":"مَوْرًۭا","tr":"mawran","en":"(with violent) shake","root":"مور","lem":"مَوْر"}]},{"n":10,"juz":27,"ar":"وَتَسِيرُ ٱلْجِبَالُ سَيْرًا","en":"And the mountains will pass on, departing -","w":[{"ar":"وَتَسِيرُ","tr":"watasīru","en":"And will move away","root":"سير","lem":"سارَ"},{"ar":"ٱلْجِبَالُ","tr":"l-jibālu","en":"the mountains","root":"جبل","lem":"جَبَل"},{"ar":"سَيْرًۭا","tr":"sayran","en":"(with an awful) movement","root":"سير","lem":"سَيْر"}]},{"n":11,"juz":27,"ar":"فَوَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","en":"Then woe, that Day, to the deniers,","w":[{"ar":"فَوَيْلٌۭ","tr":"fawaylun","en":"Then woe"},{"ar":"يَوْمَئِذٍۢ","tr":"yawma-idhin","en":"that Day","root":"يوم","lem":"يَوْم"},{"ar":"لِّلْمُكَذِّبِينَ","tr":"lil'mukadhibīna","en":"to the deniers","root":"كذب","lem":"مُكَذِّب"}]},{"n":12,"juz":27,"ar":"ٱلَّذِينَ هُمْ فِى خَوْضٍ يَلْعَبُونَ","en":"Who are in [empty] discourse amusing themselves.","w":[{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"Who"},{"ar":"هُمْ","tr":"hum","en":"[they]"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"خَوْضٍۢ","tr":"khawḍin","en":"(vain) discourse","root":"خوض","lem":"خَوْض"},{"ar":"يَلْعَبُونَ","tr":"yalʿabūna","en":"are playing","root":"لعب","lem":"يَلْعَبْ"}]},{"n":13,"juz":27,"ar":"يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا","en":"The Day they are thrust toward the fire of Hell with a [violent] thrust, [its angels will say],","w":[{"ar":"يَوْمَ","tr":"yawma","en":"(The) Day","root":"يوم","lem":"يَوْم"},{"ar":"يُدَعُّونَ","tr":"yudaʿʿūna","en":"they will be thrust","root":"دعع","lem":"يَدُعُّ"},{"ar":"إِلَىٰ","tr":"ilā","en":"(in)to"},{"ar":"نَارِ","tr":"nāri","en":"(the) Fire","root":"نور","lem":"نار"},{"ar":"جَهَنَّمَ","tr":"jahannama","en":"(of) Hell"},{"ar":"دَعًّا","tr":"daʿʿan","en":"(with) a thrust","root":"دعع","lem":"دَعّ"}]},{"n":14,"juz":27,"ar":"هَـٰذِهِ ٱلنَّارُ ٱلَّتِى كُنتُم بِهَا تُكَذِّبُونَ","en":"\"This is the Fire which you used to deny.","w":[{"ar":"هَـٰذِهِ","tr":"hādhihi","en":"This"},{"ar":"ٱلنَّارُ","tr":"l-nāru","en":"(is) the Fire","root":"نور","lem":"نار"},{"ar":"ٱلَّتِى","tr":"allatī","en":"which"},{"ar":"كُنتُم","tr":"kuntum","en":"you used to","root":"كون","lem":"كانَ"},{"ar":"بِهَا","tr":"bihā","en":"[of it]"},{"ar":"تُكَذِّبُونَ","tr":"tukadhibūna","en":"deny","root":"كذب","lem":"كَذَّبَ"}]},{"n":15,"juz":27,"ar":"أَفَسِحْرٌ هَـٰذَآ أَمْ أَنتُمْ لَا تُبْصِرُونَ","en":"Then is this magic, or do you not see?","w":[{"ar":"أَفَسِحْرٌ","tr":"afasiḥ'run","en":"Then is this magic","root":"سحر","lem":"سِحْر"},{"ar":"هَـٰذَآ","tr":"hādhā","en":"Then is this magic"},{"ar":"أَمْ","tr":"am","en":"or"},{"ar":"أَنتُمْ","tr":"antum","en":"you"},{"ar":"لَا","tr":"lā","en":"(do) not"},{"ar":"تُبْصِرُونَ","tr":"tub'ṣirūna","en":"see","root":"بصر","lem":"أَبْصَرَ"}]},{"n":16,"juz":27,"ar":"ٱصْلَوْهَا فَٱصْبِرُوٓا۟ أَوْ لَا تَصْبِرُوا۟ سَوَآءٌ عَلَيْكُمْ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ","en":"[Enter to] burn therein; then be patient or impatient - it is all the same for you. You are only being recompensed [for] what you used to do.\"","w":[{"ar":"ٱصْلَوْهَا","tr":"iṣ'lawhā","en":"Burn in it","root":"صلي","lem":"يَصْلَى"},{"ar":"فَٱصْبِرُوٓا۟","tr":"fa-iṣ'birū","en":"then be patient","root":"صبر","lem":"صَبَرَ"},{"ar":"أَوْ","tr":"aw","en":"or"},{"ar":"لَا","tr":"lā","en":"(do) not"},{"ar":"تَصْبِرُوا۟","tr":"taṣbirū","en":"be patient","root":"صبر","lem":"صَبَرَ"},{"ar":"سَوَآءٌ","tr":"sawāon","en":"(it is) same","root":"سوي","lem":"سَواء"},{"ar":"عَلَيْكُمْ ۖ","tr":"ʿalaykum","en":"for you"},{"ar":"إِنَّمَا","tr":"innamā","en":"Only"},{"ar":"تُجْزَوْنَ","tr":"tuj'zawna","en":"you are being recompensed","root":"جزي","lem":"جَزَى"},{"ar":"مَا","tr":"mā","en":"(for) what"},{"ar":"كُنتُمْ","tr":"kuntum","en":"you used to","root":"كون","lem":"كانَ"},{"ar":"تَعْمَلُونَ","tr":"taʿmalūna","en":"do","root":"عمل","lem":"عَمِلَ"}]},{"n":17,"juz":27,"ar":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَنَعِيمٍ","en":"Indeed, the righteous will be in gardens and pleasure,","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱلْمُتَّقِينَ","tr":"l-mutaqīna","en":"the righteous","root":"وقي","lem":"مُتَّقي"},{"ar":"فِى","tr":"fī","en":"(will be) in"},{"ar":"جَنَّـٰتٍۢ","tr":"jannātin","en":"Gardens","root":"جنن","lem":"جَنَّة"},{"ar":"وَنَعِيمٍۢ","tr":"wanaʿīmin","en":"and pleasure","root":"نعم","lem":"نَعِيم"}]},{"n":18,"juz":27,"ar":"فَـٰكِهِينَ بِمَآ ءَاتَىٰهُمْ رَبُّهُمْ وَوَقَىٰهُمْ رَبُّهُمْ عَذَابَ ٱلْجَحِيمِ","en":"Enjoying what their Lord has given them, and their Lord protected them from the punishment of Hellfire.","w":[{"ar":"فَـٰكِهِينَ","tr":"fākihīna","en":"Enjoying","root":"فكه","lem":"فاكِه"},{"ar":"بِمَآ","tr":"bimā","en":"in what"},{"ar":"ءَاتَىٰهُمْ","tr":"ātāhum","en":"has given them","root":"أتي","lem":"آتَى"},{"ar":"رَبُّهُمْ","tr":"rabbuhum","en":"their Lord","root":"ربب","lem":"رَبّ"},{"ar":"وَوَقَىٰهُمْ","tr":"wawaqāhum","en":"and protected them","root":"وقي","lem":"وَقَى"},{"ar":"رَبُّهُمْ","tr":"rabbuhum","en":"their Lord","root":"ربب","lem":"رَبّ"},{"ar":"عَذَابَ","tr":"ʿadhāba","en":"(from the) punishment","root":"عذب","lem":"عَذاب"},{"ar":"ٱلْجَحِيمِ","tr":"l-jaḥīmi","en":"(of) Hellfire","root":"جحم","lem":"جَحِيم"}]},{"n":19,"juz":27,"ar":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","en":"[They will be told], \"Eat and drink in satisfaction for what you used to do.\"","w":[{"ar":"كُلُوا۟","tr":"kulū","en":"Eat","root":"أكل","lem":"أَكَلَ"},{"ar":"وَٱشْرَبُوا۟","tr":"wa-ish'rabū","en":"and drink","root":"شرب","lem":"شَرِبَ"},{"ar":"هَنِيٓـًٔۢا","tr":"hanīan","en":"(in) satisfaction","root":"هنأ","lem":"هَنِيئ"},{"ar":"بِمَا","tr":"bimā","en":"for what"},{"ar":"كُنتُمْ","tr":"kuntum","en":"you used to","root":"كون","lem":"كانَ"},{"ar":"تَعْمَلُونَ","tr":"taʿmalūna","en":"do","root":"عمل","lem":"عَمِلَ"}]},{"n":20,"juz":27,"ar":"مُتَّكِـِٔينَ عَلَىٰ سُرُرٍ مَّصْفُوفَةٍ ۖ وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍ","en":"They will be reclining on thrones lined up, and We will marry them to fair women with large, [beautiful] eyes.","w":[{"ar":"مُتَّكِـِٔينَ","tr":"muttakiīna","en":"Reclining","root":"وكأ","lem":"مُتَّكِئ"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"on"},{"ar":"سُرُرٍۢ","tr":"sururin","en":"thrones","root":"سرر","lem":"سُرُر"},{"ar":"مَّصْفُوفَةٍۢ ۖ","tr":"maṣfūfatin","en":"lined up","root":"صفف","lem":"مَصْفُوفَة"},{"ar":"وَزَوَّجْنَـٰهُم","tr":"wazawwajnāhum","en":"and We will marry them","root":"زوج","lem":"زُوِّجَتْ"},{"ar":"بِحُورٍ","tr":"biḥūrin","en":"to fair ones","root":"حور","lem":"حُور"},{"ar":"عِينٍۢ","tr":"ʿīnin","en":"(with) large eyes","root":"عين","lem":"عِين"}]},{"n":21,"juz":27,"ar":"وَٱلَّذِينَ ءَامَنُوا۟ وَٱتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَـٰنٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَآ أَلَتْنَـٰهُم مِّنْ عَمَلِهِم مِّن شَىْءٍ ۚ كُلُّ ٱمْرِئٍۭ بِمَا كَسَبَ رَهِينٌ","en":"And those who believed and whose descendants followed them in faith - We will join with them their descendants, and We will not deprive them of anything of their deeds. Every person, for what he earned, is retained.","w":[{"ar":"وَٱلَّذِينَ","tr":"wa-alladhīna","en":"And those who"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"believed","root":"أمن","lem":"آمَنَ"},{"ar":"وَٱتَّبَعَتْهُمْ","tr":"wa-ittabaʿathum","en":"and followed them","root":"تبع","lem":"اتَّبَعَ"},{"ar":"ذُرِّيَّتُهُم","tr":"dhurriyyatuhum","en":"their offspring","root":"ذرر","lem":"ذُرِّيَّة"},{"ar":"بِإِيمَـٰنٍ","tr":"biīmānin","en":"in faith","root":"أمن","lem":"إِيمان"},{"ar":"أَلْحَقْنَا","tr":"alḥaqnā","en":"We will join","root":"لحق","lem":"أَلْحَقْ"},{"ar":"بِهِمْ","tr":"bihim","en":"with them"},{"ar":"ذُرِّيَّتَهُمْ","tr":"dhurriyyatahum","en":"their offspring","root":"ذرر","lem":"ذُرِّيَّة"},{"ar":"وَمَآ","tr":"wamā","en":"and not"},{"ar":"أَلَتْنَـٰهُم","tr":"alatnāhum","en":"We will deprive them","root":"ألت","lem":"أَلَتْ"},{"ar":"مِّنْ","tr":"min","en":"of"},{"ar":"عَمَلِهِم","tr":"ʿamalihim","en":"their deeds","root":"عمل","lem":"عَمَل"},{"ar":"مِّن","tr":"min","en":"(in) any"},{"ar":"شَىْءٍۢ ۚ","tr":"shayin","en":"thing","root":"شيأ","lem":"شَىْء"},{"ar":"كُلُّ","tr":"kullu","en":"Every","root":"كلل","lem":"كُلّ"},{"ar":"ٱمْرِئٍۭ","tr":"im'ri-in","en":"person","root":"مرأ","lem":"امْرِئ"},{"ar":"بِمَا","tr":"bimā","en":"for what"},{"ar":"كَسَبَ","tr":"kasaba","en":"he earned","root":"كسب","lem":"كَسَبَ"},{"ar":"رَهِينٌۭ","tr":"rahīnun","en":"(is) pledged","root":"رهن","lem":"رَهِين"}]},{"n":22,"juz":27,"ar":"وَأَمْدَدْنَـٰهُم بِفَـٰكِهَةٍ وَلَحْمٍ مِّمَّا يَشْتَهُونَ","en":"And We will provide them with fruit and meat from whatever they desire.","w":[{"ar":"وَأَمْدَدْنَـٰهُم","tr":"wa-amdadnāhum","en":"And We will provide them","root":"مدد","lem":"أَمَدَّ"},{"ar":"بِفَـٰكِهَةٍۢ","tr":"bifākihatin","en":"with fruit","root":"فكه","lem":"فاكِهَة"},{"ar":"وَلَحْمٍۢ","tr":"walaḥmin","en":"and meat","root":"لحم","lem":"لَحْم"},{"ar":"مِّمَّا","tr":"mimmā","en":"from what"},{"ar":"يَشْتَهُونَ","tr":"yashtahūna","en":"they desire","root":"شهو","lem":"اشْتَهَتْ"}]},{"n":23,"juz":27,"ar":"يَتَنَـٰزَعُونَ فِيهَا كَأْسًا لَّا لَغْوٌ فِيهَا وَلَا تَأْثِيمٌ","en":"They will exchange with one another a cup [of wine] wherein [results] no ill speech or commission of sin.","w":[{"ar":"يَتَنَـٰزَعُونَ","tr":"yatanāzaʿūna","en":"They will pass to one another","root":"نزع","lem":"تَنازَعُ"},{"ar":"فِيهَا","tr":"fīhā","en":"therein"},{"ar":"كَأْسًۭ