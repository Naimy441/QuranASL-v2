{"n":96,"name":"Al-'Alaq","nameAr":"العلق","meaning":"The Clot","ayahs":19,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","en":"Recite in the name of your Lord who created","w":[{"ar":"ٱقْرَأْ","tr":"iq'ra","en":"Read","root":"قرأ","lem":"قَرَأَ"},{"ar":"بِٱسْمِ","tr":"bi-is'mi","en":"in (the) name","root":"سمو","lem":"اسْم"},{"ar":"رَبِّكَ","tr":"rabbika","en":"(of) your Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلَّذِى","tr":"alladhī","en":"the One Who"},{"ar":"خَلَقَ","tr":"khalaqa","en":"created ","root":"خلق","lem":"خَلَقَ"}]},{"n":2,"juz":30,"ar":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","en":"Created man from a clinging substance.","w":[{"ar":"خَلَقَ","tr":"khalaqa","en":"He created","root":"خلق","lem":"خَلَقَ"},{"ar":"ٱلْإِنسَـٰنَ","tr":"l-insāna","en":"man","root":"أنس","lem":"إِنسان"},{"ar":"مِنْ","tr":"min","en":"from"},{"ar":"عَلَقٍ","tr":"ʿalaqin","en":"a clinging substance","root":"علق","lem":"عَلَق"}]},{"n":3,"juz":30,"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","en":"Recite, and your Lord is the most Generous -","w":[{"ar":"ٱقْرَأْ","tr":"iq'ra","en":"Read","root":"قرأ","lem":"قَرَأَ"},{"ar":"وَرَبُّكَ","tr":"warabbuka","en":"and your Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلْأَكْرَمُ","tr":"l-akramu","en":"(is) the Most Generous","root":"كرم","lem":"أَكْرَم"}]},{"n":4,"juz":30,"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","en":"Who taught by the pen","w":[{"ar":"ٱلَّذِى","tr":"alladhī","en":"The One Who"},{"ar":"عَلَّمَ","tr":"ʿallama","en":"taught","root":"علم","lem":"عَلَّمَ"},{"ar":"بِٱلْقَلَمِ","tr":"bil-qalami","en":"by the pen","root":"قلم","lem":"قَلَم"}]},{"n":5,"juz":30,"ar":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","en":"Taught man that which he knew not.","w":[{"ar":"عَلَّمَ","tr":"ʿallama","en":"Taught","root":"علم","lem":"عَلَّمَ"},{"ar":"ٱلْإِنسَـٰنَ","tr":"l-insāna","en":"man","root":"أنس","lem":"إِنسان"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"لَمْ","tr":"lam","en":"not"},{"ar":"يَعْلَمْ","tr":"yaʿlam","en":"he knew","root":"علم","lem":"عَلِمَ"}]},{"n":6,"juz":30,"ar":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","en":"No! [But] indeed, man transgresses","w":[{"ar":"كَلَّآ","tr":"kallā","en":"Nay"},{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱلْإِنسَـٰنَ","tr":"l-insāna","en":"man","root":"أنس","lem":"إِنسان"},{"ar":"لَيَطْغَىٰٓ","tr":"layaṭghā","en":"surely transgresses","root":"طغي","lem":"طَغَى"}]},{"n":7,"juz":30,"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","en":"Because he sees himself self-sufficient.","w":[{"ar":"أَن","tr":"an","en":"That"},{"ar":"رَّءَاهُ","tr":"raāhu","en":"he sees himself","root":"رأي","lem":"رَأَى"},{"ar":"ٱسْتَغْنَىٰٓ","tr":"is'taghnā","en":"self-sufficient","root":"غني","lem":"اسْتَغْنَى"}]},{"n":8,"juz":30,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","en":"Indeed, to your Lord is the return.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"إِلَىٰ","tr":"ilā","en":"to"},{"ar":"رَبِّكَ","tr":"rabbika","en":"your Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلرُّجْعَىٰٓ","tr":"l-ruj'ʿā","en":"(is) the return","root":"رجع","lem":"رُجْعَى"}]},{"n":9,"juz":30,"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","en":"Have you seen the one who forbids","w":[{"ar":"أَرَءَيْتَ","tr":"ara-ayta","en":"Have you seen","root":"رأي","lem":"رَأَى"},{"ar":"ٱلَّذِى","tr":"alladhī","en":"the one who"},{"ar":"يَنْهَىٰ","tr":"yanhā","en":"forbids","root":"نهي","lem":"نَهَى"}]},{"n":10,"juz":30,"ar":"عَبْدًا إِذَا صَلَّىٰٓ","en":"A servant when he prays?","w":[{"ar":"عَبْدًا","tr":"ʿabdan","en":"A slave","root":"عبد","lem":"عَبْد"},{"ar":"إِذَا","tr":"idhā","en":"when"},{"ar":"صَلَّىٰٓ","tr":"ṣallā","en":"he prays","root":"صلو","lem":"صَلَّى"}]},{"n":11,"juz":30,"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","en":"Have you seen if he is upon guidance","w":[{"ar":"أَرَءَيْتَ","tr":"ara-ayta","en":"Have you seen","root":"رأي","lem":"رَأَى"},{"ar":"إِن","tr":"in","en":"if"},{"ar":"كَانَ","tr":"kāna","en":"he is","root":"كون","lem":"كانَ"},{"ar":"عَلَى","tr":"ʿalā","en":"upon"},{"ar":"ٱلْهُدَىٰٓ","tr":"l-hudā","en":"[the] guidance","root":"هدي","lem":"هُدًى"}]},{"n":12,"juz":30,"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","en":"Or enjoins righteousness?","w":[{"ar":"أَوْ","tr":"aw","en":"Or"},{"ar":"أَمَرَ","tr":"amara","en":"he enjoins","root":"أمر","lem":"أَمَرَ"},{"ar":"بِٱلتَّقْوَىٰٓ","tr":"bil-taqwā","en":"[of the] righteousness","root":"وقي","lem":"تَقْوَى"}]},{"n":13,"juz":30,"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","en":"Have you seen if he denies and turns away -","w":[{"ar":"أَرَءَيْتَ","tr":"ara-ayta","en":"Have you seen","root":"رأي","lem":"رَأَى"},{"ar":"إِن","tr":"in","en":"if"},{"ar":"كَذَّبَ","tr":"kadhaba","en":"he denies","root":"كذب","lem":"كَذَّبَ"},{"ar":"وَتَوَلَّىٰٓ","tr":"watawallā","en":"and turns away","root":"ولي","lem":"تَوَلَّى"}]},{"n":14,"juz":30,"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","en":"Does he not know that Allāh sees?","w":[{"ar":"أَلَمْ","tr":"alam","en":"Does not"},{"ar":"يَعْلَم","tr":"yaʿlam","en":"he know","root":"علم","lem":"عَلِمَ"},{"ar":"بِأَنَّ","tr":"bi-anna","en":"that"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"يَرَىٰ","tr":"yarā","en":"sees","root":"رأي","lem":"رَأَى"}]},{"n":15,"juz":30,"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","en":"No! If he does not desist, We will surely drag him by the forelock","w":[{"ar":"كَلَّا","tr":"kallā","en":"Nay"},{"ar":"لَئِن","tr":"la-in","en":"If"},{"ar":"لَّمْ","tr":"lam","en":"not"},{"ar":"يَنتَهِ","tr":"yantahi","en":"he desists","root":"نهي","lem":"انتَهَى"},{"ar":"لَنَسْفَعًۢا","tr":"lanasfaʿan","en":"surely We will drag him","root":"سفع","lem":"نَسْفَعًۢ"},{"ar":"بِٱلنَّاصِيَةِ","tr":"bil-nāṣiyati","en":"by the forelock","root":"نصي","lem":"ناصِيَة"}]},{"n":16,"juz":30,"ar":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ","en":"A lying, sinning forelock.","w":[{"ar":"نَاصِيَةٍۢ","tr":"nāṣiyatin","en":"A forelock","root":"نصي","lem":"ناصِيَة"},{"ar":"كَـٰذِبَةٍ","tr":"kādhibatin","en":"lying","root":"كذب","lem":"كاذِب"},{"ar":"خَ