":"قَوْم"},{"ar":"ءَاخَرِينَ","tr":"ākharīna","en":"another","root":"أخر","lem":"آخَر"}]},{"n":29,"juz":25,"ar":"فَمَا بَكَتْ عَلَيْهِمُ ٱلسَّمَآءُ وَٱلْأَرْضُ وَمَا كَانُوا۟ مُنظَرِينَ","en":"And the heaven and earth wept not for them, nor were they reprieved.","w":[{"ar":"فَمَا","tr":"famā","en":"And not"},{"ar":"بَكَتْ","tr":"bakat","en":"wept","root":"بكي","lem":"بَكَتْ"},{"ar":"عَلَيْهِمُ","tr":"ʿalayhimu","en":"for them"},{"ar":"ٱلسَّمَآءُ","tr":"l-samāu","en":"the heaven","root":"سمو","lem":"سَماء"},{"ar":"وَٱلْأَرْضُ","tr":"wal-arḍu","en":"and the earth","root":"أرض","lem":"أَرْض"},{"ar":"وَمَا","tr":"wamā","en":"and not"},{"ar":"كَانُوا۟","tr":"kānū","en":"they were","root":"كون","lem":"كانَ"},{"ar":"مُنظَرِينَ","tr":"munẓarīna","en":"given respite","root":"نظر","lem":"مُنظَر"}]},{"n":30,"juz":25,"ar":"وَلَقَدْ نَجَّيْنَا بَنِىٓ إِسْرَٰٓءِيلَ مِنَ ٱلْعَذَابِ ٱلْمُهِينِ","en":"And We certainly saved the Children of Israel from the humiliating torment -","w":[{"ar":"وَلَقَدْ","tr":"walaqad","en":"And certainly"},{"ar":"نَجَّيْنَا","tr":"najjaynā","en":"We saved","root":"نجو","lem":"نَجَّى"},{"ar":"بَنِىٓ","tr":"banī","en":"(the) Children of Israel","root":"بني","lem":"بُنَىّ"},{"ar":"إِسْرَٰٓءِيلَ","tr":"is'rāīla","en":"(the) Children of Israel"},{"ar":"مِنَ","tr":"mina","en":"from"},{"ar":"ٱلْعَذَابِ","tr":"l-ʿadhābi","en":"the punishment","root":"عذب","lem":"عَذاب"},{"ar":"ٱلْمُهِينِ","tr":"l-muhīni","en":"the humiliating","root":"هون","lem":"مُهِين"}]},{"n":31,"juz":25,"ar":"مِن فِرْعَوْنَ ۚ إِنَّهُۥ كَانَ عَالِيًا مِّنَ ٱلْمُسْرِفِينَ","en":"From Pharaoh. Indeed, he was a haughty one among the transgressors.","w":[{"ar":"مِن","tr":"min","en":"From"},{"ar":"فِرْعَوْنَ ۚ","tr":"fir'ʿawna","en":"Firaun"},{"ar":"إِنَّهُۥ","tr":"innahu","en":"Indeed, he"},{"ar":"كَانَ","tr":"kāna","en":"was","root":"كون","lem":"كانَ"},{"ar":"عَالِيًۭا","tr":"ʿāliyan","en":"arrogant","root":"علو","lem":"عالِي"},{"ar":"مِّنَ","tr":"mina","en":"among"},{"ar":"ٱلْمُسْرِفِينَ","t