},{"ar":"كَرِيمٌ","tr":"karīmun","en":"noble","root":"كرم","lem":"كَرِيم"}]},{"n":18,"juz":25,"ar":"أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِ ۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌ","en":"[Saying], \"Render to me the servants of Allāh. Indeed, I am to you a trustworthy messenger,\"","w":[{"ar":"أَنْ","tr":"an","en":"That"},{"ar":"أَدُّوٓا۟","tr":"addū","en":"Deliver","root":"أدي","lem":"يُؤَدِّ"},{"ar":"إِلَىَّ","tr":"ilayya","en":"to me"},{"ar":"عِبَادَ","tr":"ʿibāda","en":"(the) servants","root":"عبد","lem":"عَبْد"},{"ar":"ٱللَّهِ ۖ","tr":"l-lahi","en":"(of) Allah","root":"أله","lem":"اللَّه"},{"ar":"إِنِّى","tr":"innī","en":"Indeed, I am"},{"ar":"لَكُمْ","tr":"lakum","en":"to you"},{"ar":"رَسُولٌ","tr":"rasūlun","en":"a Messenger","root":"رسل","lem":"رَسُول"},{"ar":"أَمِينٌۭ","tr":"amīnun","en":"trustworthy","root":"أمن","lem":"أَمِين"}]},{"n":19,"juz":25,"ar":"وَأَن لَّا تَعْلُوا۟ عَلَى ٱللَّهِ ۖ إِنِّىٓ ءَاتِيكُم بِسُلْطَـٰنٍ مُّبِينٍ","en":"And [saying], \"Be not haughty with Allāh. Indeed, I have come to you with clear evidence.","w":[{"ar":"وَأَن","tr":"wa-an","en":"And that"},{"ar":"لَّا","tr":"lā","en":"(do) not"},{"ar":"تَعْلُوا۟","tr":"taʿlū","en":"exalt yourselves","root":"علو","lem":"عَلا"},{"ar":"عَلَى","tr":"ʿalā","en":"against"},{"ar":"ٱللَّهِ ۖ","tr":"l-lahi","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"إِنِّىٓ","tr":"innī","en":"Indeed, I"},{"ar":"ءَاتِيكُم","tr":"ātīkum","en":"[I] have come to you","root":"أتي","lem":"أَتَى"},{"ar":"بِسُلْطَـٰنٍۢ","tr":"bisul'ṭānin","en":"with an authority","root":"سلط","lem":"سُلْطان"},{"ar":"مُّبِينٍۢ","tr":"mubīnin","en":"clear","root":"بين","lem":"مُبِين"}]},{"n":20,"juz":25,"ar":"وَإِنِّى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَن تَرْجُمُونِ","en":"And indeed, I have sought refuge in my Lord and your Lord, lest you stone me.","w":[{"ar":"وَإِنِّى","tr":"wa-innī","en":"And indeed, I"},{"ar":"عُذْتُ","tr":"ʿudh'tu","en":"[I] seek refuge","root":"عوذ","lem":"عُذْ"},{"ar":"بِرَبِّى","tr":"birabbī","en":"with my Lord","root":"رب