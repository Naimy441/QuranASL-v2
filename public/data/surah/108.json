{"n":108,"name":"Al-Kawthar","nameAr":"الكوثر","meaning":"The Abundance","ayahs":3,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ","en":"Indeed, We have granted you, [O Muḥammad], al-Kawthar.","w":[{"ar":"إِنَّآ","tr":"innā","en":"Indeed, We"},{"ar":"أَعْطَيْنَـٰكَ","tr":"aʿṭaynāka","en":"We have given you","root":"عطو","lem":"أَعْطَى"},{"ar":"ٱلْكَوْثَرَ","tr":"l-kawthara","en":"Al-Kauthar","root":"كثر","lem":"كَوْثَر"}]},{"n":2,"juz":30,"ar":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","en":"So pray to your Lord and offer sacrifice [to Him alone].","w":[{"ar":"فَصَلِّ","tr":"faṣalli","en":"So pray","root":"صلو","lem":"صَلَّى"},{"ar":"لِرَبِّكَ","tr":"lirabbika","en":"to your Lord","root":"ربب","lem":"رَبّ"},{"ar":"وَٱنْحَرْ","tr":"wa-in'ḥar","en":"and sacrifice","root":"نحر","lem":"انْحَرْ"}]},{"n":3,"juz":30,"ar":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","en":"Indeed, your enemy is the one cut off.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"شَانِئَكَ","tr":"shāni-aka","en":"your enemy ","root":"شنأ","lem":"شانِئ"},{"ar":"هُوَ","tr":"huwa","en":"he (is)"},{"ar":"ٱلْأَبْتَرُ","tr":"l-abtaru","en":"the one cut off","root":"بتر","lem":"أَبْتَر"}]}]}