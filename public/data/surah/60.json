","en":"Our Lord","root":"ربب","lem":"رَبّ"},{"ar":"لَا","tr":"lā","en":"(do) not"},{"ar":"تَجْعَلْنَا","tr":"tajʿalnā","en":"make us","root":"جعل","lem":"جَعَلَ"},{"ar":"فِتْنَةًۭ","tr":"fit'natan","en":"a trial","root":"فتن","lem":"فِتْنَة"},{"ar":"لِّلَّذِينَ","tr":"lilladhīna","en":"for those who"},{"ar":"كَفَرُوا۟","tr":"kafarū","en":"disbelieve","root":"كفر","lem":"كَفَرَ"},{"ar":"وَٱغْفِرْ","tr":"wa-igh'fir","en":"and forgive","root":"غفر","lem":"غَفَرَ"},{"ar":"لَنَا","tr":"lanā","en":"us"},{"ar":"رَبَّنَآ ۖ","tr":"rabbanā","en":"our Lord","root":"ربب","lem":"رَبّ"},{"ar":"إِنَّكَ","tr":"innaka","en":"Indeed You"},{"ar":"أَنتَ","tr":"anta","en":"[You]"},{"ar":"ٱلْعَزِيزُ","tr":"l-ʿazīzu","en":"(are) the All-Mighty","root":"عزز","lem":"عَزِيز"},{"ar":"ٱلْحَكِيمُ","tr":"l-ḥakīmu","en":"the All-Wise","root":"حكم","lem":"حَكِيم"}]},{"n":6,"juz":28,"ar":"لَقَدْ كَانَ لَكُمْ فِيهِمْ أُسْوَةٌ حَسَنَةٌ لِّمَن كَانَ يَرْجُوا۟ ٱللَّهَ وَٱلْيَوْمَ ٱلْـَٔاخِرَ ۚ وَمَن يَتَوَلَّ فَإِنَّ ٱللَّهَ هُوَ ٱلْغَنِىُّ ٱلْحَمِيدُ","en":"There has certainly been for you in them an excellent pattern for anyone whose hope is in Allāh and the Last Day. And whoever turns away - then indeed, Allāh is the Free of need, the Praiseworthy.","w":[{"ar":"لَقَدْ","tr":"laqad","en":"Certainly"},{"ar":"كَانَ","tr":"kāna","en":"(there) is","root":"كون","lem":"كانَ"},{"ar":"لَكُمْ","tr":"lakum","en":"for you"},{"ar":"فِيهِمْ","tr":"fīhim","en":"in them"},{"ar":"أُسْوَةٌ","tr":"us'watun","en":"an example","root":"أسو","lem":"أُسْوَة"},{"ar":"حَسَنَةٌۭ","tr":"ḥasanatun","en":"good","root":"حسن","lem":"حَسَنَة"},{"ar":"لِّمَن","tr":"liman","en":"for (he) who"},{"ar":"كَانَ","tr":"kāna","en":"is","root":"كون","lem":"كانَ"},{"ar":"يَرْجُوا۟","tr":"yarjū","en":"hopeful","root":"رجو","lem":"يَرْجُوا۟"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"(in) Allah","root":"أله","lem":"اللَّه"},{"ar":"وَٱلْيَوْمَ","tr":"wal-yawma","en":"and the Day","root":"يوم","lem":"يَوْم"},{"ar":"ٱلْـَٔاخِرَ ۚ","tr":"l-ākhira","en":"the Last","root":"أخر","lem":"آخِر"},{"ar":"وَمَن","tr":"waman","en":"And whoever"},{"ar":"يَتَوَلَّ","tr":"yatawalla","en":"turns away","root":"ولي","lem":"تَوَلَّى"},{"ar":"فَإِنَّ","tr":"fa-inna","en":"then indeed"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"هُوَ","tr":"huwa","en":"He"},{"ar":"ٱلْغَنِىُّ","tr":"l-ghaniyu","en":"(is) Free of need","root":"غني","lem":"غَنِيّ"},{"ar":"ٱلْحَمِيدُ","tr":"l-ḥamīdu","en":"the Praiseworthy","root":"حمد","lem":"حَمِيد"}]},{"n":7,"juz":28,"ar":"۞ عَسَى ٱللَّهُ أَن يَجْعَلَ بَيْنَكُمْ وَبَيْنَ ٱلَّذِينَ عَادَيْتُم مِّنْهُم مَّوَدَّةً ۚ وَٱللَّهُ قَدِيرٌ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ","en":"Perhaps Allāh will put, between you and those to whom you have been enemies among them, affection. And Allāh is competent, and Allāh is Forgiving and Merciful.","w":[{"ar":"۞ عَسَى","tr":"ʿasā","en":"Perhaps","root":"عسي","lem":"عَسَى"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"أَن","tr":"an","en":"[that]"},{"ar":"يَجْعَلَ","tr":"yajʿala","en":"will put","root":"جعل","lem":"جَعَلَ"},{"ar":"بَيْنَكُمْ","tr":"baynakum","en":"between you","root":"بين","lem":"بَيْن"},{"ar":"وَبَيْنَ","tr":"wabayna","en":"and between","root":"بين","lem":"بَيْن"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those (to) whom"},{"ar":"عَادَيْتُم","tr":"ʿādaytum","en":"you have been enemies","root":"عدو","lem":"عادَيْ"},{"ar":"مِّنْهُم","tr":"min'hum","en":"among them"},{"ar":"مَّوَدَّةًۭ ۚ","tr":"mawaddatan","en":"love","root":"ودد","lem":"مَوَدَّة"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"قَدِيرٌۭ ۚ","tr":"qadīrun","en":"(is) All-Powerful","root":"قدر","lem":"قَدِير"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"غَفُورٌۭ","tr":"ghafūrun","en":"(is) Oft-Forgiving","root":"غفر","lem":"غَفُور"},{"ar":"رَّحِيمٌۭ","tr":"raḥīmun","en":"Most Merciful","root":"رحم","lem":"رَحِيم"}]},{"n":8,"juz":28,"ar":"لَّا يَنْهَىٰكُمُ ٱللَّهُ عَنِ ٱلَّذِينَ لَمْ يُقَـٰتِلُوكُمْ فِى ٱلدِّينِ وَلَمْ يُخْرِجُوكُم مِّن دِيَـٰرِكُمْ أَن تَبَرُّوهُمْ وَتُقْسِطُوٓا۟ إِلَيْهِمْ ۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُقْسِطِينَ","en":"Allāh does not forbid you from those who do not fight you because of religion and do not expel you from your homes - from being righteous toward them and acting justly toward them. Indeed, Allāh loves those who act justly.","w":[{"ar":"لَّا","tr":"lā","en":"Not"},{"ar":"يَنْهَىٰكُمُ","tr":"yanhākumu","en":"(does) forbid you","root":"نهي","lem":"نَهَى"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"عَنِ","tr":"ʿani","en":"from"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"لَمْ","tr":"lam","en":"(do) not"},{"ar":"يُقَـٰتِلُوكُمْ","tr":"yuqātilūkum","en":"fight you","root":"قتل","lem":"قاتَلَ"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"ٱلدِّينِ","tr":"l-dīni","en":"the religion","root":"دين","lem":"دِين"},{"ar":"وَلَمْ","tr":"walam","en":"and (do) not"},{"ar":"يُخْرِجُوكُم","tr":"yukh'rijūkum","en":"drive you out","root":"خرج","lem":"أَخْرَجَ"},{"ar":"مِّن","tr":"min","en":"of"},{"ar":"دِيَـٰرِكُمْ","tr":"diyārikum","en":"your homes","root":"دور","lem":"دار"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"تَبَرُّوهُمْ","tr":"tabarrūhum","en":"you deal kindly","root":"برر","lem":"تَبَرُّ"},{"ar":"وَتُقْسِطُوٓا۟","tr":"watuq'siṭū","en":"and deal justly","root":"قسط","lem":"تُقْسِطُ"},{"ar":"إِلَيْهِمْ ۚ","tr":"ilayhim","en":"with them"},{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"يُحِبُّ","tr":"yuḥibbu","en":"loves","root":"حبب","lem":"أَحْبَبْ"},{"ar":"ٱلْمُقْسِطِينَ","tr":"l-muq'siṭīna","en":"those who act justly","root":"قسط","lem":"مُقْسِط"}]},{"n":9,"juz":28,"ar":"إِنَّمَا يَنْهَىٰكُمُ ٱللَّهُ عَنِ ٱلَّذِينَ قَـٰتَلُوكُمْ فِى ٱلدِّينِ وَأَخْرَجُوكُم مِّن دِيَـٰرِكُمْ وَظَـٰهَرُوا۟ عَلَىٰٓ إِخْرَاجِكُمْ أَن تَوَلَّوْهُمْ ۚ وَمَن يَتَوَلَّهُمْ فَأُو۟لَـٰٓئِكَ هُمُ ٱلظَّـٰلِمُونَ","en":"Allāh only forbids you from those who fight you because of religion and expel you from your homes and aid in your expulsion - [forbids] that you make allies of them. And whoever makes allies of them, then it is those who are the wrongdoers.","w":[{"ar":"إِنَّمَا","tr":"innamā","en":"Only"},{"ar":"يَنْهَىٰكُمُ","tr":"yanhākumu","en":"forbids you","root":"نهي","lem":"نَهَى"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"عَنِ","tr":"ʿani","en":"from"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"قَـٰتَلُوكُمْ","tr":"qātalūkum","en":"fight you","root":"قتل","lem":"قاتَلَ"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"ٱلدِّينِ","tr":"l-dīni","en":"the religion","root":"دين","lem":"دِين"},{"ar":"وَأَخْرَجُوكُم","tr":"wa-akhrajūkum","en":"and drive you out","root":"خرج","lem":"أَخْرَجَ"},{"ar":"مِّن","tr":"min","en":"of"},{"ar":"دِيَـٰرِكُمْ","tr":"diyārikum","en":"your homes","root":"دور","lem":"دار"},{"ar":"وَظَـٰهَرُوا۟","tr":"waẓāharū","en":"and support","root":"ظهر","lem":"ظاهَرُ"},{"ar":"عَلَىٰٓ","tr":"ʿalā","en":"in"},{"ar":"إِخْرَاجِكُمْ","tr":"ikh'rājikum","en":"your expulsion","root":"خرج","lem":"إِخْراج"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"تَوَلَّوْهُمْ ۚ","tr":"tawallawhum","en":"you make them allies","root":"ولي","lem":"تَوَلَّى"},{"ar":"وَمَن","tr":"waman","en":"And whoever"},{"ar":"يَتَوَلَّهُمْ","tr":"yatawallahum","en":"makes them allies","root":"ولي","lem":"تَوَلَّى"},{"ar":"فَأُو۟لَـٰٓئِكَ","tr":"fa-ulāika","en":"then those"},{"ar":"هُمُ","tr":"humu","en":"[they]"},{"ar":"ٱلظَّـٰلِمُونَ","tr":"l-ẓālimūna","en":"(are) the wrongdoers","root":"ظلم","lem":"ظالِم"}]},{"n":10,"juz":28,"ar":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا جَآءَكُمُ ٱلْمُؤْمِنَـٰتُ مُهَـٰجِرَٰتٍ فَٱمْتَحِنُوهُنَّ ۖ ٱللَّهُ أَعْلَمُ بِإِيمَـٰنِهِنَّ ۖ فَإِنْ عَلِمْتُمُوهُنَّ مُؤْمِنَـٰتٍ فَلَا تَرْجِعُوهُنَّ إِلَى ٱلْكُفَّارِ ۖ لَا هُنَّ حِلٌّ لَّهُمْ وَلَا هُمْ يَحِلُّونَ لَهُنَّ ۖ وَءَاتُوهُم مَّآ أَنفَقُوا۟ ۚ وَلَا جُنَاحَ عَلَيْكُمْ أَن تَنكِحُوهُنَّ إِذَآ ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّ ۚ وَلَا تُمْسِكُوا۟ بِعِصَمِ ٱلْكَوَافِرِ وَسْـَٔلُوا۟ مَآ أَنفَقْتُمْ وَلْيَسْـَٔلُوا۟ مَآ أَنفَقُوا۟ ۚ ذَٰلِكُمْ حُكْمُ ٱللَّهِ ۖ يَحْكُمُ بَيْنَكُمْ ۚ وَٱللَّهُ عَلِيمٌ حَكِيمٌ","en":"O you who have believed, when the believing women come to you as emigrants, examine [i.e., test] them. Allāh is most knowing as to their faith. And if you know them to be believers, then do not return them to the disbelievers; they are not lawful [wives] for them, nor are they lawful [husbands] for them. But give them [i.e., the disbelievers] what they have spent. And there is no blame upon you if you marry them when you have given them their due compensation [i.e., mahr]. And hold not to marriage bonds with disbelieving women, but ask for what you have spent and let them [i.e., the disbelievers] ask for what they have spent. That is the judgement of Allāh; He judges between you. And Allāh is Knowing and Wise.","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O you","root":"أيي","lem":"أَيّ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"who"},{"ar":"ءَامَنُوٓا۟","tr":"āmanū","en":"believe","root":"أمن","lem":"آمَنَ"},{"ar":"إِذَا","tr":"idhā","en":"When"},{"ar":"جَآءَكُمُ","tr":"jāakumu","en":"come to you","root":"جيأ","lem":"جاءَ"},{"ar":"ٱلْمُؤْمِنَـٰتُ","tr":"l-mu'minātu","en":"the believing women","root":"أمن","lem":"مُؤْمِنَة"},{"ar":"مُهَـٰجِرَٰتٍۢ","tr":"muhājirātin","en":"(as) emigrants","root":"هجر","lem":"مُهاجِرَة"},{"ar":"فَٱمْتَحِنُوهُنَّ ۖ","tr":"fa-im'taḥinūhunna","en":"then examine them","root":"محن","lem":"امْتَحَنَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"أَعْلَمُ","tr":"aʿlamu","en":"(is) most knowing","root":"علم","lem":"أَعْلَم"},{"ar":"بِإِيمَـٰنِهِنَّ ۖ","tr":"biīmānihinna","en":"of their faith","root":"أمن","lem":"إِيمان"},{"ar":"فَإِنْ","tr":"fa-in","en":"And if"},{"ar":"عَلِمْتُمُوهُنَّ","tr":"ʿalim'tumūhunna","en":"you know them","root":