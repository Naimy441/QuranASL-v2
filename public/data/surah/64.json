{"n":64,"name":"At-Taghabun","nameAr":"التغابن","meaning":"The Mutual Disillusion","ayahs":18,"place":"madinah","bismillah":true,"ayat":[{"n":1,"juz":28,"ar":"يُسَبِّحُ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۖ لَهُ ٱلْمُلْكُ وَلَهُ ٱلْحَمْدُ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","en":"Whatever is in the heavens and whatever is on the earth is exalting Allāh. To Him belongs dominion, and to Him belongs [all] praise, and He is over all things competent.","w":[{"ar":"يُسَبِّحُ","tr":"yusabbiḥu","en":"Glorifies","root":"سبح","lem":"سَبَّحَ"},{"ar":"لِلَّهِ","tr":"lillahi","en":"[to] Allah","root":"أله","lem":"اللَّه"},{"ar":"مَا","tr":"mā","en":"whatever"},{"ar":"فِى","tr":"fī","en":"(is) in"},{"ar":"ٱلسَّمَـٰوَٰتِ","tr":"l-samāwāti","en":"the heavens","root":"سمو","lem":"سَماء"},{"ar":"وَمَا","tr":"wamā","en":"and whatever"},{"ar":"فِى","tr":"fī","en":"(is) in"},{"ar":"ٱلْأَرْضِ ۖ","tr":"l-arḍi","en":"the earth","root":"أرض","lem":"أَرْض"},{"ar":"لَهُ","tr":"lahu","en":"For Him"},{"ar":"ٱلْمُلْكُ","tr":"l-mul'ku","en":"(is the) dominion","root":"ملك","lem":"مُلْك"},{"ar":"وَلَهُ","tr":"walahu","en":"and for Him"},{"ar":"ٱلْحَمْدُ ۖ","tr":"l-ḥamdu","en":"(is) the praise","root":"حمد","lem":"حَمْد"},{"ar":"وَهُوَ","tr":"wahuwa","en":"And He"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"(is) on"},{"ar":"كُلِّ","tr":"kulli","en":"every","root":"كلل","lem":"كُلّ"},{"ar":"شَىْءٍۢ","tr":"shayin","en":"thing","root":"شيأ","lem":"شَىْء"},{"ar":"قَدِيرٌ","tr":"qadīrun","en":"All-Powerful","root":"قدر","lem":"قَدِير"}]},{"n":2,"juz":28,"ar":"هُوَ ٱلَّذِى خَلَقَكُمْ فَمِنكُمْ كَافِرٌ وَمِنكُم مُّؤْمِنٌ ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","en":"It is He who created you, and among you is the disbeliever, and among you is the believer. And Allāh, of what you do, is Seeing.","w":[{"ar":"هُوَ","tr":"huwa","en":"He"},{"ar":"ٱلَّذِى","tr":"alladhī","en":"(is) the One Who"},{"ar":"خَلَقَكُمْ","tr":"khalaqakum","en":"created you","root":"خلق","lem":"خَلَقَ"},{"ar":"فَمِنكُمْ","tr":"faminkum","en":"and among you"},{"ar":"كَافِرٌۭ","tr":"kāfirun","en":"(is) a disbeliever","root":"كفر","lem":"كافِر"},{"ar":"وَمِنكُم","tr":"waminkum","en":"and among you"},{"ar":"مُّؤْمِنٌۭ ۚ","tr":"mu'minun","en":"(is) a believer","root":"أمن","lem":"مُؤْمِن"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"بِمَا","tr":"bimā","en":"of what"},{"ar":"تَعْمَلُونَ","tr":"taʿmalūna","en":"you do","root":"عمل","lem":"عَمِلَ"},{"ar":"بَصِيرٌ","tr":"baṣīrun","en":"(is) All-Seer","root":"بصر","lem":"بَصِير"}]},{"n":3,"juz":28,"ar":"خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ ۖ وَإِلَيْهِ ٱلْمَصِيرُ","en":"He created the heavens and earth in truth and formed you and perfected your forms; and to Him is the [final] destination.","w":[{"ar":"خَلَقَ","tr":"khalaqa","en":"He created","root":"خلق","lem":"خَلَقَ"},{"ar":"ٱلسَّمَـٰوَٰتِ","tr":"l-samāwāti","en":"the heavens","root":"سمو","lem":"سَماء"},{"ar":"وَٱلْأَرْضَ","tr":"wal-arḍa","en":"and the earth","root":"أرض","lem":"أَرْض"},{"ar":"بِٱلْحَقِّ","tr":"bil-ḥaqi","en":"with truth","root":"حقق","lem":"حَقّ"},{"ar":"وَصَوَّرَكُمْ","tr":"waṣawwarakum","en":"and He formed you","root":"صور","lem":"صَوَّرَ"},{"ar":"فَأَحْسَنَ","tr":"fa-aḥsana","en":"and made good","root":"حسن","lem":"أَحْسَنَ"},{"ar":"صُوَرَكُمْ ۖ","tr":"ṣuwarakum","en":"your forms","root":"صور","lem":"صُورَة"},{"ar":"وَإِلَيْهِ","tr":"wa-ilayhi","en":"and to Him"},{"ar":"ٱلْمَصِيرُ","tr":"l-maṣīru","en":"(is) the final return","root":"صير","lem":"مَصِير"}]},{"n":4,"juz":28,"ar":"يَعْلَمُ مَا فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَيَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ ۚ وَٱللَّهُ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ","en":"He knows what is within the heavens and earth and knows what you conceal and what you declare. And Allāh is Knowing of that within the breasts.","w":[{"ar":"يَعْلَمُ","tr":"yaʿlamu","en":"He knows","root":"علم","lem":"عَلِمَ"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"فِى","tr":"fī","en":"(is) in"},{"ar":"ٱلسَّمَـٰوَٰتِ","tr":"l-samāwāti","en":"the heavens","root":"سمو","lem":"سَماء"},{"ar":"وَٱلْأَرْضِ","tr":"wal-arḍi","en":"and the earth","root":"أرض","lem":"أَرْض"},{"ar":"وَيَعْلَمُ","tr":"wayaʿlamu","en":"and He knows","root":"علم","lem":"عَلِمَ"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"تُسِرُّونَ","tr":"tusirrūna","en":"you conceal","root":"سرر","lem":"أَسَرَّ"},{"ar":"وَمَا","tr":"wamā","en":"and what"},{"ar":"تُعْلِنُونَ ۚ","tr":"tuʿ'linūna","en":"you declare","root":"علن","lem":"أَعْلَن"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"عَلِيمٌۢ","tr":"ʿalīmun","en":"(is) All-Knowing","root":"علم","lem":"عَلِيم"},{"ar":"بِذَاتِ","tr":"bidhāti","en":"of what"},{"ar":"ٱلصُّدُورِ","tr":"l-ṣudūri","en":"(is in) the breasts","root":"صدر","lem":"صَدْر"}]},{"n":5,"juz":28,"ar":"أَلَمْ يَأْتِكُمْ نَبَؤُا۟ ٱلَّذِينَ كَفَرُوا۟ مِن قَبْلُ فَذَاقُوا۟ وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ","en":"Has there not come to you the news of those who disbelieved before? So they tasted the bad consequence of their affair, and they will have a painful punishment.","w":[{"ar":"أَلَمْ","tr":"alam","en":"Has not"},{"ar":"يَأْتِكُمْ","tr":"yatikum","en":"come to you","root":"أتي","lem":"أَتَى"},{"ar":"نَبَؤُا۟","tr":"naba-u","en":"(the) news","root":"نبأ","lem":"نَبَأ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"(of) those who"},{"ar":"كَفَرُوا۟","tr":"kafarū","en":"disbelieved","root":"كفر","lem":"كَفَرَ"},{"ar":"مِن","tr":"min","en":"from"},{"ar":"قَبْلُ","tr":"qablu","en":"before","root":"قبل","lem":"قَبْل"},{"ar":"فَذَاقُوا۟","tr":"fadhāqū","en":"So they tasted","root":"ذوق","lem":"ذاقُ"},{"ar":"وَبَالَ","tr":"wabāla","en":"(the bad) consequence","root":"وبل","lem":"وَبال"},{"ar":"أَمْرِهِمْ","tr":"amrihim","en":"(of) their affair","root":"أمر","lem":"أَمْر"},{"ar":"وَلَهُمْ","tr":"walahum","en":"and for them"},{"ar":"عَذَابٌ","tr":"ʿadhābun","en":"(is) a punishment","root":"عذب","lem":"عَذاب"},{"ar":"أَلِيمٌۭ","tr":"alīmun","en":"painful","root":"ألم","lem":"أَلِيم"}]},{"n":6,"juz":28,"ar":"ذَٰلِكَ بِأَنَّهُۥ كَانَت تَّأْتِيهِمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ فَقَالُوٓا۟ أَبَشَرٌ يَهْدُونَنَا فَكَفَرُوا۟ وَتَوَلَّوا۟ ۚ وَّٱسْتَغْنَى ٱللَّهُ ۚ وَٱللَّهُ غَنِىٌّ حَمِيدٌ","en":"That is because their messengers used to come to them with clear evidences, but they said, \"Shall human beings guide us?\" and disbelieved and turned away. And Allāh dispensed [with them]; and Allāh is Free of need and Praiseworthy.","w":[{"ar":"ذَٰلِكَ","tr":"dhālika","en":"That"},{"ar":"بِأَنَّهُۥ","tr":"bi-annahu","en":"(is) because"},{"ar":"كَانَت","tr":"kānat","en":"had","root":"كون","lem":"كانَ"},{"ar":"تَّأْتِيهِمْ","tr":"tatīhim","en":"come to them","root":"أتي","lem":"أَتَى"},{"ar":"رُسُلُهُم","tr":"rusuluhum","en":"their Messengers","root":"رسل","lem":"رَسُول"},{"ar":"بِٱلْبَيِّنَـٰتِ","tr":"bil-bayināti","en":"with clear proofs","root":"بين","lem":"بَيِّنَة"},{"ar":"فَقَالُوٓا۟","tr":"faqālū","en":"but they said","root":"قول","lem":"قالَ"},{"ar":"أَبَشَرٌۭ","tr":"abasharun","en":"Shall human beings","root":"بشر","lem":"بَشَر"},{"ar":"يَهْدُونَنَا","tr":"yahdūnanā","en":"guide us","root":"هدي","lem":"هَدَى"},{"ar":"فَكَفَرُوا۟","tr":"fakafarū","en":"So they disbelieved","root":"كفر","lem":"كَفَرَ"},{"ar":"وَتَوَلَّوا۟ ۚ","tr":"watawallaw","en":"and turned away","root":"ولي","lem":"تَوَلَّى"},{"ar":"وَّٱسْتَغْنَى","tr":"wa-is'taghnā","en":"And can do without them","root":"غني","lem":"اسْتَغْنَى"},{"ar":"ٱللَّهُ ۚ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"غَنِىٌّ","tr":"ghaniyyun","en":"(is) Self-sufficient","root":"غني","lem":"غَنِيّ"},{"ar":"حَمِيدٌۭ","tr":"ḥamīdun","en":"Praiseworthy","root":"حمد","lem":"حَمِيد"}]},{"n":7,"juz":28,"ar":"زَعَمَ ٱلَّذِينَ كَفَرُوٓا۟ أَن لَّن يُبْعَثُوا۟ ۚ قُلْ بَلَىٰ وَرَبِّى لَتُبْعَثُنَّ ثُمَّ لَتُنَبَّؤُنَّ بِمَا عَمِلْتُمْ ۚ وَذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٌ","en":"Those who disbelieve have claimed that they will never be resurrected. Say, \"Yes, by my Lord, you will surely be resurrected; then you will surely be informed of what you did. And that, for Allāh, is easy.\"","w":[{"ar":"زَعَمَ","tr":"zaʿama","en":"Claim","root":"زعم","lem":"زَعَمَ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"كَفَرُوٓا۟","tr":"kafarū","en":"disbelieve","root":"كفر","lem":"كَفَرَ"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"لَّن","tr":"lan","en":"never"},{"ar":"يُبْعَثُوا۟ ۚ","tr":"yub'ʿathū","en":"will they be raised","root":"بعث","lem":"بَعَثَ"},{"ar":"قُلْ","tr":"qul","en":"Say","root":"قول","lem":"قالَ"},{"ar":"بَلَىٰ","tr":"balā","en":"Yes"},{"ar":"وَرَبِّى","tr":"warabbī","en":"by my Lord","root":"ربب","lem":"رَبّ"},{"ar":"لَتُبْعَثُنَّ","tr":"latub'ʿathunna","en":"surely you will be raised","root":"بعث","lem":"بَعَثَ"},{"ar":"ثُمَّ","tr":"thumma","en":"then"},{"ar":"لَتُنَبَّؤُنَّ","tr":"latunabba-unna","en":"surely you will be informed","root":"نبأ","lem":"نَبَّأَ"},{"ar":"بِمَا","tr":"bimā","en":"of what"},{"ar":"عَمِلْتُمْ ۚ","tr":"ʿamil'tum","en":"you did","root":"عمل","lem":"عَمِلَ"},{"ar":"وَذَٰلِكَ","tr":"wadhālika","en":"And that"},{"ar":"عَلَى","tr":"ʿalā","en":"for"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"يَسِيرٌۭ","tr":"yasīrun","en":"(is) easy","root":"يسر","lem":"يَسِير"}]},{"n":8,"juz":28,"ar":"فَـَٔامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَٱلنُّورِ ٱلَّذِىٓ أَنزَلْنَا ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","en":"So believe in Allāh and His Messenger and the light [i.e., the Qur’ān] which We have sent down. And Allāh is Aware of what you do.","w":[{"ar":"فَـَٔامِنُوا۟","tr":"faāminū","en":"So believe","root":"أمن","lem":"آمَنَ"},{"ar":"بِٱللَّهِ","tr":"bil-lahi","en":"in Allah","root":"أله","lem":"اللَّه"},{"ar":"وَرَسُولِهِۦ","tr":"warasūlihi","en":"and His Messenger","root":"رسل","lem":"رَسُول"},{"ar":"وَٱلنُّورِ","tr":"wal-nūri","en":"and the Light","root":"نور","lem":"نُور"},{"ar":"ٱلَّذِىٓ","tr":"alladhī","en":"which"},{"ar":"أَنزَلْنَا ۚ","tr":"anzalnā","en":"We have sent down","root":"نزل","lem":"أَنزَلَ"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"بِمَا","tr":"bimā","en":"of what"},{"ar":"تَعْمَلُونَ","tr":"taʿmalūna","en":"you do","root":"عمل","lem":"عَمِلَ"},{"ar":"خَبِيرٌۭ","tr":"khabīrun","en":"(is) All-Aware","root":"خبر","lem":"خَبِير"}]},{"n":9,"juz":28,"ar":"يَوْمَ يَجْمَعُكُمْ لِيَوْمِ ٱلْجَمْعِ ۖ ذَٰلِكَ يَوْمُ ٱلتَّغَابُنِ ۗ وَمَن يُؤْمِنۢ بِٱللَّهِ وَيَعْمَلْ صَـٰلِحًا يُكَفِّرْ عَنْهُ سَيِّـَٔاتِهِۦ وَيُدْخِلْهُ جَنَّـٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ","en":"The Day He will assemble you for the Day of Assembly - that is the Day of Deprivation. And whoever believes in Allāh and does righteousness - He will remove from him his misdeeds and admit him to gardens beneath which rivers flow, wherein they will abide forever. That is the great attainment.","w":[{"ar":"يَوْمَ","tr":"yawma","en":"(The) Day","root":"يوم","lem":"يَوْم"},{"ar":"يَجْمَعُكُمْ","tr":"yajmaʿukum","en":"He will assemble you","root":"جمع","lem":"جَمَعَ"},{"ar":"لِيَوْمِ","tr":"liyawmi","en":"for (the) Day","root":"يوم","lem":"يَوْم"},{"ar":"ٱلْجَمْعِ ۖ","tr":"l-jamʿi","en":"(of) the Assembly","root":"جمع","lem":"جَمْع"},{"ar":"ذَٰلِكَ","tr":"dhālika","en":"that"},{"ar":"يَوْمُ","tr":"yawmu","en":"(will be the) Day","root":"يوم","lem":"يَوْم"},{"ar":"ٱلتَّغَابُنِ ۗ","tr":"l-taghābuni","en":"(of) mutual loss and gain","root":"غبن","lem":"تَغابُن"},{"ar":"وَمَن","tr":"waman","en":"And whoever"},{"ar":"يُؤْمِنۢ","tr":"yu'min","en":"believes","root":"أمن","lem":"آمَنَ"},{"ar":"بِٱللَّهِ","tr":"bil-lahi","en":"in Allah","root":"أله","lem":"اللَّه"},{"ar":"وَيَعْمَلْ","tr":"wayaʿmal","en":"and does","root":"عمل","lem":"عَمِلَ"},{"ar":"صَـٰلِحًۭا","tr":"ṣāliḥan","en":"righteous deeds","root":"صلح","lem":"صالِح"},{"ar":"يُكَفِّرْ","tr":"yukaffir","en":"He will remove","root":"كفر","lem":"كَفَّرَ"},{"ar":"عَنْهُ","tr":"ʿanhu","en":"from him"},{"ar":"سَيِّـَٔاتِهِۦ","tr":"sayyiātihi","en":"his evil deeds","root":"سوأ","lem":"سَيِّئَة"},{"ar":"وَيُدْخِلْهُ","tr":"wayud'khil'hu","en":"and He will admit him","root":"دخل","lem":"أُدْخِلَ"},{"ar":"جَنَّـٰتٍۢ","tr":"jannātin","en":"(to) Gardens","root":"جنن","lem":"جَنَّة"},{"ar":"تَجْرِى","tr":"tajrī","en":"flow","root":"جري","lem":"جَرَيْ"},{"ar":"مِن","tr":"min","en":"from"},{"ar":"تَحْتِهَا","tr":"taḥtihā","en":"underneath it","root":"تحت","lem":"تَحْت"},{"ar":"ٱلْأَنْهَـٰرُ","tr":"l-anhāru","en":"the rivers","root":"نهر","lem":"نَهَر"},{"ar":"خَـٰلِدِينَ","tr":"khālidīna","en":"abiding","root":"خلد","lem":"خالِد"},{"ar":"فِيهَآ","tr":"fīhā","en":"therein"},{"ar":"أَبَدًۭا ۚ","tr":"abadan","en":"forever","root":"أبد","lem":"أَبَدًا"},{"ar":"ذَٰلِكَ","tr":"dhālika","en":"That"},{"ar":"ٱلْفَوْزُ","tr":"l-fawzu","en":"(is) the success","root":"فوز","lem":"فَوْز"},{"ar":"ٱلْعَظِيمُ","tr":"l-ʿaẓīmu","en":"the great","root":"عظم","lem":"عَظِيم"}]},{"n":10,"juz":28,"ar":"وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلنَّارِ خَـٰلِدِينَ فِيهَا ۖ وَبِئْسَ ٱلْمَصِيرُ","en":"But the ones who disbelieved and denied Our verses - those are the companions of the Fire, abiding eternally therein; and wretched is the destination.","w":[{"ar":"وَٱلَّذِينَ","tr":"wa-alladhīna","en":"But those who"},{"ar":"كَفَرُوا۟","tr":"kafarū","en":"disbelieved","root":"كفر","lem":"كَفَرَ"},{"ar":"وَكَذَّبُوا۟","tr":"wakadhabū","en":"and denied","root":"كذب","lem":"كَذَّبَ"},{"ar":"بِـَٔايَـٰتِنَآ","tr":"biāyātinā","en":"[in] Our Verses","root":"أيي","lem":"آيَة"},{"ar":"أُو۟لَـٰٓئِكَ","tr":"ulāika","en":"those"},{"ar":"أَصْحَـٰبُ","tr":"aṣḥābu","en":"(are the) companions","root":"صحب","lem":"أَصْحاب"},{"ar":"ٱلنَّارِ","tr":"l-nāri","en":"(of) the Fire","root":"نور","lem":"نار"},{"ar":"خَـٰلِدِينَ","tr":"khālidīna","en":"abiding forever","root":"خلد","lem":"خالِد"},{"ar":"فِيهَا ۖ","tr":"fīhā","en":"therein"},{"ar":"وَبِئْسَ","tr":"wabi'sa","en":"And wretched is","root":"بأس","lem":"بِئْسَ"},{"ar":"ٱلْمَصِيرُ","tr":"l-maṣīru","en":"the destination","root":"صير","lem":"مَصِير"}]},{"n":11,"juz":28,"ar":"مَآ أَصَابَ مِن مُّصِيبَةٍ إِلَّا بِإِذْنِ ٱللَّهِ ۗ وَمَن يُؤْمِنۢ بِٱللَّهِ يَهْدِ قَلْبَهُۥ ۚ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌ","en":"No disaster strikes except by permission of Allāh. And whoever believes in Allāh - He will guide his heart. And Allāh is Knowing of all things.","w":[{"ar":"مَآ","tr":"mā","en":"Not"},{"ar":"أَصَابَ","tr":"aṣāba","en":"strikes","root":"صوب","lem":"أَصابَ"},{"ar":"مِن","tr":"min","en":"any"},{"ar":"مُّصِيبَةٍ","tr":"muṣībatin","en":"disaster","root":"صوب","lem":"مُصِيبَة"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"بِإِذْنِ","tr":"bi-idh'ni","en":"by (the) permission","root":"أذن","lem":"إِذْن"},{"ar":"ٱللَّهِ ۗ","tr":"l-lahi","en":"(of) Allah","root":"أله","lem":"اللَّه"},{"ar":"وَمَن","tr":"waman","en":"And whoever"},{"ar":"يُؤْمِنۢ","tr":"yu'min","en":"believes","root":"أمن","lem":"آمَنَ"},{"ar":"بِٱللَّهِ","tr":"bil-lahi","en":"in Allah","root":"أله","lem":"اللَّه"},{"ar":"يَهْدِ","tr":"yahdi","en":"He guides","root":"هدي","lem":"هَدَى"},{"ar":"قَلْبَهُۥ ۚ","tr":"qalbahu","en":"his heart","root":"قلب","lem":"قَلْب"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"بِكُلِّ","tr":"bikulli","en":"of every","root":"كلل","lem":"كُلّ"},{"ar":"شَىْءٍ","tr":"shayin","en":"thing","root":"شيأ","lem":"شَىْء"},{"ar":"عَلِيمٌۭ","tr":"ʿalīmun","en":"(is) All-Knowing","root":"علم","lem":"عَلِيم"}]},{"n":12,"juz":28,"ar":"وَأَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ ۚ فَإِن تَوَلَّيْتُمْ فَإِنَّمَا عَلَىٰ رَسُولِنَا ٱلْبَلَـٰغُ ٱلْمُبِينُ","en":"And obey Allāh and obey the Messenger; but if you turn away - then upon Our Messenger is only [the duty of] clear notification.","w":[{"ar":"وَأَطِيعُوا۟","tr":"wa-aṭīʿū","en":"So obey","root":"طوع","lem":"أَطاعَ"},{"ar":"ٱللَّهَ"