:"fa-ittabiʿ'hā","en":"so follow it","root":"تبع","lem":"اتَّبَعَ"},{"ar":"وَلَا","tr":"walā","en":"and (do) not"},{"ar":"تَتَّبِعْ","tr":"tattabiʿ","en":"follow","root":"تبع","lem":"اتَّبَعَ"},{"ar":"أَهْوَآءَ","tr":"ahwāa","en":"(the) desires","root":"هوي","lem":"أَهْواء"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"(of) those who"},{"ar":"لَا","tr":"lā","en":"(do) not"},{"ar":"يَعْلَمُونَ","tr":"yaʿlamūna","en":"know","root":"علم","lem":"عَلِمَ"}]},{"n":19,"juz":25,"ar":"إِنَّهُمْ لَن يُغْنُوا۟ عَنكَ مِنَ ٱللَّهِ شَيْـًٔا ۚ وَإِنَّ ٱلظَّـٰلِمِينَ بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍ ۖ وَٱللَّهُ وَلِىُّ ٱلْمُتَّقِينَ","en":"Indeed, they will never avail you against Allāh at all. And indeed, the wrongdoers are allies of one another; but Allāh is the protector of the righteous.","w":[{"ar":"إِنَّهُمْ","tr":"innahum","en":"Indeed, they"},{"ar":"لَن","tr":"lan","en":"never"},{"ar":"يُغْنُوا۟","tr":"yugh'nū","en":"will avail","root":"غني","lem":"أَغْنَتْ"},{"ar":"عَنكَ","tr":"ʿanka","en":"you"},{"ar":"مِنَ","tr":"mina","en":"against"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"شَيْـًۭٔا ۚ","tr":"shayan","en":"(in) anything","root":"شيأ","lem":"شَىْء"},{"ar":"وَإِنَّ","tr":"wa-inna","en":"And indeed"},{"ar":"ٱلظَّـٰلِمِينَ","tr":"l-ẓālimīna","en":"the wrongdoers","root":"ظلم","lem":"ظالِم"},{"ar":"بَعْضُهُمْ","tr":"baʿḍuhum","en":"some of them","root":"بعض","lem":"بَعْض"},{"ar":"أَوْلِيَآءُ","tr":"awliyāu","en":"(are) allies","root":"ولي","lem":"وَلِيّ"},{"ar":"بَعْضٍۢ ۖ","tr":"baʿḍin","en":"(of) others","root":"بعض","lem":"بَعْض"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"and Allah","root":"أله","lem":"اللَّه"},{"ar":"وَلِىُّ","tr":"waliyyu","en":"(is the) Protector","root":"ولي","lem":"وَلِيّ"},{"ar":"ٱلْمُتَّقِينَ","tr":"l-mutaqīna","en":"(of) the righteous","root":"وقي","lem":"مُتَّقي"}]},{"n":20,"juz":25,"ar":"هَـٰذَا بَصَـٰٓئِرُ لِلنَّاسِ وَهُدًى وَرَحْمَةٌ لِّقَوْمٍ يُوقِنُونَ","en":"This [Qur’ān] is enlightenment for mankind and guidance and mercy for a people who are certain [in faith].","w":[{"ar":"هَـٰذَا","tr":"hādhā","en":"This"},{"ar":"بَصَـٰٓئِرُ","tr":"baṣāiru","en":"(is) enlightenment","root":"بصر","lem":"بَصِيرَة"},{"ar":"لِلنَّاسِ","tr":"lilnnāsi","en":"for mankind","root":"أنس","lem":"ناس"},{"ar":"وَهُدًۭى","tr":"wahudan","en":"and guidance","root":"هدي","lem":"هُدًى"},{"ar":"وَرَحْمَةٌۭ","tr":"waraḥmatun","en":"and mercy","root":"رحم","lem":"رَحْمَة"},{"ar":"لِّقَوْمٍۢ","tr":"liqawmin","en":"for a people","root":"قوم","lem":"قَوْم"},{"ar":"يُوقِنُونَ","tr":"yūqinūna","en":"who are certain","root":"يقن","lem":"يُوقِنُ"}]},{"n":21,"juz":25,"ar":"أَمْ حَسِبَ ٱلَّذِينَ ٱجْتَرَحُوا۟ ٱلسَّيِّـَٔاتِ أَن نَّجْعَلَهُمْ كَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ سَوَآءً مَّحْيَاهُمْ وَمَمَاتُهُمْ ۚ سَآءَ مَا يَحْكُمُونَ","en":"Or do those who commit evils think We will make them like those who have believed and done righteous deeds - [make them] equal in their life and their death? Evil is that which they judge [i.e., assume].","w":[{"ar":"أَمْ","tr":"am","en":"Do"},{"ar":"حَسِبَ","tr":"ḥasiba","en":"think","root":"حسب","lem":"حَسِبَ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"ٱجْتَرَحُوا۟","tr":"ij'taraḥū","en":"commit","root":"جرح","lem":"اجْتَرَحُ"},{"ar":"ٱلسَّيِّـَٔاتِ","tr":"l-sayiāti","en":"evil deeds","root":"سوأ","lem":"سَيِّئَة"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"نَّجْعَلَهُمْ","tr":"najʿalahum","en":"We will make them","root":"جعل","lem":"جَعَلَ"},{"ar":"كَٱلَّذِينَ","tr":"ka-alladhīna","en":"like those who"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"believed","root":"أمن","lem":"آمَنَ"},{"ar":"وَعَمِلُوا۟","tr":"waʿamilū","en":"and did","root":"عمل","lem":"عَمِلَ"},{"ar":"ٱلصَّـٰلِحَـٰتِ","tr":"l-ṣāliḥāti","en":"righteous deeds","root":"صلح","lem":"صالِحَة"},{"ar":"سَوَآءًۭ","tr":"sawāan","en":"equal","root":"سوي","lem":"سَواء"},{"ar":"مَّحْيَاهُمْ","tr":"maḥyāhum","en":"(in) their life","root":"حيي","lem":"مَحْيا"},{"ar":"وَمَمَاتُهُمْ ۚ","tr":"wamamātuhum","en":"and their death","root":"موت","lem":"مَمات"},{"ar":"سَآءَ","tr":"sāa","en":"Evil is","root":"سوأ","lem":"ساءَ"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"يَحْكُمُونَ","tr":"yaḥkumūna","en":"they judge","root":"حكم","lem":"حَكَمَ"}]},{"n":22,"juz":25,"ar":"وَخَلَقَ ٱللَّهُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ وَلِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ","en":"And Allāh created the heavens and earth in truth and so that every soul may be recompensed for what it has earned, and they will not be wronged.","w":[{"ar":"وَخَلَقَ","tr":"wakhalaqa","en":"And Allah created","root":"خلق","lem":"خَلَقَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"And Allah created","root":"أله","lem":"اللَّه"},{"ar":"ٱلسَّمَـٰوَٰتِ","tr":"l-samāwāti","en":"the heavens","root":"سمو","lem":"سَماء"},{"ar":"وَٱلْأَرْضَ","tr":"wal-arḍa","en":"and the earth","root":"أرض","lem":"أَرْض"},{"ar":"بِٱلْحَقِّ","tr":"bil-ḥaqi","en":"in truth","root":"حقق","lem":"حَقّ"},{"ar":"وَلِتُجْزَىٰ","tr":"walituj'zā","en":"and that may be recompensed","root":"جزي","lem":"جَزَى"},{"ar":"كُلُّ","tr":"kullu","en":"every","root":"كلل","lem":"كُلّ"},{"ar":"نَفْسٍۭ","tr":"nafsin","en":"soul","root":"نفس","lem":"نَفْس"},{"ar":"بِمَا","tr":"bimā","en":"for what"},{"ar":"كَسَبَتْ","tr":"kasabat","en":"it has earned","root":"كسب","lem":"كَسَبَ"},{"ar":"وَهُمْ","tr":"wahum","en":"and they"},{"ar":"لَا","tr":"lā","en":"will not be wronged"},{"ar":"يُظْلَمُونَ","tr":"yuẓ'lamūna","en":"will not be wronged","root":"ظلم","lem":"ظَلَمَ"}]},{"n":23,"juz":25,"ar":"أَفَرَءَيْتَ مَنِ ٱتَّخَذَ إِلَـٰهَهُۥ هَوَىٰهُ وَأَضَلَّهُ ٱللَّهُ عَلَىٰ عِلْمٍ وَخَتَمَ عَلَىٰ سَمْعِهِۦ وَقَلْبِهِۦ وَجَعَلَ عَلَىٰ بَصَرِهِۦ غِشَـٰوَةً فَمَن يَهْدِيهِ مِنۢ بَعْدِ ٱللَّهِ ۚ أَفَلَا تَذَكَّرُونَ","en":"Have you seen he who has taken as his god his [own] desire, and Allāh has sent him astray due to knowledge and has set a seal upon his hearing and his heart and put over his vision a veil? So who will guide him after Allāh? Then will you not be reminded?","w":[{"ar":"أَفَرَءَيْتَ","tr":"afara-ayta","en":"Have you seen","root":"رأي","lem":"رَأَى"},{"ar":"مَنِ","tr":"mani","en":"(he) who"},{"ar":"ٱتَّخَذَ","tr":"ittakhadha","en":"takes","root":"أخذ","lem":"اتَّخَذَ"},{"ar":"إِلَـٰهَهُۥ","tr":"ilāhahu","en":"(as) his god","root":"أله","lem":"إِلٰه"},{"ar":"هَوَىٰهُ","tr":"hawāhu","en":"his desire","root":"هوي","lem":"هَواء"},{"ar":"وَأَضَلَّهُ","tr":"wa-aḍallahu","en":"and Allah lets him go astray","root":"ضلل","lem":"أَضَلَّ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"and Allah lets him go astray","root":"أله","lem":"اللَّه"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"knowingly"},{"ar":"عِلْمٍۢ","tr":"ʿil'min","en":"knowingly","root":"علم","lem":"عِلْم"},{"ar":"وَخَتَمَ","tr":"wakhatama","en":"and He sets a seal","root":"ختم","lem":"خَتَمَ"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"upon"},{"ar":"سَمْعِهِۦ","tr":"samʿihi","en":"his hearing","root":"سمع","lem":"سَمْع"},{"ar":"وَقَلْبِهِۦ","tr":"waqalbihi","en":"and his heart","root":"قلب","lem":"قَلْب"},{"ar":"وَجَعَلَ","tr":"wajaʿala","en":"and puts","root":"جعل","lem":"جَعَلَ"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"over"},{"ar":"بَصَرِهِۦ","tr":"baṣarihi","en":"his vision","root":"بصر","lem":"بَصَر"},{"ar":"غِشَـٰوَةًۭ","tr":"ghishāwatan","en":"a veil","root":"غشو","lem":"غِشاوَة"},{"ar":"فَمَن","tr":"faman","en":"Then who"},{"ar":"يَهْدِيهِ","tr":"yahdīhi","en":"will guide him","root":"هدي","lem":"هَدَى"},{"ar":"مِنۢ","tr":"min","en":"after"},{"ar":"بَعْدِ","tr":"baʿdi","en":"after","root":"بعد","lem":"بَعْد"},{"ar":"ٱللَّهِ ۚ","tr":"l-lahi","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"أَفَلَا","tr":"afalā","en":"Then will not"},{"ar":"تَذَكَّرُونَ","tr":"tadhakkarūna","en":"you receive admonition","root":"ذكر","lem":"تَذَكَّرَ"}]},{"n":24,"juz":25,"ar":"وَقَالُوا۟ مَا هِىَ إِلَّا حَيَاتُنَا ٱلدُّنْيَا نَمُوتُ وَنَحْيَا وَمَا يُهْلِكُنَآ إِلَّا ٱلدَّهْرُ ۚ وَمَا لَهُم بِذَٰلِكَ مِنْ عِلْمٍ ۖ إِنْ هُمْ إِلَّا يَظُنُّونَ","en":"And they say, \"There is not but our worldly life; we die and live, and nothing destroys us except time.\" And they have of that no knowledge; they are only assuming.","w":[{"ar":"وَقَالُوا۟","tr":"waqālū","en":"And they say","root":"قول","lem":"قالَ"},{"ar":"مَا","tr":"mā","en":"Not"},{"ar":"هِىَ","tr":"hiya","en":"it"},{"ar":"إِلَّا","tr":"illā","en":"(is) but"},{"ar":"حَيَاتُنَا","tr":"ḥayātunā","en":"our life","root":"حيي","lem":"حَياة"},{"ar":"ٱلدُّنْيَا","tr":"l-dun'yā","en":"(of) the world","root":"دنو","lem":"دُنْيا"},{"ar":"نَمُوتُ","tr":"namūtu","en":"we die","root":"موت","lem":"ماتَ"},{"ar":"وَنَحْيَا","tr":"wanaḥyā","en":"and we live","root":"حيي","lem":"حَىَّ"},{"ar":"وَمَا","tr":"wamā","en":"and not"},{"ar":"يُهْلِكُنَآ","tr":"yuh'likunā","en":"destroys us","root":"هلك","lem":"أَهْلَكَ"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"ٱلدَّهْرُ ۚ","tr":"l-dahru","en":"the time","root":"دهر","lem":"دَهْر"},{"ar":"وَمَا","tr":"wamā","en":"And not"},{"ar":"لَهُم","tr":"lahum","en":"for them"},{"ar":"بِذَٰلِكَ","tr":"bidhālika","en":"of that"},{"ar":"مِنْ","tr":"min","en":"any"},{"ar":"عِلْمٍ ۖ","tr":"ʿil'min","en":"knowledge","root":"علم","lem":"عِلْم"},{"ar":"إِنْ","tr":"in","en":"not"},{"ar":"هُمْ","tr":"hum","en":"they"},{"ar":"إِلَّا","tr":"illā","en":"(do) but"},{"ar":"يَظُنُّونَ","tr":"yaẓunnūna","en":"guess","root":"ظنن","lem":"ظَنَّ"}]},{"n":25,"juz":25,"ar":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَـٰتُنَا بَيِّنَـٰتٍ مَّا كَانَ حُجَّتَهُمْ إِلَّآ أَن قَالُوا۟ ٱئْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَـٰدِقِينَ","en":"And when Our verses are recited to them as clear evidences, their argument is only that they say, \"Bring [back] our forefathers, if you should be truthful.\"","w":[{"ar":"وَإِذَا","tr":"wa-idhā","en":"And when"},{"ar":"تُتْلَىٰ","tr":"tut'lā","en":"are recited","root":"تلو","lem":"تَلَى"},{"ar":"عَلَيْهِمْ","tr":"ʿalayhim","en":"to them"},{"ar":"ءَايَـٰتُنَا","tr":"āyātunā","en":"Our Verses","root":"أيي","lem":"آيَة"},{"ar":"بَيِّنَـٰتٍۢ","tr":"bayyinātin","en":"clear","ro