ينَ","tr":"muj'rimīna","en":"criminals","root":"جرم","lem":"مُجْرِم"}]},{"n":32,"juz":25,"ar":"وَإِذَا قِيلَ إِنَّ وَعْدَ ٱللَّهِ حَقٌّ وَٱلسَّاعَةُ لَا رَيْبَ فِيهَا قُلْتُم مَّا نَدْرِى مَا ٱلسَّاعَةُ إِن نَّظُنُّ إِلَّا ظَنًّا وَمَا نَحْنُ بِمُسْتَيْقِنِينَ","en":"And when it was said, 'Indeed, the promise of Allāh is truth and the Hour [is coming] - no doubt about it,' you said, 'We know not what is the Hour. We assume only assumption, and we are not convinced.'\"","w":[{"ar":"وَإِذَا","tr":"wa-idhā","en":"And when"},{"ar":"قِيلَ","tr":"qīla","en":"it was said","root":"قول","lem":"قالَ"},{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"وَعْدَ","tr":"waʿda","en":"(the) Promise","root":"وعد","lem":"وَعْد"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"(of) Allah","root":"أله","lem":"اللَّه"},{"ar":"حَقٌّۭ","tr":"ḥaqqun","en":"(is) true","root":"حقق","lem":"حَقّ"},{"ar":"وَٱلسَّاعَةُ","tr":"wal-sāʿatu","en":"and the Hour ","root":"سوع","lem":"ساعَة"},{"ar":"لَا","tr":"lā","en":"(there is) no"},{"ar":"رَيْبَ","tr":"rayba","en":"doubt","root":"ريب","lem":"رَيْب"},{"ar":"فِيهَا","tr":"fīhā","en":"about it"},{"ar":"قُلْتُم","tr":"qul'tum","en":"you said","root":"قول","lem":"قالَ"},{"ar":"مَّا","tr":"mā","en":"Not"},{"ar":"نَدْرِى","tr":"nadrī","en":"we know","root":"دري","lem":"تَدْرِي"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"ٱلسَّاعَةُ","tr":"l-sāʿatu","en":"the Hour (is)","root":"سوع","lem":"ساعَة"},{"ar":"إِن","tr":"in","en":"Not"},{"ar":"نَّظُنُّ","tr":"naẓunnu","en":"we think","root":"ظنن","lem":"ظَنَّ"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"ظَنًّۭا","tr":"ẓannan","en":"an assumption","root":"ظنن","lem":"ظَنّ"},{"ar":"وَمَا","tr":"wamā","en":"and not"},{"ar":"نَحْنُ","tr":"naḥnu","en":"we"},{"ar":"بِمُسْتَيْقِنِينَ","tr":"bimus'tayqinīna","en":"(are) convinced","root":"يقن","lem":"مُسْتَيْقِن"}]},{"n":33,"juz":25,"ar":"وَبَدَا لَهُمْ سَيِّـَٔاتُ مَا عَمِلُوا۟ وَحَاقَ بِهِم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","en":"And the evil consequences of what they did will appear to them, and they will be enveloped by what they used to ridicule.","w":[{"ar":"وَبَدَا","tr":"wabadā","en":"And (will) appear","root":"بدو","lem":"بَدا"},{"ar":"لَهُمْ","tr":"lahum","en":"to them"},{"ar":"سَيِّـَٔاتُ","tr":"sayyiātu","en":"(the) evil","root":"سوأ","lem":"سَيِّئَة"},{"ar":"مَا","tr":"mā","en":"(of) what"},{"ar":"عَمِلُوا۟","tr":"ʿamilū","en":"they did","root":"عمل","lem":"عَمِلَ"},{"ar":"وَحَاقَ","tr":"waḥāqa","en":"and (will) envelop","root":"حيق","lem":"حاقَ"},{"ar":"بِهِم","tr":"bihim","en":"them"},{"ar":"مَّا","tr":"mā","en":"what"},{"ar":"كَانُوا۟","tr":"kānū","en":"they used","root":"كون","lem":"كانَ"},{"ar":"بِهِۦ","tr":"bihi","en":"[at it]"},{"ar":"يَسْتَهْزِءُونَ","tr":"yastahziūna","en":"(to) mock","root":"هزأ","lem":"اسْتُهْزِئَ"}]},{"n":34,"juz":25,"ar":"وَقِيلَ ٱلْيَوْمَ نَنسَىٰكُمْ كَمَا نَسِيتُمْ لِقَآءَ يَوْمِكُمْ هَـٰذَا وَمَأْوَىٰكُمُ ٱلنَّارُ وَمَا لَكُم مِّن نَّـٰصِرِينَ","en":"And it will be said, \"Today We will forget you as you forgot the meeting of this Day of yours, and your refuge is the Fire, and for you there are no helpers.","w":[{"ar":"وَقِيلَ","tr":"waqīla","en":"And it will be said","root":"قول","lem":"قالَ"},{"ar":"ٱلْيَوْمَ","tr":"l-yawma","en":"Today","root":"يوم","lem":"يَوْم"},{"ar":"نَنسَىٰكُمْ","tr":"nansākum","en":"We forget you","root":"نسي","lem":"نَسِيَ"},{"ar":"كَمَا","tr":"kamā","en":"as"},{"ar":"نَسِيتُمْ","tr":"nasītum","en":"you forgot","root":"نسي","lem":"نَسِيَ"},{"ar":"لِقَآءَ","tr":"liqāa","en":"(the) meeting","root":"لقي","lem":"لِقاء"},{"ar":"يَوْمِكُمْ","tr":"yawmikum","en":"(of) this Day of yours","root":"يوم","lem":"يَوْم"},{"ar":"هَـٰذَا","tr":"hādhā","en":"(of) this Day of yours"},{"ar":"وَمَأْوَىٰكُمُ","tr":"wamawākumu","en":"and your abode","root":"أوي","lem":"مَأْوَى"},{"ar":"ٱلنَّارُ","tr":"l-nāru","en":"(is) the Fire","root":"نور","lem":"نار"},{"ar":"وَمَا","tr":"wamā","en":"and not"},{"ar":"لَكُم","tr":"lakum","en":"for you"},{"ar":"مِّن","tr":"min","en":"any"},{"ar":"نَّـٰ