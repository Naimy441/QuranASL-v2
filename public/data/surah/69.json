":"سُلْطان"}]},{"n":30,"juz":29,"ar":"خُذُوهُ فَغُلُّوهُ","en":"[Allāh will say], \"Seize him and shackle him.","w":[{"ar":"خُذُوهُ","tr":"khudhūhu","en":"Seize him","root":"أخذ","lem":"أَخَذَ"},{"ar":"فَغُلُّوهُ","tr":"faghullūhu","en":"and shackle him","root":"غلل","lem":"غَلَّ"}]},{"n":31,"juz":29,"ar":"ثُمَّ ٱلْجَحِيمَ صَلُّوهُ","en":"Then into Hellfire drive him.","w":[{"ar":"ثُمَّ","tr":"thumma","en":"Then"},{"ar":"ٱلْجَحِيمَ","tr":"l-jaḥīma","en":"(into) the Hellfire","root":"جحم","lem":"جَحِيم"},{"ar":"صَلُّوهُ","tr":"ṣallūhu","en":"burn him","root":"صلي","lem":"صَلُّ"}]},{"n":32,"juz":29,"ar":"ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ","en":"Then into a chain whose length is seventy cubits insert him.\"","w":[{"ar":"ثُمَّ","tr":"thumma","en":"Then"},{"ar":"فِى","tr":"fī","en":"into"},{"ar":"سِلْسِلَةٍۢ","tr":"sil'silatin","en":"a chain","root":"سلسل","lem":"سِلْسِلَة"},{"ar":"ذَرْعُهَا","tr":"dharʿuhā","en":"its length","root":"ذرع","lem":"ذَرْع"},{"ar":"سَبْعُونَ","tr":"sabʿūna","en":"(is) seventy","root":"سبع","lem":"سَبْع"},{"ar":"ذِرَاعًۭا","tr":"dhirāʿan","en":"cubits","root":"ذرع","lem":"ذِراع"},{"ar":"فَٱسْلُكُوهُ","tr":"fa-us'lukūhu","en":"insert him","root":"سلك","lem":"سَلَكَ"}]},{"n":33,"juz":29,"ar":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ","en":"Indeed, he did not used to believe in Allāh, the Most Great,","w":[{"ar":"إِنَّهُۥ","tr":"innahu","en":"Indeed, he"},{"ar":"كَانَ","tr":"kāna","en":"was","root":"كون","lem":"كانَ"},{"ar":"لَا","tr":"lā","en":"not"},{"ar":"يُؤْمِنُ","tr":"yu'minu","en":"believing","root":"أمن","lem":"آمَنَ"},{"ar":"بِٱللَّهِ","tr":"bil-lahi","en":"in Allah","root":"أله","lem":"اللَّه"},{"ar":"ٱلْعَظِيمِ","tr":"l-ʿaẓīmi","en":"the Most Great","root":"عظم","lem":"عَظِيم"}]},{"n":34,"juz":29,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","en":"Nor did he encourage the feeding of the poor.","w":[{"ar":"وَلَا","tr":"walā","en":"And (did) not"},{"ar":"يَحُضُّ","tr":"yaḥuḍḍu","en":"feel the urge","root":"حضض","lem":"يَحُضُّ"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"on"},{"ar":"طَعَامِ","tr":"ṭaʿāmi","en":"(the) feeding","root":"طعم","lem":"طَعام"},{"ar":"ٱلْمِسْكِينِ","tr":"l-mis'kīni","en":"(of) the poor","root":"سكن","lem":"مِسْكِين"}]},{"n":35,"juz":29,"ar":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ","en":"So there is not for him here this Day any devoted friend","w":[{"ar":"فَلَيْسَ","tr":"falaysa","en":"So not","root":"ليس","lem":"لَيْسَ"},{"ar":"لَهُ","tr":"lahu","en":"for him"},{"ar":"ٱلْيَوْمَ","tr":"l-yawma","en":"today","root":"يوم","lem":"يَوْم"},{"ar":"هَـٰهُنَا","tr":"hāhunā","en":"here"},{"ar":"حَمِيمٌۭ","tr":"ḥamīmun","en":"any devoted friend","root":"حمم","lem":"حَمِيم"}]},{"n":36,"juz":29,"ar":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ","en":"Nor any food except from the discharge of wounds;","w":[{"ar":"وَلَا","tr":"walā","en":"And not"},{"ar":"طَعَامٌ","tr":"ṭaʿāmun","en":"any food","root":"طعم","lem":"طَعام"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"مِنْ","tr":"min","en":"from"},{"ar":"غِسْلِينٍۢ","tr":"ghis'līnin","en":"(the) discharge of wounds","root":"غسل","lem":"غِسْلِين"}]},{"n":37,"juz":29,"ar":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ","en":"None will eat it except the sinners.","w":[{"ar":"لَّا","tr":"lā","en":"Not"},{"ar":"يَأْكُلُهُۥٓ","tr":"yakuluhu","en":"will eat it","root":"أكل","lem":"أَكَلَ"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"ٱلْخَـٰطِـُٔونَ","tr":"l-khāṭiūna","en":"the sinners","root":"خطأ","lem":"خاطِئ"}]},{"n":38,"juz":29,"ar":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ","en":"So I swear by what you see","w":[{"ar":"فَلَآ","tr":"falā","en":"But nay"},{"ar":"أُقْسِمُ","tr":"uq'simu","en":"I swear","root":"قسم","lem":"أَقْسَمُ"},{"ar":"بِمَا","tr":"bimā","en":"by what"},{"ar":"تُبْصِرُونَ","tr":"tub'ṣirūna","en":"you see","root":"بصر","lem":"أَبْصَرَ"}]},{"n":39,"juz":29,"ar":"وَمَا لَا تُبْصِرُونَ","en":"And what you do not see","w":[{"ar":"وَمَا","tr":"wamā","en":"And what"},{"ar":"لَا","tr":"lā","en":"not"},{"ar":"تُبْصِرُونَ","tr":"tub'ṣirūna","en":"you see","root":"بصر","lem":"أَبْصَرَ"}]},{"n":40,"juz":29,"ar":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","en":"[That] indeed, it [i.e., the Qur’ān] is the word of a noble Messenger.","w":[{"ar":"إِنَّهُۥ","tr":"innahu","en":"Indeed, it (is)"},{"ar":"لَقَوْلُ","tr":"laqawlu","en":"surely (the) Word","root":"قول","lem":"قَوْل"},{"ar":"رَسُولٍۢ","tr":"rasūlin","en":"(of) a Messenger","root":"رسل","lem":"رَسُول"},{"ar":"كَرِيمٍۢ","tr":"karīmin","en":"noble","root":"كرم","lem":"كَرِيم"}]},{"n":41,"juz":29,"ar":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ","en":"And it is not the word of a poet; little do you believe.","w":[{"ar":"وَمَا","tr":"wamā","en":"And not"},{"ar":"هُوَ","tr":"huwa","en":"it"},{"ar":"بِقَوْلِ","tr":"biqawli","en":"(is the) word","root":"قول","lem":"قَوْل"},{"ar":"شَاعِرٍۢ ۚ","tr":"shāʿirin","en":"(of) a poet","root":"شعر","lem":"شاعِر"},{"ar":"قَلِيلًۭا","tr":"qalīlan","en":"little","root":"قلل","lem":"قَلِيل"},{"ar":"مَّا","tr":"mā","en":"(is) what"},{"ar":"تُؤْمِنُونَ","tr":"tu'minūna","en":"you believe","root":"أمن","lem":"آمَنَ"}]},{"n":42,"juz":29,"ar":"وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ","en":"Nor the word of a soothsayer; little do you remember.","w":[{"ar":"وَلَا","tr":"walā","en":"And not"},{"ar":"بِقَوْلِ","tr":"biqawli","en":"(it is the) word","root":"قول","lem":"قَوْل"},{"ar":"كَاهِنٍۢ ۚ","tr":"kāhinin","en":"(of) a soothsayer","root":"كهن","lem":"كاهِن"},{"ar":"قَلِيلًۭا","tr":"qalīlan","en":"little","root":"قلل","lem":"قَلِيل"},{"ar":"مَّا","tr":"mā","en":"(is) what"},{"ar":"تَذَكَّرُونَ","tr":"tadhakkarūna","en":"you take heed","root":"ذكر","lem":"تَذَكَّرَ"}]},{"n":43,"juz":29,"ar":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ","en":"[It is] a revelation from the Lord of the worlds.","w":[{"ar":"تَنزِيلٌۭ","tr":"tanzīlun","en":"(It is) a revelation","root":"نزل","lem":"تَنزِيل"},{"ar":"مِّن","tr":"min","en":"from"},{"ar":"رَّبِّ","tr":"rabbi","en":"(the) Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلْعَـٰلَمِينَ","tr":"l-ʿālamīna","en":"(of) the worlds","root":"علم","lem":"عالَم"}]},{"n":44,"juz":29,"ar":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ","en":"And if he [i.e., Muḥammad] had made up about Us some [false] sayings,","w":[{"ar":"وَلَوْ","tr":"walaw","en":"And if"},{"ar":"تَقَوَّلَ","tr":"taqawwala","en":"he (had) fabricated","root":"قول","lem":"تَقَوَّلَ"},{"ar":"عَلَيْنَا","tr":"ʿalaynā","en":"against Us"},{"ar":"بَعْضَ","tr":"baʿḍa","en":"some","root":"بعض","lem":"بَعْض"},{"ar":"ٱلْأَقَاوِيلِ","tr":"l-aqāwīli","en":"sayings","root":"قول","lem":"أَقاوِيل"}]},{"n":45,"juz":29,"ar":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ","en":"We would have seized him by the right hand;","w":[{"ar":"لَأَخَذْنَا","tr":"la-akhadhnā","en":"Certainly We (would) have seized","root":"أخذ","lem":"أَخَذَ"},{"ar":"مِنْهُ","tr":"min'hu","en":"him"},{"ar":"بِٱلْيَمِينِ","tr":"bil-yamīni","en":"by the right hand","root":"يمن","lem":"يَمِين"}]},{"n":46,"juz":29,"ar":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ","en":"Then We would have cut from him the aorta.","w":[{"ar":"ثُمَّ","tr":"thumma","en":"Then"},{"ar":"لَقَطَعْنَا","tr":"laqaṭaʿnā","en":"certainly We (would) have cut off","root":"قطع","lem":"قُطِعَ"},{"ar":"مِنْهُ","tr":"min'hu","en":"from him"},{"ar":"ٱلْوَتِينَ","tr":"l-watīna","en":"the aorta","root":"وتن","lem":"وَتِين"}]},{"n":47,"juz":29,"ar":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ","en":"And there is no one of you who could prevent [Us] from him.","w":[{"ar":"فَمَا","tr":"famā","en":"And not"},{"ar":"مِنكُم","tr":"minkum","en":"from you"},{"ar":"مِّنْ","tr":"min","en":"any"},{"ar":"أَحَدٍ","tr":"aḥadin","en":"one","root":"أحد","lem":"أَحَد"},{"ar":"عَنْهُ","tr":"ʿanhu","en":"[from him]"},{"ar":"حَـٰجِزِينَ","tr":"ḥājizīna","en":"(who could) prevent (it)","root":"حجز","lem":"حاجِز"}]},{"n":48,"juz":29,"ar":"وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ","en":"And indeed, it [i.e., the Qur’ān] is a reminder for the righteous.","w":[{"ar":"وَإِنَّهُۥ","tr":"wa-inna