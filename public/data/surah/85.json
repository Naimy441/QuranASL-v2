ود"}]},{"n":15,"juz":30,"ar":"ذُو ٱلْعَرْشِ ٱلْمَجِيدُ","en":"Honorable Owner of the Throne,","w":[{"ar":"ذُو","tr":"dhū","en":"Owner (of)"},{"ar":"ٱلْعَرْشِ","tr":"l-ʿarshi","en":"the Throne","root":"عرش","lem":"عَرْش"},{"ar":"ٱلْمَجِيدُ","tr":"l-majīdu","en":"the Glorious","root":"مجد","lem":"مَجِيد"}]},{"n":16,"juz":30,"ar":"فَعَّالٌ لِّمَا يُرِيدُ","en":"Effecter of what He intends.","w":[{"ar":"فَعَّالٌۭ","tr":"faʿʿālun","en":"Doer","root":"فعل","lem":"فَعّال"},{"ar":"لِّمَا","tr":"limā","en":"of what"},{"ar":"يُرِيدُ","tr":"yurīdu","en":"He intends","root":"رود","lem":"أَرادَ"}]},{"n":17,"juz":30,"ar":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ","en":"Has there reached you the story of the soldiers -","w":[{"ar":"هَلْ","tr":"hal","en":"Has"},{"ar":"أَتَىٰكَ","tr":"atāka","en":"come to you","root":"أتي","lem":"أَتَى"},{"ar":"حَدِيثُ","tr":"ḥadīthu","en":"(the) story","root":"حدث","lem":"حَدِيث"},{"ar":"ٱلْجُنُودِ","tr":"l-junūdi","en":"(of) the hosts","root":"جند","lem":"جُند"}]},{"n":18,"juz":30,"ar":"فِرْعَوْنَ وَثَمُودَ","en":"[Those of] Pharaoh and Thamūd?","w":[{"ar":"فِرْعَوْنَ","tr":"fir'ʿawna","en":"Firaun"},{"ar":"وَثَمُودَ","tr":"wathamūda","en":"and Thamud"}]},{"n":19,"juz":30,"ar":"بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ","en":"But they who disbelieve are in [persistent] denial,","w":[{"ar":"بَلِ","tr":"bali","en":"Nay"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"Those who"},{"ar":"كَفَرُوا۟","tr":"kafarū","en":"disbelieve","root":"كفر","lem":"كَفَرَ"},{"ar":"فِى","tr":"fī","en":"(are) in"},{"ar":"تَكْذِيبٍۢ","tr":"takdhībin","en":"denial","root":"كذب","lem":"تَكْذِيب"}]},{"n":20,"juz":30,"ar":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ","en":"While Allāh encompasses them from behind.","w":[{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"But Allah","root":"أله","lem":"اللَّه"},{"ar":"مِن","tr":"min","en":"from"},{"ar":"وَرَآئِهِم","tr":"warāihim","en":"behind them","root":"وري","lem":"وَراء"},{"ar":"مُّحِيطٌۢ","tr":"muḥīṭun","en":"encompasses","root":"حوط","lem":"مُحِيط"}]},{