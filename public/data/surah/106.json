{"n":106,"name":"Quraysh","nameAr":"قريش","meaning":"Quraysh","ayahs":4,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"لِإِيلَـٰفِ قُرَيْشٍ","en":"For the accustomed security of the Quraysh -","w":[{"ar":"لِإِيلَـٰفِ","tr":"liīlāfi","en":"For (the) familiarity","root":"ألف","lem":"إِلاف"},{"ar":"قُرَيْشٍ","tr":"qurayshin","en":"(of the) Quraish","root":"قرش","lem":"قُرَيْش"}]},{"n":2,"juz":30,"ar":"إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ","en":"Their accustomed security [in] the caravan of winter and summer -","w":[{"ar":"إِۦلَـٰفِهِمْ","tr":"īlāfihim","en":"Their familiarity","root":"ألف","lem":"إِلاف"},{"ar":"رِحْلَةَ","tr":"riḥ'lata","en":"(with the) journey","root":"رحل","lem":"رِحْلَة"},{"ar":"ٱلشِّتَآءِ","tr":"l-shitāi","en":"(of) winter","root":"شتو","lem":"شِتاء"},{"ar":"وَٱلصَّيْفِ","tr":"wal-ṣayfi","en":"and summer","root":"صيف","lem":"صَيْف"}]},{"n":3,"juz":30,"ar":"فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ","en":"Let them worship the Lord of this House,","w":[{"ar":"فَلْيَعْبُدُوا۟","tr":"falyaʿbudū","en":"So let them worship","root":"عبد","lem":"عَبَدَ"},{"ar":"رَبَّ","tr":"rabba","en":"(the) Lord","root":"ربب","lem":"رَبّ"},{"ar":"هَـٰذَا","tr":"hādhā","en":"(of) this"},{"ar":"ٱلْبَيْتِ","tr":"l-bayti","en":"House","root":"بيت","lem":"بَيْت"}]},{"n":4,"juz":30,"ar":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ","en":"Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.","w":[{"ar":"ٱلَّذِىٓ","tr":"alladhī","en":"The One Who"},{"ar":"أَطْعَمَهُم","tr":"aṭʿamahum","en":"feeds them","root":"طعم","lem":"أَطْعَمَ"},{"ar":"مِّن","tr":"min","en":"[from]"},{"ar":"جُوعٍۢ","tr":"jūʿin","en":"(against) hunger","root":"جوع","lem":"جُوع"},{"ar":"وَءَامَنَهُم","tr":"waāmanahum","en":"and gives them security","root":"أمن","lem":"آمَنَ"},{"ar":"مِّنْ","tr":"min","en":"from"},{"ar":"خَوْفٍۭ","tr":"khawfin","en":"fear","root":"خوف","lem":"خَوْف"}]}]}