{"n":94,"name":"Ash-Sharh","nameAr":"الشرح","meaning":"The Relief","ayahs":8,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","en":"Did We not expand for you, [O Muḥammad], your breast?","w":[{"ar":"أَلَمْ","tr":"alam","en":"Have not"},{"ar":"نَشْرَحْ","tr":"nashraḥ","en":"We expanded","root":"شرح","lem":"شَرَحَ"},{"ar":"لَكَ","tr":"laka","en":"for you"},{"ar":"صَدْرَكَ","tr":"ṣadraka","en":"your breast","root":"صدر","lem":"صَدْر"}]},{"n":2,"juz":30,"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","en":"And We removed from you your burden","w":[{"ar":"وَوَضَعْنَا","tr":"wawaḍaʿnā","en":"And We removed","root":"وضع","lem":"وَضَعَ"},{"ar":"عَنكَ","tr":"ʿanka","en":"from you"},{"ar":"وِزْرَكَ","tr":"wiz'raka","en":"your burden","root":"وزر","lem":"وِزْر"}]},{"n":3,"juz":30,"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","en":"Which had weighed upon your back","w":[{"ar":"ٱلَّذِىٓ","tr":"alladhī","en":"Which"},{"ar":"أَنقَضَ","tr":"anqaḍa","en":"weighed upon","root":"نقض","lem":"أَنقَضَ"},{"ar":"ظَهْرَكَ","tr":"ẓahraka","en":"your back","root":"ظهر","lem":"ظَهْر"}]},{"n":4,"juz":30,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","en":"And raised high for you your repute.","w":[{"ar":"وَرَفَعْنَا","tr":"warafaʿnā","en":"And We raised high","root":"رفع","lem":"رَفَعَ"},{"ar":"لَكَ","tr":"laka","en":"for you"},{"ar":"ذِكْرَكَ","tr":"dhik'raka","en":"your reputation","root":"ذكر","lem":"ذِكْر"}]},{"n":5,"juz":30,"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","en":"For indeed, with hardship [will be] ease [i.e., relief].","w":[{"ar":"فَإِنَّ","tr":"fa-inna","en":"So indeed"},{"ar":"مَعَ","tr":"maʿa","en":"with"},{"ar":"ٱلْعُسْرِ","tr":"l-ʿus'ri","en":"the hardship","root":"عسر","lem":"عُسْر"},{"ar":"يُسْرًا","tr":"yus'ran","en":"(is) ease","root":"يسر","lem":"يُسْر"}]},{"n":6,"juz":30,"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","en":"Indeed, with hardship [will be] ease.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"مَعَ","tr":"maʿa","en":"with"},{"ar":"ٱلْعُسْرِ","tr":"l-ʿus'ri","e