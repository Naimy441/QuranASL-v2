{"n":107,"name":"Al-Ma'un","nameAr":"الماعون","meaning":"The Small kindnesses","ayahs":7,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","en":"Have you seen the one who denies the Recompense?","w":[{"ar":"أَرَءَيْتَ","tr":"ara-ayta","en":"Have you seen","root":"رأي","lem":"رَأَى"},{"ar":"ٱلَّذِى","tr":"alladhī","en":"the one who"},{"ar":"يُكَذِّبُ","tr":"yukadhibu","en":"denies","root":"كذب","lem":"كَذَّبَ"},{"ar":"بِٱلدِّينِ","tr":"bil-dīni","en":"the Judgment","root":"دين","lem":"دِين"}]},{"n":2,"juz":30,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","en":"For that is the one who drives away the orphan","w":[{"ar":"فَذَٰلِكَ","tr":"fadhālika","en":"Then that"},{"ar":"ٱلَّذِى","tr":"alladhī","en":"(is) the one who"},{"ar":"يَدُعُّ","tr":"yaduʿʿu","en":"repulses","root":"دعع","lem":"يَدُعُّ"},{"ar":"ٱلْيَتِيمَ","tr":"l-yatīma","en":"the orphan","root":"يتم","lem":"يَتِيم"}]},{"n":3,"juz":30,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","en":"And does not encourage the feeding of the poor.","w":[{"ar":"وَلَا","tr":"walā","en":"And (does) not"},{"ar":"يَحُضُّ","tr":"yaḥuḍḍu","en":"feel the urge","root":"حضض","lem":"يَحُضُّ"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"to"},{"ar":"طَعَامِ","tr":"ṭaʿāmi","en":"feed","root":"طعم","lem":"طَعام"},{"ar":"ٱلْمِسْكِينِ","tr":"l-mis'kīni","en":"the poor","root":"سكن","lem":"مِسْكِين"}]},{"n":4,"juz":30,"ar":"فَوَيْلٌ لِّلْمُصَلِّينَ","en":"So woe to those who pray","w":[{"ar":"فَوَيْلٌۭ","tr":"fawaylun","en":"So woe"},{"ar":"لِّلْمُصَلِّينَ","tr":"lil'muṣallīna","en":"to those who pray","root":"صلو","lem":"مُصَلّي"}]},{"n":5,"juz":30,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","en":"[But] who are heedless of their prayer -","w":[{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"Those who"},{"ar":"هُمْ","tr":"hum","en":"[they]"},{"ar":"عَن","tr":"ʿan","en":"about"},{"ar":"صَلَاتِهِمْ","tr":"ṣalātihim","en":"their prayers","root":"صلو","lem":"صَلاة"},{"ar":"سَاهُونَ","tr":"sāhūna","en":"(a