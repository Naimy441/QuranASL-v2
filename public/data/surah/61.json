{"n":61,"name":"As-Saf","nameAr":"الصف","meaning":"The Ranks","ayahs":14,"place":"madinah","bismillah":true,"ayat":[{"n":1,"juz":28,"ar":"سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","en":"Whatever is in the heavens and whatever is on the earth exalts Allāh, and He is the Exalted in Might, the Wise.","w":[{"ar":"سَبَّحَ","tr":"sabbaḥa","en":"Glorifies","root":"سبح","lem":"سَبَّحَ"},{"ar":"لِلَّهِ","tr":"lillahi","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"مَا","tr":"mā","en":"whatever"},{"ar":"فِى","tr":"fī","en":"(is) in"},{"ar":"ٱلسَّمَـٰوَٰتِ","tr":"l-samāwāti","en":"the heavens","root":"سمو","lem":"سَماء"},{"ar":"وَمَا","tr":"wamā","en":"and whatever"},{"ar":"فِى","tr":"fī","en":"(is) in"},{"ar":"ٱلْأَرْضِ ۖ","tr":"l-arḍi","en":"the earth","root":"أرض","lem":"أَرْض"},{"ar":"وَهُوَ","tr":"wahuwa","en":"And He"},{"ar":"ٱلْعَزِيزُ","tr":"l-ʿazīzu","en":"(is) the All-Mighty","root":"عزز","lem":"عَزِيز"},{"ar":"ٱلْحَكِيمُ","tr":"l-ḥakīmu","en":"the All-Wise","root":"حكم","lem":"حَكِيم"}]},{"n":2,"juz":28,"ar":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لِمَ تَقُولُونَ مَا لَا تَفْعَلُونَ","en":"O you who have believed, why do you say what you do not do?","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O","root":"أيي","lem":"أَيّ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"(you) who"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"believe","root":"أمن","lem":"آمَنَ"},{"ar":"لِمَ","tr":"lima","en":"Why"},{"ar":"تَقُولُونَ","tr":"taqūlūna","en":"(do) you say","root":"قول","lem":"قالَ"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"لَا","tr":"lā","en":"not"},{"ar":"تَفْعَلُونَ","tr":"tafʿalūna","en":"you do","root":"فعل","lem":"فَعَلَ"}]},{"n":3,"juz":28,"ar":"كَبُرَ مَقْتًا عِندَ ٱللَّهِ أَن تَقُولُوا۟ مَا لَا تَفْعَلُونَ","en":"Greatly hateful in the sight of Allāh is that you say what you do not do.","w":[{"ar":"كَبُرَ","tr":"kabura","en":"Great is","root":"كبر","lem":"كَبُرَ"},{"ar":"مَقْتًا","tr":"maqtan","en":"hatred","root":"مقت","lem":"مَقْت"},{"ar":"عِندَ","tr":"ʿinda","en":"with","root":"عند","lem":"عِند"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"تَقُولُوا۟","tr":"taqūlū","en":"you say","root":"قول","lem":"قالَ"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"لَا","tr":"lā","en":"not"},{"ar":"تَفْعَلُونَ","tr":"tafʿalūna","en":"you do","root":"فعل","lem":"فَعَلَ"}]},{"n":4,"juz":28,"ar":"إِنَّ ٱللَّهَ يُحِبُّ ٱلَّذِينَ يُقَـٰتِلُونَ فِى سَبِيلِهِۦ صَفًّا كَأَنَّهُم بُنْيَـٰنٌ مَّرْصُوصٌ","en":"Indeed, Allāh loves those who fight in His cause in a row as though they are a [single] structure joined firmly.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"يُحِبُّ","tr":"yuḥibbu","en":"loves","root":"حبب","lem":"أَحْبَبْ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"يُقَـٰتِلُونَ","tr":"yuqātilūna","en":"fight","root":"قتل","lem":"قاتَلَ"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"سَبِيلِهِۦ","tr":"sabīlihi","en":"His Way","root":"سبل","lem":"سَبِيل"},{"ar":"صَفًّۭا","tr":"ṣaffan","en":"(in) a row","root":"صفف","lem":"صَفّ"},{"ar":"كَأَنَّهُم","tr":"ka-annahum","en":"as if they"},{"ar":"بُنْيَـٰنٌۭ","tr":"bun'yānun","en":"(were) a structure","root":"بني","lem":"بُنْيان"},{"ar":"مَّرْصُوصٌۭ","tr":"marṣūṣun","en":"joined firmly","root":"رصص","lem":"مَرْصُوص"}]},{"n":5,"juz":28,"ar":"وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِۦ يَـٰقَوْمِ لِمَ تُؤْذُونَنِى وَقَد تَّعْلَمُونَ أَنِّى رَسُولُ ٱللَّهِ إِلَيْكُمْ ۖ فَلَمَّا زَاغُوٓا۟ أَزَاغَ ٱللَّهُ قُلُوبَهُمْ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلْفَـٰسِقِينَ","en":"And [mention, O Muḥammad], when Moses said to his people, \"O my people, why do you harm me while you certainly know that I am the messenger of Allāh to you?\" And when they deviated, Allāh caused their hearts to deviate. And Allāh does not guide the defiantly disobedient people.","w":[{"ar":"وَإِذْ","tr":"wa-idh","en":"And when"},{"ar":"قَالَ","tr":"qāla","en":"said","root":"قول","lem":"قالَ"},{"ar":"مُوسَىٰ","tr":"mūsā","en":"Musa"},{"ar":"لِقَوْمِهِۦ","tr":"liqawmihi","en":"to his people","root":"قوم","lem":"قَوْم"},{"ar":"يَـٰقَوْمِ","tr":"yāqawmi","en":"O my people","root":"قوم","lem":"قَوْم"},{"ar":"لِمَ","tr":"lima","en":"Why"},{"ar":"تُؤْذُونَنِى","tr":"tu'dhūnanī","en":"do you hurt me","root":"أذي","lem":"أُوذِيَ"},{"ar":"وَقَد","tr":"waqad","en":"while certainly"},{"ar":"تَّعْلَمُونَ","tr":"taʿlamūna","en":"you know","root":"علم","lem":"عَلِمَ"},{"ar":"أَنِّى","tr":"annī","en":"that I am"},{"ar":"رَسُولُ","tr":"rasūlu","en":"(the) Messenger","root":"رسل","lem":"رَسُول"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"(of) Allah","root":"أله","lem":"اللَّه"},{"ar":"إِلَيْكُمْ ۖ","tr":"ilaykum","en":"to you"},{"ar":"فَلَمَّا","tr":"falammā","en":"Then when"},{"ar":"زَاغُوٓا۟","tr":"zāghū","en":"they deviated","root":"زيغ","lem":"زاغَ"},{"ar":"أَزَاغَ","tr":"azāgha","en":"(was caused to) deviate","root":"زيغ","lem":"أَزاغَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"(by) Allah","root":"أله","lem":"اللَّه"},{"ar":"قُلُوبَهُمْ ۚ","tr":"qulūbahum","en":"their hearts","root":"قلب","lem":"قَلْب"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"لَا","tr":"lā","en":"(does) not"},{"ar":"يَهْدِى","tr":"yahdī","en":"guide","root":"هدي","lem":"هَدَى"},{"ar":"ٱلْقَوْمَ","tr":"l-qawma","en":"the people","root":"قوم","lem":"قَوْم"},{"ar":"ٱلْفَـٰسِقِينَ","tr":"l-fāsiqīna","en":"the defiantly disobedient","root":"فسق","lem":"فاسِق"}]},{"n":6,"juz":28,"ar":"وَإِذْ قَالَ عِيسَى ٱبْنُ مَرْيَمَ يَـٰبَنِىٓ إِسْرَٰٓءِيلَ إِنِّى رَسُولُ ٱللَّهِ إِلَيْكُم مُّصَدِّقًا لِّمَا بَيْنَ يَدَىَّ مِنَ ٱلتَّوْرَىٰةِ وَمُبَشِّرًۢا بِرَسُولٍ يَأْتِى مِنۢ بَعْدِى ٱسْمُهُۥٓ أَحْمَدُ ۖ فَلَمَّا جَآءَهُم بِٱلْبَيِّنَـٰتِ قَالُوا۟ هَـٰذَا سِحْرٌ مُّبِينٌ","en":"And [mention] when Jesus, the son of Mary, said, \"O Children of Israel, indeed I am the messenger of Allāh to you confirming what came before me of the Torah and bringing good tidings of a messenger to come after me, whose name is Aḥmad.\" But when he came to them with clear evidences, they said, \"This is obvious magic.\"","w":[{"ar":"وَإِذْ","tr":"wa-idh","en":"And when"},{"ar":"قَالَ","tr":"qāla","en":"said","root":"قول","lem":"قالَ"},{"ar":"عِيسَى","tr":"ʿīsā","en":"Isa"},{"ar":"ٱبْنُ","tr":"ub'nu","en":"son","root":"بني","lem":"ابْن"},{"ar":"مَرْيَمَ","tr":"maryama","en":"(of) Maryam"},{"ar":"يَـٰبَنِىٓ","tr":"yābanī","en":"O Children","root":"بني","lem":"بُنَىّ"},{"ar":"إِسْرَٰٓءِيلَ","tr":"is'rāīla","en":"(of) Israel"},{"ar":"إِنِّى","tr":"innī","en":"Indeed, I am"},{"ar":"رَسُولُ","tr":"rasūlu","en":"(the) Messenger","root":"رسل","lem":"رَسُول"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"(of) Allah","root":"أله","lem":"اللَّه"},{"ar":"إِلَيْكُم","tr":"ilaykum","en":"to you"},{"ar":"مُّصَدِّقًۭا","tr":"muṣaddiqan","en":"confirming","root":"صدق","lem":"مُصَدِّق"},{"ar":"لِّمَا","tr":"limā","en":"that which"},{"ar":"بَيْنَ","tr":"bayna","en":"(was) between","root":"بين","lem":"بَيْن"},{"ar":"يَدَىَّ","tr":"yadayya","en":"my hands","root":"يدي","lem":"يَد"},{"ar":"مِنَ","tr":"mina","en":"of"},{"ar":"ٱلتَّوْرَىٰةِ","tr":"l-tawrāti","en":"the Taurat"},{"ar":"وَمُبَشِّرًۢا","tr":"wamubashiran","en":"and bringing glad tidings","root":"بشر","lem":"مُبَشِّر"},{"ar":"بِرَسُولٍۢ","tr":"birasūlin","en":"(of) a Messenger","root":"رسل","lem":"رَسُول"},{"ar":"يَأْتِى","tr":"yatī","en":"to come","root":"أتي","lem":"أَتَى"},{"ar":"مِنۢ","tr":"min","en":"from"},{"ar":"بَعْدِى","tr":"baʿdī","en":"after me","root":"بعد","lem":"بَعْد"},{"ar":"ٱسْمُهُۥٓ","tr":"us'muhu","en":"whose name (will be)","root":"سمو","lem":"اسْم"},{"ar":"أَحْمَدُ ۖ","tr":"aḥmadu","en":"Ahmad","root":"حمد","lem":"أَحْمَد"},{"ar":"فَلَمَّا","tr":"falammā","en":"But when"},{"ar":"جَآءَهُم","tr":"jāahum","en":"he came to them","root":"جيأ","lem":"جاءَ"},{"ar":"بِٱلْبَيِّنَـٰتِ","tr":"bil-bayināti","en":"with clear proofs","root":"بين","lem":"بَيِّنَة"},{"ar":"قَالُوا۟","tr":"qālū","en":"they said","root":"قول","lem":"قالَ"},{"ar":"هَـٰذَا","tr":"hādhā","en":"This"},{"ar":"سِحْرٌۭ","tr":"siḥ'run","en":"(is) a magic","root":"سحر","lem":"سِحْر"},{"ar":"مُّبِينٌۭ","tr":"mubīnun","en":"clear","root":"بين","lem":"مُبِين"}]},{"n":7,"juz":28,"ar":"وَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ ٱلْكَذِبَ وَهُوَ يُدْعَىٰٓ إِلَى ٱلْإِسْلَـٰمِ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّـٰلِمِينَ","en":"And who is more unjust than one who invents about Allāh untruth while he is being invited to Islām. And Allāh does not guide the wrongdoing people.","w":[{"ar":"وَمَنْ","tr":"waman","en":"And who"},{"ar":"أَظْلَمُ","tr":"aẓlamu","en":"(is) more wrong","root":"ظلم","lem":"أَظْلَم"},{"ar":"مِمَّنِ","tr":"mimmani","en":"than (one) who"},{"ar":"ٱفْتَرَىٰ","tr":"if'tarā","en":"invents","root":"فري","lem":"افْتَرَى"},{"ar":"عَلَى","tr":"ʿalā","en":"upon"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"ٱلْكَذِبَ","tr":"l-kadhiba","en":"the lie","root":"كذب","lem":"كَذِب"},{"ar":"وَهُوَ","tr":"wahuwa","en":"while he"},{"ar":"يُدْعَىٰٓ","tr":"yud'ʿā","en":"is invited","root":"دعو","lem":"دَعا"},{"ar":"إِلَى","tr":"ilā","en":"to"},{"ar":"ٱلْإِسْلَـٰمِ ۚ","tr":"l-is'lāmi","en":"Islam","root":"سلم","lem":"إِسْلام"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"لَا","tr":"lā","en":"(does) not"},{"ar":"يَهْدِى","tr":"yahdī","en":"guide","root":"هدي","lem":"هَدَى"},{"ar":"ٱلْقَوْمَ","tr":"l-qawma","en":"the people","root":"قوم","lem":"قَوْم"},{"ar":"ٱلظَّـٰلِمِينَ","tr":"l-ẓālimīna","en":"[the] wrongdoers","root":"ظلم","lem":"ظالِم"}]},{"n":8,"juz":28,"ar":"يُرِيدُونَ لِيُطْفِـُٔوا۟ نُورَ ٱللَّهِ بِأَفْوَٰهِهِمْ وَٱللَّهُ مُتِمُّ نُورِهِۦ وَلَوْ كَرِهَ ٱلْكَـٰفِرُونَ","en":"They want to extinguish the light of Allāh with their mouths, but Allāh will perfect His light, although the disbelievers dislike it.","w":[{"ar":"يُرِيدُونَ","tr":"yurīdūna","en":"They intend","root":"رود","lem":"أَرادَ"},{"ar":"لِيُطْفِـُٔوا۟","tr":"liyuṭ'fiū","en":"to put out","root":"طفأ","lem":"أَطْفَأَ"},{"ar":"نُورَ","tr":"nūra","en":"(the) light","root":"نور","lem":"نُور"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"(of) Allah","root":"أله","lem":"اللَّه"},{"ar":"بِأَفْوَٰهِهِمْ","tr":"bi-afwāhihim","en":"with their mouths","root":"فوه","lem":"أَفْواه"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"but Allah","root":"أله","lem":"اللَّه"},{"ar":"مُتِمُّ","tr":"mutimmu","en":"will perfect","root":"تمم","lem":"مُتِمّ"},{"ar":"نُورِهِۦ","tr":"nūrihi","en":"His Light","root":"نور","lem":"نُور"},{"ar":"وَلَوْ","tr":"walaw","en":"although"},{"ar":"كَرِهَ","tr":"kariha","en":"dislike","root":"كره","lem":"كَرِهَ"},{"ar":"ٱلْكَـٰفِرُونَ","tr":"l-kāfirūna","en":"the disbelievers","root":"كفر","lem":"كافِر"}]},{"n":9,"juz":28,"ar":"هُوَ ٱلَّذِىٓ أَرْسَلَ رَسُولَهُۥ بِٱلْهُدَىٰ وَدِينِ ٱلْحَقِّ لِيُظْهِرَهُۥ عَلَى ٱلدِّينِ كُلِّهِۦ وَلَوْ كَرِهَ ٱلْمُشْرِكُونَ","en":"It is He who sent His Messenger with guidance and the religion of truth to manifest it over all religion, although those who associate others with Allāh dislike it.","w":[{"ar":"هُوَ","tr":"huwa","en":"He"},{"ar":"ٱلَّذِىٓ","tr":"alladhī","en":"(is) the One Who"},{"ar":"أَرْسَلَ","tr":"arsala","en":"sent","root":"رسل","lem":"أَرْسَلَ"},{"ar":"رَسُولَهُۥ","tr":"rasūlahu","en":"His Messenger","root":"رسل","lem":"رَسُول"},{"ar":"بِٱلْهُدَىٰ","tr":"bil-hudā","en":"with guidance","root":"هدي","lem":"هُدًى"},{"ar":"وَدِينِ","tr":"wadīni","en":"and (the) religion","root":"دين","lem":"دِين"},{"ar":"ٱلْحَقِّ","tr":"l-ḥaqi","en":"(of) the truth","root":"حقق","lem":"حَقّ"},{"ar":"لِيُظْهِرَهُۥ","tr":"liyuẓ'hirahu","en":"to make it prevail","root":"ظهر","lem":"أَظْهَرَ"},{"ar":"عَلَى","tr":"ʿalā","en":"over"},{"ar":"ٱلدِّينِ","tr":"l-dīni","en":"the religion","root":"دين","lem":"دِين"},{"ar":"كُلِّهِۦ","tr":"kullihi","en":"all of them","root":"كلل","lem":"كُلّ"},{"ar":"وَلَوْ","tr":"walaw","en":"although"},{"ar":"كَرِهَ","tr":"kariha","en":"dislike (it)","root":"كره","lem":"كَرِهَ"},{"ar":"ٱلْمُشْرِكُونَ","tr":"l-mush'rikūna","en":"the polytheists","root":"شرك","lem":"مُشْرِك"}]},{"n":10,"juz":28,"ar":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ هَلْ أَدُلُّكُمْ عَلَىٰ تِجَـٰرَةٍ تُنجِيكُم مِّنْ عَذَابٍ أَلِيمٍ","en":"O you who have believed, shall I guide you to a transaction that will save you from a painful punishment?","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O","root":"أيي","lem":"أَيّ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"(you) who"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"believe","root":"أمن","lem":"آمَنَ"},{"ar":"هَلْ","tr":"hal","en":"Shall"},{"ar":"أَدُلُّكُمْ","tr":"adullukum","en":"I guide you","root":"دلل","lem":"دَلَّ"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"to"},{"ar":"تِجَـٰرَةٍۢ","tr":"tijāratin","en":"a transaction","root":"تجر","lem":"تِجارَة"},{"ar":"تُنجِيكُم","tr":"tunjīkum","en":"(that) will save you","root":"نجو","lem":"أَنجَى"},{"ar":"مِّنْ","tr":"min","en":"from"},{"ar":"عَذَابٍ","tr":"ʿadhābin","en":"a punishment","root":"عذب","lem":"عَذاب"},{"ar":"أَلِيمٍۢ","tr":"alīmin","en":"painful","root":"ألم","lem":"أَلِيم"}]},{"n":11,"juz":28,"ar":"تُؤْمِنُونَ بِٱللَّهِ وَرَسُولِهِۦ وَتُجَـٰهِدُونَ فِى سَبِيلِ ٱللَّهِ بِأَمْوَٰلِكُمْ وَأَنفُسِكُمْ ۚ ذَٰلِكُمْ خَيْرٌ لَّكُمْ إِن كُنتُمْ تَعْلَمُونَ","en":"[It is that] you believe in Allāh and His Messenger and strive in the cause of Allāh with your wealth and your lives. That is best for you, if you only knew.","w":[{"ar":"تُؤْمِنُونَ","tr":"tu'minūna","en":"Believe","root":"أمن","lem":"آمَنَ"},{"ar":"بِٱللَّهِ","tr":"bil-lahi","en":"in Allah","root":"أله","lem":"اللَّه"},{"ar":"وَرَسُولِهِۦ","tr":"warasūlihi","en":"and His Messenger","root":"رسل","lem":"رَسُول"},{"ar":"وَتُجَـٰهِدُونَ","tr":"watujāhidūna","en":"and strive","root":"جهد","lem":"جاهَدَ"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"سَبِيلِ","tr":"sabīli","en":"(the) way","root":"سبل","lem":"سَبِيل"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"(of) Allah","root":"أله","lem":"اللَّه"},{"ar":"بِأَم