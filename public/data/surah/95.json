{"n":95,"name":"At-Tin","nameAr":"التين","meaning":"The Fig","ayahs":8,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"وَٱلتِّينِ وَٱلزَّيْتُونِ","en":"By the fig and the olive","w":[{"ar":"وَٱلتِّينِ","tr":"wal-tīni","en":"By the fig","root":"تين","lem":"تِين"},{"ar":"وَٱلزَّيْتُونِ","tr":"wal-zaytūni","en":"and the olive","root":"زيت","lem":"زَيْتُون"}]},{"n":2,"juz":30,"ar":"وَطُورِ سِينِينَ","en":"And [by] Mount Sinai","w":[{"ar":"وَطُورِ","tr":"waṭūri","en":"And (the) Mount","root":"طور","lem":"طُور"},{"ar":"سِينِينَ","tr":"sīnīna","en":"Sinai"}]},{"n":3,"juz":30,"ar":"وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","en":"And [by] this secure city [i.e., Makkah],","w":[{"ar":"وَهَـٰذَا","tr":"wahādhā","en":"And this"},{"ar":"ٱلْبَلَدِ","tr":"l-baladi","en":"[the] city","root":"بلد","lem":"بَلَد"},{"ar":"ٱلْأَمِينِ","tr":"l-amīni","en":"[the] secure","root":"أمن","lem":"أَمِين"}]},{"n":4,"juz":30,"ar":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ","en":"We have certainly created man in the best of stature;","w":[{"ar":"لَقَدْ","tr":"laqad","en":"Indeed"},{"ar":"خَلَقْنَا","tr":"khalaqnā","en":"We created","root":"خلق","lem":"خَلَقَ"},{"ar":"ٱلْإِنسَـٰنَ","tr":"l-insāna","en":"man","root":"أنس","lem":"إِنسان"},{"ar":"فِىٓ","tr":"fī","en":"in"},{"ar":"أَحْسَنِ","tr":"aḥsani","en":"(the) best","root":"حسن","lem":"أَحْسَن"},{"ar":"تَقْوِيمٍۢ","tr":"taqwīmin","en":"mould","root":"قوم","lem":"تَقْوِيم"}]},{"n":5,"juz":30,"ar":"ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ","en":"Then We return him to the lowest of the low,","w":[{"ar":"ثُمَّ","tr":"thumma","en":"Then"},{"ar":"رَدَدْنَـٰهُ","tr":"radadnāhu","en":"We returned him","root":"ردد","lem":"رَدَّ"},{"ar":"أَسْفَلَ","tr":"asfala","en":"(to the) lowest","root":"سفل","lem":"أَسْفَل"},{"ar":"سَـٰفِلِينَ","tr":"sāfilīna","en":"(of the) low","root":"سفل","lem":"سافِل"}]},{"n":6,"juz":30,"ar":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","en":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","w":[{"ar":"إِلَّا","tr":"illā","en":"Except"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"believe","root":"أمن","lem":"آمَنَ"},{"ar":"وَعَمِلُوا۟","tr":"waʿamilū","en":"and do","root":"عمل","lem":"عَمِلَ"},{"ar":"ٱلصَّـٰلِحَـٰتِ","tr":"l-ṣāliḥāti","en":"righteous deeds","root":"صلح","lem":"صالِحَة"},{"ar":"فَلَهُمْ","tr":"falahum","en":"then for them"},{"ar":"أَجْرٌ","tr":"ajrun","en":"(is a) reward","root":"أجر","lem":"أَجْر"},{"ar":"غَيْرُ","tr":"ghayru","en":"never","root":"غير","lem":"غَيْر"},{"ar":"مَمْنُونٍۢ","tr":"mamnūnin","en":"ending","root":"منن","lem":"مَمْنُون"}]},{"n":7,"juz":30,"ar":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","en":"So what yet causes you to deny the Recompense?","w":[{"ar":"فَمَا","tr":"famā","en":"Then what"},{"ar":"يُكَذِّبُكَ","tr":"yukadhibuka","en":"causes you to deny","root":"كذب","lem":"كَذَّبَ"},{"ar":"بَعْدُ","tr":"baʿdu","en":"after (this)","root":"بعد","lem":"بَعْد"},{"ar":"بِٱلدِّينِ","tr":"bil-dīni","en":"the judgment","root":"دين","lem":"دِين"}]},{"n":8,"juz":30,"ar":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ","en":"Is not Allāh the most just of judges?","w":[{"ar":"أَلَيْسَ","tr":"alaysa","en":"Is not","root":"ليس","lem":"لَيْسَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"بِأَحْكَمِ","tr":"bi-aḥkami","en":"(the) Most Just","root":"حكم","lem":"أَحْكَم"},{"ar":"ٱلْحَـٰكِمِينَ","tr":"l-ḥākimīna","en":"(of) the Judges","root":"حكم","lem":"حاكِم"}]}]}