{"n":103,"name":"Al-'Asr","nameAr":"العصر","meaning":"The Declining Day","ayahs":3,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"وَٱلْعَصْرِ","en":"By time,","w":[{"ar":"وَٱلْعَصْرِ","tr":"wal-ʿaṣri","en":"By the time","root":"عصر","lem":"عَصْر"}]},{"n":2,"juz":30,"ar":"إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ","en":"Indeed, mankind is in loss,","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱلْإِنسَـٰنَ","tr":"l-insāna","en":"mankind","root":"أنس","lem":"إِنسان"},{"ar":"لَفِى","tr":"lafī","en":"(is) surely, in"},{"ar":"خُسْرٍ","tr":"khus'rin","en":"loss","root":"خسر","lem":"خُسْر"}]},{"n":3,"juz":30,"ar":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","en":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","w":[{"ar":"إِلَّا","tr":"illā","en":"Except"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"believe","root":"أمن","lem":"آمَنَ"},{"ar":"وَعَمِلُوا۟","tr":"waʿamilū","en":"and do","root":"عمل","lem":"عَمِلَ"},{"ar":"ٱلصَّـٰلِحَـٰتِ","tr":"l-ṣāliḥāti","en":"righteous deeds","root":"صلح","lem":"صالِحَة"},{"ar":"وَتَوَاصَوْا۟","tr":"watawāṣaw","en":"and enjoin (each other)","root":"وصي","lem":"تَواصَ"},{"ar":"بِٱلْحَقِّ","tr":"bil-ḥaqi","en":"to the truth","root":"حقق","lem":"حَقّ"},{"ar":"وَتَوَاصَوْا۟","tr":"watawāṣaw","en":"and enjoin (each other)","root":"وصي","lem":"تَواصَ"},{"ar":"بِٱلصَّبْرِ","tr":"bil-ṣabri","en":"to [the] patience","root":"صبر","lem":"صَبْر"}]}]}