{"n":75,"name":"Al-Qiyamah","nameAr":"القيامة","meaning":"The Resurrection","ayahs":40,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":29,"ar":"لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ","en":"I swear by the Day of Resurrection","w":[{"ar":"لَآ","tr":"lā","en":"Nay"},{"ar":"أُقْسِمُ","tr":"uq'simu","en":"I swear","root":"قسم","lem":"أَقْسَمُ"},{"ar":"بِيَوْمِ","tr":"biyawmi","en":"by (the) Day","root":"يوم","lem":"يَوْم"},{"ar":"ٱلْقِيَـٰمَةِ","tr":"l-qiyāmati","en":"(of) the Resurrection","root":"قوم","lem":"قِيامَة"}]},{"n":2,"juz":29,"ar":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","en":"And I swear by the reproaching soul [to the certainty of resurrection].","w":[{"ar":"وَلَآ","tr":"walā","en":"And nay"},{"ar":"أُقْسِمُ","tr":"uq'simu","en":"I swear","root":"قسم","lem":"أَقْسَمُ"},{"ar":"بِٱلنَّفْسِ","tr":"bil-nafsi","en":"by the soul","root":"نفس","lem":"نَفْس"},{"ar":"ٱللَّوَّامَةِ","tr":"l-lawāmati","en":"self-accusing","root":"لوم","lem":"لَوّامَة"}]},{"n":3,"juz":29,"ar":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","en":"Does man think that We will not assemble his bones?","w":[{"ar":"أَيَحْسَبُ","tr":"ayaḥsabu","en":"Does think","root":"حسب","lem":"حَسِبَ"},{"ar":"ٱلْإِنسَـٰنُ","tr":"l-insānu","en":"[the] man","root":"أنس","lem":"إِنسان"},{"ar":"أَلَّن","tr":"allan","en":"that not"},{"ar":"نَّجْمَعَ","tr":"najmaʿa","en":"We will assemble","root":"جمع","lem":"جَمَعَ"},{"ar":"عِظَامَهُۥ","tr":"ʿiẓāmahu","en":"his bones","root":"عظم","lem":"عِظام"}]},{"n":4,"juz":29,"ar":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","en":"Yes. [We are] Able [even] to proportion his fingertips.","w":[{"ar":"بَلَىٰ","tr":"balā","en":"Nay"},{"ar":"قَـٰدِرِينَ","tr":"qādirīna","en":"(We are) Able","root":"قدر","lem":"قادِر"},{"ar":"عَلَىٰٓ","tr":"ʿalā","en":"on"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"نُّسَوِّىَ","tr":"nusawwiya","en":"We can restore","root":"سوي","lem":"سَوَّى"},{"ar":"بَنَانَهُۥ","tr":"banānahu","en":"his fingertips","root":"بنن","lem":"بَنان"}]},{"n":5,"juz":29,"ar":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ","en":"But man desires to continue in sin.","w":[{"ar":"بَلْ","tr":"bal","en":"Nay"},{"ar":"يُرِيدُ","tr":"yurīdu","en":"Desires","root":"رود","lem":"أَرادَ"},{"ar":"ٱلْإِنسَـٰنُ","tr":"l-insānu","en":"[the] man","root":"أنس","lem":"إِنسان"},{"ar":"لِيَفْجُرَ","tr":"liyafjura","en":"to give (the) lie","root":"فجر","lem":"يَفْجُرَ"},{"ar":"أَمَامَهُۥ","tr":"amāmahu","en":"(to) what is before him","root":"أمم","lem":"أَمام"}]},{"n":6,"juz":29,"ar":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ","en":"He asks, \"When is the Day of Resurrection?\"","w":[{"ar":"يَسْـَٔلُ","tr":"yasalu","en":"He asks","root":"سأل","lem":"سَأَلَ"},{"ar":"أَيَّانَ","tr":"ayyāna","en":"When"},{"ar":"يَوْمُ","tr":"yawmu","en":"(is the) Day","root":"يوم","lem":"يَوْم"},{"ar":"ٱلْقِيَـٰمَةِ","tr":"l-qiyāmati","en":"(of) the Resurrection","root":"قوم","lem":"قِيامَة"}]},{"n":7,"juz":29,"ar":"فَإِذَا بَرِقَ ٱلْبَصَرُ","en":"So when vision is dazzled.","w":[{"ar":"فَإِذَا","tr":"fa-idhā","en":"So when"},{"ar":"بَرِقَ","tr":"bariqa","en":"is dazzled","root":"برق","lem":"بَرِقَ"},{"ar":"ٱلْبَصَرُ","tr":"l-baṣaru","en":"the vision","root":"بصر","lem":"بَصَر"}]},{"n":8,"juz":29,"ar":"وَخَسَفَ ٱلْقَمَرُ","en":"And the moon darkens.","w":[{"ar":"وَخَسَفَ","tr":"wakhasafa","en":"And becomes dark","root":"خسف","lem":"خَسَفَ"},{"ar":"ٱلْقَمَرُ","tr":"l-qamaru","en":"the moon","root":"قمر","lem":"قَمَر"}]},{"n":9,"juz":29,"ar":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","en":"And the sun and the moon are joined,","w":[{"ar":"وَجُمِعَ","tr":"wajumiʿa","en":"And are joined","root":"جمع","lem":"جَمَعَ"},{"ar":"ٱلشَّمْسُ","tr":"l-shamsu","en":"the sun","root":"شمس","lem":"شَمْس"},{"ar":"وَٱلْقَمَرُ","tr":"wal-qamaru","en":"and the moon","root":"قمر","lem":"قَمَر"}]},{"n":10,"juz":29,"ar":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","en":"Man will say on that Day, \"Where is the [place of] escape?\"","w":[{"ar":"يَقُولُ","tr":"yaqūlu","en":"Will say","root":"قول","lem":"قالَ"},{"ar":"ٱلْإِنسَـٰنُ","tr":"l-insānu","en":"[the] man","root":"أنس","lem":"إِنسان"},{"ar":"يَوْمَئِذٍ","tr":"yawma-idhin","en":"that Day","root":"يوم","lem":"يَوْم"},{"ar":"أَيْنَ","tr":"ayna","en":"Where"},{"ar":"ٱلْمَفَرُّ","tr":"l-mafaru","en":"(is) the escape","root":"فرر","lem":"مَفَرّ"}]},{"n":11,"juz":29,"ar":"كَلَّا لَا وَزَرَ","en":"No! There is no refuge.","w":[{"ar":"كَلَّا","tr":"kallā","en":"By no means"},{"ar":"لَا","tr":"lā","en":"(There is) no"},{"ar":"وَزَرَ","tr":"wazara","en":"refuge","root":"وزر","lem":"وَزَر"}]},{"n":12,"juz":29,"ar":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","en":"To your Lord, that Day, is the [place of] permanence.","w":[{"ar":"إِلَىٰ","tr":"ilā","en":"To"},{"ar":"رَبِّكَ","tr":"rabbika","en":"your Lord","root":"ربب","lem":"رَبّ"},{"ar":"يَوْمَئِذٍ","tr":"yawma-idhin","en":"that Day","root":"يوم","lem":"يَوْم"},{"ar":"ٱلْمُسْتَقَرُّ","tr":"l-mus'taqaru","en":"(is) the place of rest","root":"قرر","lem":"مُسْتَقَرّ"}]},{"n":13,"juz":29,"ar":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","en":"Man will be informed that Day of what he sent ahead and kept back.","w":[{"ar":"يُنَبَّؤُا۟","tr":"yunabba-u","en":"Will be informed","root":"نبأ","lem":"نَبَّأَ"},{"ar":"ٱلْإِنسَـٰنُ","tr":"l-insānu","en":"[the] man","root":"أنس","lem":"إِنسان"},{"ar":"يَوْمَئِذٍۭ","tr":"yawma-idhin","en":"that Day","root":"يوم","lem":"يَوْم"},{"ar":"بِمَا","tr":"bimā","en":"of what"},{"ar":"قَدَّمَ","tr":"qaddama","en":"he sent forth","root":"قدم","lem":"قَدَّمَ"},{"ar":"وَأَخَّرَ","tr":"wa-akhara","en":"and kept back","root":"أخر","lem":"أَخَّرَ"}]},{"n":14,"juz":29,"ar":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","en":"Rather, man, against himself, will be a witness,","w":[{"ar":"بَلِ","tr":"bali","en":"Nay"},{"ar":"ٱلْإِنسَـٰنُ","tr":"l-insānu","en":"[The] man","root":"أنس","lem":"إِنسان"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"against"},{"ar":"نَفْسِهِۦ","tr":"nafsihi","en":"himself","root":"نفس","lem":"نَفْس"},{"ar":"بَصِيرَةٌۭ","tr":"baṣīratun","en":"(will be) a witness","root":"بصر","lem":"بَصِيرَة"}]},{"n":15,"juz":29,"ar":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","en":"Even if he presents his excuses.","w":[{"ar":"وَلَوْ","tr":"walaw","en":"Even if"},{"ar":"أَلْقَىٰ","tr":"alqā","en":"he presents","root":"لقي","lem":"أَلْقَى"},{"ar":"مَعَاذِيرَهُۥ","tr":"maʿādhīrahu","en":"his excuses","root":"عذر","lem":"مَعاذِير"}]},{"n":16,"juz":29,"ar":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","en":"Move not your tongue with it, [O Muḥammad], to hasten with it [i.e., recitation of the Qur’ān].","w":[{"ar":"لَا","tr":"lā","en":"Not"},{"ar":"تُحَرِّكْ","tr":"tuḥarrik","en":"move","root":"حرك","lem":"تُحَرِّكْ"},{"ar":"بِهِۦ","tr":"bihi","en":"with it"},{"ar":"لِسَانَكَ","tr":"lisānaka","en":"your tongue","root":"لسن","lem":"لِسان"},{"ar":"لِتَعْجَلَ","tr":"litaʿjala","en":"to hasten","root":"عجل","lem":"عَجِلَ"},{"ar":"بِهِۦٓ","tr":"bihi","en":"with it"}]},{"n":17,"juz":29,"ar":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","en":"Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"عَلَيْنَا","tr":"ʿalaynā","en":"upon Us"},{"ar":"جَمْعَهُۥ","tr":"jamʿahu","en":"(is) its collection","root":"جمع","lem":"جَمْع"},{"ar":"وَقُرْءَانَهُۥ","tr":"waqur'ānahu","en":"and its recitation","root":"قرأ","lem":"قُرْءان"}]},{"n":18,"juz":29,"ar":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","en":"So when We have recited it [through Gabriel], then follow its recitation.","w":[{"ar":"فَإِذَا","tr":"fa-idhā","en":"And when"},{"ar":"قَرَأْنَـٰهُ","tr":"qaranāhu","en":"We have recited it","root":"قرأ","lem":"قَرَأَ"},{"ar":"فَٱتَّبِعْ","tr":"fa-ittabiʿ","en":"then follow","root":"تبع","lem":"اتَّبَعَ"},{"ar":"قُرْءَانَهُۥ","tr":"qur'ānahu","en":"its recitation","root":"قرأ","lem":"قُرْءان"}]},{"n":19,"juz":29,"ar":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","en":"Then upon Us is its clarification [to you].","w":[{"ar":"ثُمَّ","tr":"thumma","en":"Then"},{"ar":"إِنَّ","tr":"inna","en":"indeed"},{"ar":"عَلَيْنَا","tr":"ʿalaynā","en":"upon Us"},{"ar":"بَيَانَهُۥ","tr":"bayānahu","en":"(is) its explanation","root":"بين","lem":"بَيان"}]},{"n":20,"juz":29,"ar":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","en":"No! But you [i.e., mankind] love the immediate","w":[{"ar":"كَلَّا","tr":"kallā","en":"No"},{"ar":"بَلْ","tr":"bal","en":"But"},{"ar":"تُحِبُّونَ","tr":"tuḥibbūna","en":"you love","root":"حبب","lem":"أَحْبَبْ"},{"ar":"ٱلْعَاجِلَةَ","tr":"l-ʿājilata","en":"the immediate","root":"عجل","lem":"عاجِلَة"}]},{"n":21,"juz":29,"ar":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ","en":"And leave [i.e., neglect] the Hereafter.","w":[{"ar":"وَتَذَرُونَ","tr":"watadharūna","en":"And leave","root":"وذر","lem":"يَذَرَ"},{"ar":"ٱلْـَٔاخِرَةَ","tr":"l-ākhirata","en":"the Hereafter","root":"أخر","lem":"آخِر"}]},{"n":22,"juz":29,"ar":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","en":"[Some] faces, that Day, will be radiant,","w":[{"ar":"وُجُوهٌۭ","tr":"wujūhun","en":"Faces","root":"وجه","lem":"وَجْه"},{"ar":"يَوْمَئِذٍۢ","tr":"yawma-idhin","en":"that Day","root":"يوم","lem":"يَوْم"},{"ar":"نَّاضِرَةٌ","tr":"nāḍiratun","en":"(will be) radiant","root":"نضر","lem":"ناضِرَة"}]},{"n":23,"juz":29,"ar":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","en":"Looking at their Lord.","w":[{"ar":"إِلَىٰ","tr":"ilā","en":"Towards"},{"ar":"رَبِّهَا","tr":"rabbihā","en":"their Lord","root":"ربب","lem":"رَبّ"},{"ar":"نَاظِرَةٌۭ","tr":"nāẓiratun","en":"looking","root":"نظر","lem":"ناظِرَة"}]},{"n":24,"juz":29,"ar":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","en":"And [some] faces, that Day, will be contorted,","w":[{"ar":"وَوُجُوهٌۭ","tr":"wawujūhun","en":"And faces","root":"وجه","lem":"وَجْه"},{"ar":"يَوْمَئِذٍۭ","tr":"yawma-idhin","en":"that Day","root":"يوم","lem":"يَوْم"},{"ar":"بَاسِرَةٌۭ","tr":"bāsiratun","en":"(will be) distorted","root":"بسر","lem":"باسِرَة"}]},{"n":25,"juz":29,"ar":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","en":"Expecting that there will be done to them [something] backbreaking.","w":[{"ar":"تَظُنُّ","tr":"taẓunnu","en":"Thinking","root":"ظنن","lem":"ظَنَّ"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"يُفْعَلَ","tr":"yuf'ʿala","en":"will be done","root":"فعل","lem":"فَعَلَ"},{"ar":"بِهَا","tr":"bihā","en":"to them"},{"ar":"فَاقِرَةٌۭ","tr":"fāqiratun","en":"backbreaking","root":"فقر","lem":"فاقِرَة"}]},{"n":26,"juz":29,"ar":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","en":"No! When it [i.e., the soul] has reached the collar bones","w":[{"ar":"كَلَّآ","tr":"kallā","en":"No"},{"ar":"إِذَا","tr":"idhā","en":"When"},{"ar":"بَلَغَتِ","tr":"balaghati","en":"it reaches","root":"بلغ","lem":"بَلَغَ"},{"ar":"ٱلتَّرَاقِىَ","tr":"l-tarāqiya","en":"the collar bones","root":"ترق","lem":"تَراقِي"}]},{"n":27,"juz":29,"ar":"وَقِيلَ مَنْ ۜ رَاقٍ","en":"And it is said, \"Who will cure [him]?\"","w":[{"ar":"وَقِيلَ","tr":"waqīla","en":"And it is said","root":"قول","lem":"قالَ"},{"ar":"مَنْ ۜ","tr":"man","en":"Who"},{"ar":"رَاقٍۢ","tr":"rāqin","en":"(will) cure","root":"رقي","lem":"راق"}]},{"n":28,"juz":29,"ar":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","en":"And he [i.e., the dying one] is certain that it is the [time of] separation","w":[{"ar":"وَظَنَّ","tr":"waẓanna","en":"And he is certain","root":"ظنن","lem":"ظَنَّ"},{"ar":"أَنَّهُ","tr":"annahu","en":"that it"},{"ar":"ٱلْفِرَاقُ","tr":"l-firāqu","en":"(is) the parting","root":"فرق","lem":"فِراق"}]},{"n":29,"juz":29,"ar":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","en":"And the leg is wound about the leg,","w":[{"ar":"وَٱلْتَفَّتِ","tr":"wal-tafati","en":"And is wound","root":"لفف","lem":"الْتَفَّتِ"},{"ar":"ٱلسَّاقُ","tr":"l-sāqu","en":"the leg","root":"سوق","lem":"ساق"},{"ar":"بِٱلسَّاقِ","tr":"bil-sāqi","en":"about the leg","root":"سوق","lem":"ساق"}]},{"n":30,"juz":29,"ar":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","en":"To your Lord, that Day, will be the procession.","w":[{"ar":"إِلَىٰ","tr":"ilā","en":"To"},{"ar":"رَبِّكَ","tr":"rabbika","en":"your Lord","root":"ربب","lem":"رَبّ"},{"ar":"يَوْمَئِذٍ","tr":"yawma-idhin",