":"مِّنَ","tr":"mina","en":"of"},{"ar":"ٱلْأَمْرِ","tr":"l-amri","en":"the matter","root":"أمر","lem":"أَمْر"},{"ar":"لَعَنِتُّمْ","tr":"laʿanittum","en":"surely you would be in difficulty","root":"عنت","lem":"عَنِ"},{"ar":"وَلَـٰكِنَّ","tr":"walākinna","en":"but"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"حَبَّبَ","tr":"ḥabbaba","en":"has endeared","root":"حبب","lem":"حَبَّبَ"},{"ar":"إِلَيْكُمُ","tr":"ilaykumu","en":"to you"},{"ar":"ٱلْإِيمَـٰنَ","tr":"l-īmāna","en":"the Faith","root":"أمن","lem":"إِيمان"},{"ar":"وَزَيَّنَهُۥ","tr":"wazayyanahu","en":"and has made it pleasing","root":"زين","lem":"زَيَّنَ"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"قُلُوبِكُمْ","tr":"qulūbikum","en":"your hearts","root":"قلب","lem":"قَلْب"},{"ar":"وَكَرَّهَ","tr":"wakarraha","en":"and has made hateful","root":"كره","lem":"كَرَّهَ"},{"ar":"إِلَيْكُمُ","tr":"ilaykumu","en":"to you"},{"ar":"ٱلْكُفْرَ","tr":"l-kuf'ra","en":"disbelief","root":"كفر","lem":"كُفْر"},{"ar":"وَٱلْفُسُوقَ","tr":"wal-fusūqa","en":"and defiance","root":"فسق","lem":"فُسُوق"},{"ar":"وَٱلْعِصْيَانَ ۚ","tr":"wal-ʿiṣ'yāna","en":"and disobedience","root":"عصي","lem":"عِصْيان"},{"ar":"أُو۟لَـٰٓئِكَ","tr":"ulāika","en":"Those"},{"ar":"هُمُ","tr":"humu","en":"(are) they "},{"ar":"ٱلرَّٰشِدُونَ","tr":"l-rāshidūna","en":"the guided ones","root":"رشد","lem":"راشِد"}]},{"n":8,"juz":26,"ar":"فَضْلًا مِّنَ ٱللَّهِ وَنِعْمَةً ۚ وَٱللَّهُ عَلِيمٌ حَكِيمٌ","en":"[It is] as bounty from Allāh and favor. And Allāh is Knowing and Wise.","w":[{"ar":"فَضْلًۭا","tr":"faḍlan","en":"A Bounty","root":"فضل","lem":"فَضْل"},{"ar":"مِّنَ","tr":"mina","en":"from Allah"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"from Allah","root":"أله","lem":"اللَّه"},{"ar":"وَنِعْمَةًۭ ۚ","tr":"waniʿ'matan","en":"and favor","root":"نعم","lem":"نِعْمَة"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"عَلِيمٌ","tr":"ʿalīmun","en":"(is) All-Knower","root":"علم","lem":"عَلِيم"},{"ar":"حَكِيمٌۭ","tr":"ḥakīmun","en":"All-Wise","root":"حكم","lem":"حَكِيم"}]},{"n":9,"juz":26,"ar":"وَإِن طَآئِفَتَانِ مِنَ ٱلْمُؤْمِنِينَ ٱقْتَتَلُوا۟ فَأَصْلِحُوا۟ بَيْنَهُمَا ۖ فَإِنۢ بَغَتْ إِحْدَىٰهُمَا عَلَى ٱلْأُخْرَىٰ فَقَـٰتِلُوا۟ ٱلَّتِى تَبْغِى حَتَّىٰ تَفِىٓءَ إِلَىٰٓ أَمْرِ ٱللَّهِ ۚ فَإِن فَآءَتْ فَأَصْلِحُوا۟ بَيْنَهُمَا بِٱلْعَدْلِ وَأَقْسِطُوٓا۟ ۖ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُقْسِطِينَ","en":"And if two factions among the believers should fight, then make settlement between the two. But if one of them oppresses the other, then fight against the one that oppresses until it returns to the ordinance of Allāh. And if it returns, then make settlement between them in justice and act justly. Indeed, Allāh loves those who act justly.","w":[{"ar":"وَإِن","tr":"wa-in","en":"And if"},{"ar":"طَآئِفَتَانِ","tr":"ṭāifatāni","en":"two parties","root":"طوف","lem":"طائِفَة"},{"ar":"مِنَ","tr":"mina","en":"among"},{"ar":"ٱلْمُؤْمِنِينَ","tr":"l-mu'minīna","en":"the believers","root":"أمن","lem":"مُؤْمِن"},{"ar":"ٱقْتَتَلُوا۟","tr":"iq'tatalū","en":"fight","root":"قتل","lem":"اقْتَتَلَ"},{"ar":"فَأَصْلِحُوا۟","tr":"fa-aṣliḥū","en":"then make peace","root":"صلح","lem":"أَصْلَحَ"},{"ar":"بَيْنَهُمَا ۖ","tr":"baynahumā","en":"between both of them","root":"بين","lem":"بَيْن"},{"ar":"فَإِنۢ","tr":"fa-in","en":"But if"},{"ar":"بَغَتْ","tr":"baghat","en":"oppresses","root":"بغي","lem":"بَغَى"},{"ar":"إِحْدَىٰهُمَا","tr":"iḥ'dāhumā","en":"one of them","root":"أحد","lem":"إِحْدَى"},{"ar":"عَلَى","tr":"ʿalā","en":"on"},{"ar":"ٱلْأُخْرَىٰ","tr":"l-ukh'rā","en":"the other","root":"أخر","lem":"آخَر"},{"ar":"فَقَـٰتِلُوا۟","tr":"faqātilū","en":"then fight","root":"قتل","lem":"قاتَلَ"},{"ar":"ٱلَّتِى","tr":"allatī","en":"one which"},{"ar":"تَبْغِى","tr":"tabghī","en":"oppresses","root":"بغي","lem":"بَغَى"},{"ar":"حَتَّىٰ","tr":"ḥattā","en":"until"},{"ar":"تَفِىٓءَ","tr":"tafīa","en":"it returns","root":"فيأ","lem":"فاءُ"},{"ar":"إِلَىٰٓ","tr":"ilā","en":"to"},{"ar":"أَمْرِ","tr":"amri","en":"(the)