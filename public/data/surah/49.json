{"n":49,"name":"Al-Hujurat","nameAr":"الحجرات","meaning":"The Rooms","ayahs":18,"place":"madinah","bismillah":true,"ayat":[{"n":1,"juz":26,"ar":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تُقَدِّمُوا۟ بَيْنَ يَدَىِ ٱللَّهِ وَرَسُولِهِۦ ۖ وَٱتَّقُوا۟ ٱللَّهَ ۚ إِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٌ","en":"O you who have believed, do not put [yourselves] before Allāh and His Messenger but fear Allāh. Indeed, Allāh is Hearing and Knowing.","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O you who believe","root":"أيي","lem":"أَيّ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"O you who believe"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"O you who believe","root":"أمن","lem":"آمَنَ"},{"ar":"لَا","tr":"lā","en":"(Do) not"},{"ar":"تُقَدِّمُوا۟","tr":"tuqaddimū","en":"put (yourselves) forward ","root":"قدم","lem":"قَدَّمَ"},{"ar":"بَيْنَ","tr":"bayna","en":"before Allah","root":"بين","lem":"بَيْن"},{"ar":"يَدَىِ","tr":"yadayi","en":"before Allah","root":"يدي","lem":"يَد"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"before Allah","root":"أله","lem":"اللَّه"},{"ar":"وَرَسُولِهِۦ ۖ","tr":"warasūlihi","en":"and His Messenger","root":"رسل","lem":"رَسُول"},{"ar":"وَٱتَّقُوا۟","tr":"wa-ittaqū","en":"and fear Allah","root":"وقي","lem":"اتَّقَى"},{"ar":"ٱللَّهَ ۚ","tr":"l-laha","en":"and fear Allah","root":"أله","lem":"اللَّه"},{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"سَمِيعٌ","tr":"samīʿun","en":"(is) All-Hearer","root":"سمع","lem":"سَمِيع"},{"ar":"عَلِيمٌۭ","tr":"ʿalīmun","en":"All-Knower","root":"علم","lem":"عَلِيم"}]},{"n":2,"juz":26,"ar":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَرْفَعُوٓا۟ أَصْوَٰتَكُمْ فَوْقَ صَوْتِ ٱلنَّبِىِّ وَلَا تَجْهَرُوا۟ لَهُۥ بِٱلْقَوْلِ كَجَهْرِ بَعْضِكُمْ لِبَعْضٍ أَن تَحْبَطَ أَعْمَـٰلُكُمْ وَأَنتُمْ لَا تَشْعُرُونَ","en":"O you who have believed, do not raise your voices above the voice of the Prophet or be loud to him in speech like the loudness of some of you to others, lest your deeds become worthless while you perceive not.","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O you who believe","root":"أيي","lem":"أَيّ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"O you who believe"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"O you who believe","root":"أمن","lem":"آمَنَ"},{"ar":"لَا","tr":"lā","en":"(Do) not"},{"ar":"تَرْفَعُوٓا۟","tr":"tarfaʿū","en":"raise","root":"رفع","lem":"رَفَعَ"},{"ar":"أَصْوَٰتَكُمْ","tr":"aṣwātakum","en":"your voices","root":"صوت","lem":"صَوْت"},{"ar":"فَوْقَ","tr":"fawqa","en":"above","root":"فوق","lem":"فَوْق"},{"ar":"صَوْتِ","tr":"ṣawti","en":"(the) voice","root":"صوت","lem":"صَوْت"},{"ar":"ٱلنَّبِىِّ","tr":"l-nabiyi","en":"(of) the Prophet","root":"نبأ","lem":"نَبِيّ"},{"ar":"وَلَا","tr":"walā","en":"and (do) not"},{"ar":"تَجْهَرُوا۟","tr":"tajharū","en":"be loud","root":"جهر","lem":"جَهَرَ"},{"ar":"لَهُۥ","tr":"lahu","en":"to him"},{"ar":"بِٱلْقَوْلِ","tr":"bil-qawli","en":"in speech","root":"قول","lem":"قَوْل"},{"ar":"كَجَهْرِ","tr":"kajahri","en":"like (the) loudness","root":"جهر","lem":"جَهْر"},{"ar":"بَعْضِكُمْ","tr":"baʿḍikum","en":"(of) some of you","root":"بعض","lem":"بَعْض"},{"ar":"لِبَعْضٍ","tr":"libaʿḍin","en":"to others","root":"بعض","lem":"بَعْض"},{"ar":"أَن","tr":"an","en":"lest"},{"ar":"تَحْبَطَ","tr":"taḥbaṭa","en":"become worthless","root":"حبط","lem":"حَبِطَ"},{"ar":"أَعْمَـٰلُكُمْ","tr":"aʿmālukum","en":"your deeds","root":"عمل","lem":"عَمَل"},{"ar":"وَأَنتُمْ","tr":"wa-antum","en":"while you"},{"ar":"لَا","tr":"lā","en":"(do) not"},{"ar":"تَشْعُرُونَ","tr":"tashʿurūna","en":"perceive","root":"شعر","lem":"يَشْعُرُ"}]},{"n":3,"juz":26,"ar":"إِنَّ ٱلَّذِينَ يَغُضُّونَ أَصْوَٰتَهُمْ عِندَ رَسُولِ ٱللَّهِ أُو۟لَـٰٓئِكَ ٱلَّذِينَ ٱمْتَحَنَ ٱللَّهُ قُلُوبَهُمْ لِلتَّقْوَىٰ ۚ لَهُم مَّغْفِرَةٌ وَأَجْرٌ عَظِيمٌ","en":"Indeed, those who lower their voices before the Messenger of Allāh - they are the ones whose hearts Allāh has tested for righteousness. For them is forgiveness and great reward.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"يَغُضُّونَ","tr":"yaghuḍḍūna","en":"lower","root":"غضض","lem":"يَغُضُّ"},{"ar":"أَصْوَٰتَهُمْ","tr":"aṣwātahum","en":"their voices","root":"صوت","lem":"صَوْت"},{"ar":"عِندَ","tr":"ʿinda","en":"(in) presence","root":"عند","lem":"عِند"},{"ar":"رَسُولِ","tr":"rasūli","en":"(of the) Messenger of Allah ","root":"رسل","lem":"رَسُول"},{"ar":"ٱللَّهِ","tr":"l-lahi","en":"(of the) Messenger of Allah ","root":"أله","lem":"اللَّه"},{"ar":"أُو۟لَـٰٓئِكَ","tr":"ulāika","en":"those"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"(are) the ones"},{"ar":"ٱمْتَحَنَ","tr":"im'taḥana","en":"Allah has tested","root":"محن","lem":"امْتَحَنَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"Allah has tested","root":"أله","lem":"اللَّه"},{"ar":"قُلُوبَهُمْ","tr":"qulūbahum","en":"their hearts","root":"قلب","lem":"قَلْب"},{"ar":"لِلتَّقْوَىٰ ۚ","tr":"lilttaqwā","en":"for righteousness","root":"وقي","lem":"تَقْوَى"},{"ar":"لَهُم","tr":"lahum","en":"For them"},{"ar":"مَّغْفِرَةٌۭ","tr":"maghfiratun","en":"(is) forgiveness","root":"غفر","lem":"مَغْفِرَة"},{"ar":"وَأَجْرٌ","tr":"wa-ajrun","en":"and a reward","root":"أجر","lem":"أَجْر"},{"ar":"عَظِيمٌ","tr":"ʿaẓīmun","en":"great","root":"عظم","lem":"عَظِيم"}]},{"n":4,"juz":26,"ar":"إِنَّ ٱلَّذِينَ يُنَادُونَكَ مِن وَرَآءِ ٱلْحُجُرَٰتِ أَكْثَرُهُمْ لَا يَعْقِلُونَ","en":"Indeed, those who call you, [O Muḥammad], from behind the chambers - most of them do not use reason.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"يُنَادُونَكَ","tr":"yunādūnaka","en":"call you","root":"ندي","lem":"نادَى"},{"ar":"مِن","tr":"min","en":"from"},{"ar":"وَرَآءِ","tr":"warāi","en":"behind","root":"وري","lem":"وَراء"},{"ar":"ٱلْحُجُرَٰتِ","tr":"l-ḥujurāti","en":"the private chambers","root":"حجر","lem":"حُجُرَة"},{"ar":"أَكْثَرُهُمْ","tr":"aktharuhum","en":"most of them","root":"كثر","lem":"أَكْثَر"},{"ar":"لَا","tr":"lā","en":"(do) not"},{"ar":"يَعْقِلُونَ","tr":"yaʿqilūna","en":"understand","root":"عقل","lem":"عَقَلُ"}]},{"n":5,"juz":26,"ar":"وَلَوْ أَنَّهُمْ صَبَرُوا۟ حَتَّىٰ تَخْرُجَ إِلَيْهِمْ لَكَانَ خَيْرًا لَّهُمْ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ","en":"And if they had been patient until you [could] come out to them, it would have been better for them. But Allāh is Forgiving and Merciful.","w":[{"ar":"وَلَوْ","tr":"walaw","en":"And if"},{"ar":"أَنَّهُمْ","tr":"annahum","en":"they"},{"ar":"صَبَرُوا۟","tr":"ṣabarū","en":"had been patient","root":"صبر","lem":"صَبَرَ"},{"ar":"حَتَّىٰ","tr":"ḥattā","en":"until"},{"ar":"تَخْرُجَ","tr":"takhruja","en":"you came out","root":"خرج","lem":"خَرَجَ"},{"ar":"إِلَيْهِمْ","tr":"ilayhim","en":"to them"},{"ar":"لَكَانَ","tr":"lakāna","en":"certainly it would be","root":"كون","lem":"كانَ"},{"ar":"خَيْرًۭا","tr":"khayran","en":"better","root":"خير","lem":"خَيْر"},{"ar":"لَّهُمْ ۚ","tr":"lahum","en":"for them"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"غَفُورٌۭ","tr":"ghafūrun","en":"(is) Oft-Forgiving","root":"غفر","lem":"غَفُور"},{"ar":"رَّحِيمٌۭ","tr":"raḥīmun","en":"Most Merciful","root":"رحم","lem":"رَحِيم"}]},{"n":6,"juz":26,"ar":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِن جَآءَكُمْ فَاسِقٌۢ بِنَبَإٍ فَتَبَيَّنُوٓا۟ أَن تُصِيبُوا۟ قَوْمًۢا بِجَهَـٰلَةٍ فَتُصْبِحُوا۟ عَلَىٰ مَا فَعَلْتُمْ نَـٰدِمِينَ","en":"O you who have believed, if there comes to you a disobedient one with information, investigate, lest you harm a people out of ignorance and become, over what you have done, regretful.","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O you who believe","root":"أيي","lem":"أَيّ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"O you who believe"},{"ar":"ءَامَنُوٓا۟","tr":"āmanū","en":"O you who believe","root":"أمن","lem":"آمَنَ"},{"ar":"إِن","tr":"in","en":"If"},{"ar":"جَآءَكُمْ","tr":"jāakum","en":"comes to you","root":"جيأ","lem":"جاءَ"},{"ar":"فَاسِقٌۢ","tr":"fāsiqun","en":"a wicked person","root":"فسق","lem":"فاسِق"},{"ar":"بِنَبَ