ا۟ لَا يَسْخَرْ قَوْمٌ مِّن قَوْمٍ عَسَىٰٓ أَن يَكُونُوا۟ خَيْرًا مِّنْهُمْ وَلَا نِسَآءٌ مِّن نِّسَآءٍ عَسَىٰٓ أَن يَكُنَّ خَيْرًا مِّنْهُنَّ ۖ وَلَا تَلْمِزُوٓا۟ أَنفُسَكُمْ وَلَا تَنَابَزُوا۟ بِٱلْأَلْقَـٰبِ ۖ بِئْسَ ٱلِٱسْمُ ٱلْفُسُوقُ بَعْدَ ٱلْإِيمَـٰنِ ۚ وَمَن لَّمْ يَتُبْ فَأُو۟لَـٰٓئِكَ هُمُ ٱلظَّـٰلِمُونَ","en":"O you who have believed, let not a people ridicule [another] people; perhaps they may be better than them; nor let women ridicule [other] women; perhaps they may be better than them. And do not insult one another and do not call each other by [offensive] nicknames. Wretched is the name [i.e., mention] of disobedience after [one's] faith. And whoever does not repent - then it is those who are the wrongdoers.","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O you who believe","root":"أيي","lem":"أَيّ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"O you who believe"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"O you who believe","root":"أمن","lem":"آمَنَ"},{"ar":"لَا","tr":"lā","en":"(Let) not"},{"ar":"يَسْخَرْ","tr":"yaskhar","en":"ridicule","root":"سخر","lem":"سَخِرَ"},{"ar":"قَوْمٌۭ","tr":"qawmun","en":"a people","root":"قوم","lem":"قَوْم"},{"ar":"مِّن","tr":"min","en":"[of]"},{"ar":"قَوْمٍ","tr":"qawmin","en":"(another) people","root":"قوم","lem":"قَوْم"},{"ar":"عَسَىٰٓ","tr":"ʿasā","en":"perhaps","root":"عسي","lem":"عَسَى"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"يَكُونُوا۟","tr":"yakūnū","en":"they may be","root":"كون","lem":"كانَ"},{"ar":"خَيْرًۭا","tr":"khayran","en":"better","root":"خير","lem":"خَيْر"},{"ar":"مِّنْهُمْ","tr":"min'hum","en":"than them"},{"ar":"وَلَا","tr":"walā","en":"and (let) not"},{"ar":"نِسَآءٌۭ","tr":"nisāon","en":"women","root":"نسو","lem":"نِساء"},{"ar":"مِّن","tr":"min","en":"[of]"},{"ar":"نِّسَآءٍ","tr":"nisāin","en":"(other) women","root":"نسو","lem":"نِساء"},{"ar":"عَسَىٰٓ","tr":"ʿasā","en":"perhaps","root":"عسي","lem":"عَسَى"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"يَكُنَّ","tr":"yakunna","en":"they may be","root":