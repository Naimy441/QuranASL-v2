{"n":92,"name":"Al-Layl","nameAr":"الليل","meaning":"The Night","ayahs":21,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"وَٱلَّيْلِ إِذَا يَغْشَىٰ","en":"By the night when it covers","w":[{"ar":"وَٱلَّيْلِ","tr":"wa-al-layli","en":"By the night","root":"ليل","lem":"لَيْل"},{"ar":"إِذَا","tr":"idhā","en":"when"},{"ar":"يَغْشَىٰ","tr":"yaghshā","en":"it covers","root":"غشو","lem":"غَشِيَ"}]},{"n":2,"juz":30,"ar":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","en":"And [by] the day when it appears","w":[{"ar":"وَٱلنَّهَارِ","tr":"wal-nahāri","en":"And the day","root":"نهر","lem":"نَهار"},{"ar":"إِذَا","tr":"idhā","en":"when"},{"ar":"تَجَلَّىٰ","tr":"tajallā","en":"it shines in brightness","root":"جلو","lem":"تَجَلَّى"}]},{"n":3,"juz":30,"ar":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","en":"And [by] He who created the male and female,","w":[{"ar":"وَمَا","tr":"wamā","en":"And He Who"},{"ar":"خَلَقَ","tr":"khalaqa","en":"created","root":"خلق","lem":"خَلَقَ"},{"ar":"ٱلذَّكَرَ","tr":"l-dhakara","en":"the male","root":"ذكر","lem":"ذَكَر"},{"ar":"وَٱلْأُنثَىٰٓ","tr":"wal-unthā","en":"and the female","root":"أنث","lem":"أُنثَى"}]},{"n":4,"juz":30,"ar":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","en":"Indeed, your efforts are diverse.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"سَعْيَكُمْ","tr":"saʿyakum","en":"your efforts","root":"سعي","lem":"سَعْي"},{"ar":"لَشَتَّىٰ","tr":"lashattā","en":"(are) surely diverse","root":"شتت","lem":"شَتَّى"}]},{"n":5,"juz":30,"ar":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","en":"As for he who gives and fears Allāh","w":[{"ar":"فَأَمَّا","tr":"fa-ammā","en":"Then as for"},{"ar":"مَنْ","tr":"man","en":"(him) who"},{"ar":"أَعْطَىٰ","tr":"aʿṭā","en":"gives","root":"عطو","lem":"أَعْطَى"},{"ar":"وَٱتَّقَىٰ","tr":"wa-ittaqā","en":"and fears","root":"وقي","lem":"اتَّقَى"}]},{"n":6,"juz":30,"ar":"وَصَدَّقَ بِٱلْحُسْنَىٰ","en":"And believes in the best [reward],","w":[{"ar":"وَصَدَّقَ","tr":"waṣaddaqa","en":"And believes","root":"صدق","lem":"صَدَّقَ"},{"ar":"بِٱلْحُسْنَىٰ","tr":"bil-ḥus'nā","en":"in the best","root":"حسن","lem":"حُسْنَى"}]},{"n":7,"juz":30,"ar":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","en":"We will ease him toward ease.","w":[{"ar":"فَسَنُيَسِّرُهُۥ","tr":"fasanuyassiruhu","en":"Then We will ease him","root":"يسر","lem":"يَسَّرَ"},{"ar":"لِلْيُسْرَىٰ","tr":"lil'yus'rā","en":"towards [the] ease","root":"يسر","lem":"يُسْرَى"}]},{"n":8,"juz":30,"ar":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","en":"But as for he who withholds and considers himself free of need","w":[{"ar":"وَأَمَّا","tr":"wa-ammā","en":"But as for"},{"ar":"مَنۢ","tr":"man","en":"(him) who"},{"ar":"بَخِلَ","tr":"bakhila","en":"withholds","root":"بخل","lem":"بَخِلَ"},{"ar":"وَٱسْتَغْنَىٰ","tr":"wa-is'taghnā","en":"and considers himself free from need","root":"غني","lem":"اسْتَغْنَى"}]},{"n":9,"juz":30,"ar":"وَكَذَّبَ بِٱلْحُسْنَىٰ","en":"And denies the best [reward],","w":[{"ar":"وَكَذَّبَ","tr":"wakadhaba","en":"And denies","root":"كذب","lem":"كَذَّبَ"},{"ar":"بِٱلْحُسْنَىٰ","tr":"bil-ḥus'nā","en":"the best","root":"حسن","lem":"حُسْنَى"}]},{"n":10,"juz":30,"ar":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","en":"We will ease him toward difficulty.","w":[{"ar":"فَسَنُيَسِّرُهُۥ","tr":"fasanuyassiruhu","en":"Then We will ease him","root":"يسر","lem":"يَسَّرَ"},{"ar":"لِلْعُسْرَىٰ","tr":"lil'ʿus'rā","en":"towards [the] difficulty","root":"عسر","lem":"عُسْرَى"}]},{"n":11,"juz":30,"ar":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","en":"And what will his wealth avail him when he falls?","w":[{"ar":"وَمَا","tr":"wamā","en":"And not"},{"ar":"يُغْنِى","tr":"yugh'nī","en":"will avail","root":"غني","lem":"أَغْنَتْ"},{"ar":"عَنْهُ","tr":"ʿanhu","en":"him"},{"ar":"مَالُهُۥٓ","tr":"māluhu","en":"his wealth","root":"مول","lem":"مال"},{"ar":"إِذَا","tr":"idhā","en":"when"},{"ar":"تَرَدَّىٰٓ","tr":"taraddā","en":"he falls","root":"ردي","lem":"تَرَدَّى"}]},{"n":12,"juz":30,"ar":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","en":"Indeed, [incumbent] upon Us is guidance.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"عَلَيْنَا","tr":"ʿalaynā","en":"upon Us"},{"ar":"لَلْهُدَىٰ","tr":"lalhudā","en":"(is) the guidance","root":"هدي","lem":"هُدًى"}]},{"n":13,"juz":30,"ar":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ","en":"And indeed, to us belongs the Hereafter and the first [life].","w":[{"ar":"وَإِنَّ","tr":"wa-inna","en":"And indeed"},{"ar":"لَنَا","tr":"lanā","en":"for Us"},{"ar":"لَلْـَٔاخِرَةَ","tr":"lalākhirata","en":"(is) the Hereafter","root":"أخر","lem":"آخِر"},{"ar":"وَٱلْأُولَىٰ","tr":"wal-ūlā","en":"and the first (life)","root":"أول","lem":"أَوَّل"}]},{"n":14,"juz":30,"ar":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","en":"So I have warned you of a Fire which is blazing.","w":[{"ar":"فَأَنذَرْتُكُمْ","tr":"fa-andhartukum","en":"So I warn you","root":"نذر","lem":"أَنذَرَ"},{"ar":"نَارًۭا","tr":"nāran","en":"(of) a Fire","root":"نور","lem":"نار"},{"ar":"تَلَظَّىٰ","tr":"talaẓẓā","en":"blazing","root":"لظي","lem":"تَلَظَّى"}]},{"n":15,"juz":30,"ar":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","en":"None will [enter to] burn therein except the most wretched one","w":[{"ar":"لَا","tr":"lā","en":"Not"},{"ar":"يَصْلَىٰهَآ","tr":"yaṣlāhā","en":"will burn (in) it","root":"صلي","lem":"يَصْلَى"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"ٱلْأَشْقَى","tr":"l-ashqā","en":"the most wretched","root":"شقو","lem":"أَشْقَى"}]},{"n":16,"juz":30,"ar":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","en":"Who had denied and turned away.","w":[{"ar":"ٱلَّذِى","tr":"alladhī","en":"The one who"},{"ar":"كَذَّبَ","tr":"kadhaba","en":"denied","root":"كذب","lem":"كَذَّبَ"},{"ar":"وَتَوَلَّىٰ","tr":"watawallā","en":"and turned away","root":"ولي","lem":"تَوَلَّى"}]},{"n":17,"juz":30,"ar":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","en":"But the righteous one will avoid it","w":[{"ar":"وَسَيُجَنَّبُهَا","tr":"wasayujannabuhā","en":"But will be removed from it","root":"جنب","lem":"يُجَنَّبُ"},{"ar":"ٱلْأَتْقَى","tr":"l-atqā","en":"the righteous","root":"وقي","lem":"أَتْقَى"}]},{"n":18,"juz":30,"ar":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","en":"[He] who gives [from] his wealth to purify himself","w":[{"ar":"ٱلَّذِى","tr":"alladhī","en":"The one who"},{"ar":"يُؤْتِى","tr":"yu'tī","en":"gives","root":"أتي","lem":"آتَى"},{"ar":"مَالَهُۥ","tr":"mālahu","en":"his wealth","root":"مول","lem":"مال"},{"ar":"يَتَزَكَّىٰ","tr":"yatazakkā","en":"(to) purify himself","root":"زكو","lem":"تَزَكَّى"}]},{"n":19,"juz":30,"ar":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","en":"And not [giving] for anyone who has [done him] a favor to be rewarded","w":[{"ar":"وَمَا","tr":"wamā","en":"And not"},{"ar":"لِأَحَدٍ","tr":"li-aḥadin","en":"for anyone","root":"أحد","lem":"أَحَد"},{"ar":"عِندَهُۥ","tr":"ʿindahu","en":"with him","root":"عند","lem":"عِند"},{"ar":"مِن","tr":"min","en":"any"},{"ar":"نِّعْمَةٍۢ","tr":"niʿ'matin","en":"favor","root":"نعم","lem":"نِعْمَة"},{"ar":"تُجْزَىٰٓ","tr":"tuj'zā","en":"to be recompensed","root":"جزي","lem":"جَزَى"}]},{"n":20,"juz":30,"ar":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","en":"But only seeking the face [i.e., acceptance] of his Lord, Most High.","w":[{"ar":"إِلَّا","tr":"illā","en":"Except"},{"ar":"ٱبْتِغَآءَ","tr":"ib'tighāa","en":"seeking","root":"بغي","lem":"ابْتِغاء"},{"ar":"وَجْهِ","tr":"wajhi","en":"(the) Countenance","root":"وجه","lem":"وَجْه"},{"ar":"رَبِّهِ","tr":"rabbihi","en":"(of) his Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلْأَعْلَىٰ","tr":"l-aʿlā","en":"the Most High","root":"علو","lem":"أَعْلَى"}]},{"n":21,"juz":30,"ar":"وَلَسَوْفَ يَرْضَىٰ","en":"And he is going to be satisfied.","w":[{"ar":"وَلَسَوْفَ","tr":"walasawfa","en":"And soon, surely"},{"ar":"يَرْضَىٰ","tr":"yarḍā","en":"he will be pleased","root":"رضو","lem":"رَضِيَ"}]}]}