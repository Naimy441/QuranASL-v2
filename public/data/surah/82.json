{"n":82,"name":"Al-Infitar","nameAr":"الإنفطار","meaning":"The Cleaving","ayahs":19,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","en":"When the sky breaks apart","w":[{"ar":"إِذَا","tr":"idhā","en":"When"},{"ar":"ٱلسَّمَآءُ","tr":"l-samāu","en":"the sky","root":"سمو","lem":"سَماء"},{"ar":"ٱنفَطَرَتْ","tr":"infaṭarat","en":"(is) cleft asunder","root":"فطر","lem":"انفَطَرَتْ"}]},{"n":2,"juz":30,"ar":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","en":"And when the stars fall, scattering,","w":[{"ar":"وَإِذَا","tr":"wa-idhā","en":"And when"},{"ar":"ٱلْكَوَاكِبُ","tr":"l-kawākibu","en":"the stars","root":"كوكب","lem":"كَوْكَب"},{"ar":"ٱنتَثَرَتْ","tr":"intatharat","en":"scatter","root":"نثر","lem":"انتَثَرَتْ"}]},{"n":3,"juz":30,"ar":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","en":"And when the seas are erupted","w":[{"ar":"وَإِذَا","tr":"wa-idhā","en":"And when"},{"ar":"ٱلْبِحَارُ","tr":"l-biḥāru","en":"the seas","root":"بحر","lem":"بَحْر"},{"ar":"فُجِّرَتْ","tr":"fujjirat","en":"are made to gush forth","root":"فجر","lem":"فُجِّرَتْ"}]},{"n":4,"juz":30,"ar":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","en":"And when the [contents of] graves are scattered [i.e., exposed],","w":[{"ar":"وَإِذَا","tr":"wa-idhā","en":"And when"},{"ar":"ٱلْقُبُورُ","tr":"l-qubūru","en":"the graves","root":"قبر","lem":"قَبْر"},{"ar":"بُعْثِرَتْ","tr":"buʿ'thirat","en":"are overturned","root":"بعثر","lem":"بُعْثِرَ"}]},{"n":5,"juz":30,"ar":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","en":"A soul will [then] know what it has put forth and kept back.","w":[{"ar":"عَلِمَتْ","tr":"ʿalimat","en":"Will know","root":"علم","lem":"عَلِمَ"},{"ar":"نَفْسٌۭ","tr":"nafsun","en":"a soul","root":"نفس","lem":"نَفْس"},{"ar":"مَّا","tr":"mā","en":"what"},{"ar":"قَدَّمَتْ","tr":"qaddamat","en":"it has sent forth","root":"قدم","lem":"قَدَّمَ"},{"ar":"وَأَخَّرَتْ","tr":"wa-akharat","en":"and left behind","root":"أخر","lem":"أَخَّرَ"}]},{"n":6,"juz":30,"ar":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","en":"O mankind, what has deceived you concerning your Lord, the Generous,","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O","root":"أيي","lem":"أَيّ"},{"ar":"ٱلْإِنسَـٰنُ","tr":"l-insānu","en":"man","root":"أنس","lem":"إِنسان"},{"ar":"مَا","tr":"mā","en":"What"},{"ar":"غَرَّكَ","tr":"gharraka","en":"has deceived you","root":"غرر","lem":"غَرَّ"},{"ar":"بِرَبِّكَ","tr":"birabbika","en":"concerning your Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلْكَرِيمِ","tr":"l-karīmi","en":"the Most Noble","root":"كرم","lem":"كَرِيم"}]},{"n":7,"juz":30,"ar":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","en":"Who created you, proportioned you, and balanced you?","w":[{"ar":"ٱلَّذِى","tr":"alladhī","en":"Who"},{"ar":"خَلَقَكَ","tr":"khalaqaka","en":"created you","root":"خلق","lem":"خَلَقَ"},{"ar":"فَسَوَّىٰكَ","tr":"fasawwāka","en":"then fashioned you","root":"سوي","lem":"سَوَّى"},{"ar":"فَعَدَلَكَ","tr":"faʿadalaka","en":"then balanced you","root":"عدل","lem":"عَدَلَ"}]},{"n":8,"juz":30,"ar":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","en":"In whatever form He willed has He assembled you.","w":[{"ar":"فِىٓ","tr":"fī","en":"In"},{"ar":"أَىِّ","tr":"ayyi","en":"whatever","root":"أيي","lem":"أَيّ"},{"ar":"صُورَةٍۢ","tr":"ṣūratin","en":"form","root":"صور","lem":"صُورَة"},{"ar":"مَّا","tr":"mā","en":"what"},{"ar":"شَآءَ","tr":"shāa","en":"He willed","root":"شيأ","lem":"شاءَ"},{"ar":"رَكَّبَكَ","tr":"rakkabaka","en":"He assembled you","root":"ركب","lem":"رَكَّبَ"}]},{"n":9,"juz":30,"ar":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","en":"No! But you deny the Recompense.","w":[{"ar":"كَلَّا","tr":"kallā","en":"Nay"},{"ar":"بَلْ","tr":"bal","en":"But"},{"ar":"تُكَذِّبُونَ","tr":"tukadhibūna","en":"you deny","root":"كذب","lem":"كَذَّبَ"},{"ar":"بِٱلدِّينِ","tr":"bil-dīni","en":"the Judgment","root":"دين","lem":"دِين"}]},{"n":10,"juz":30,"ar":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ","en":"And indeed, [appointed] over you are keepers,","w":[{"ar":"وَإِنَّ","tr":"wa-inna","en":"And indeed"},{"a