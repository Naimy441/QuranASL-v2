y"},{"ar":"عَنْهَا","tr":"ʿanhā","en":"from it"},{"ar":"بِغَآئِبِينَ","tr":"bighāibīna","en":"(will be) absent","root":"غيب","lem":"غائِب"}]},{"n":17,"juz":30,"ar":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","en":"And what can make you know what is the Day of Recompense?","w":[{"ar":"وَمَآ","tr":"wamā","en":"And what"},{"ar":"أَدْرَىٰكَ","tr":"adrāka","en":"can make you know","root":"دري","lem":"أَدْرَى"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"يَوْمُ","tr":"yawmu","en":"(is the) Day","root":"يوم","lem":"يَوْم"},{"ar":"ٱلدِّينِ","tr":"l-dīni","en":"(of) the Judgment","root":"دين","lem":"دِين"}]},{"n":18,"juz":30,"ar":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","en":"Then, what can make you know what is the Day of Recompense?","w":[{"ar":"ثُمَّ","tr":"thumma","en":"Then"},{"ar":"مَآ","tr":"mā","en":"what"},{"ar":"أَدْرَىٰكَ","tr":"adrāka","en":"can make you know","root":"دري","lem":"أَدْرَى"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"يَوْمُ","tr":"yawmu","en":"(is the) Day","root":"يوم","lem":"يَوْم"},{"ar":"ٱلدِّينِ","tr":"l-dīni","en":"(of) the Judgment","root":"دين","lem":"دِين"}]},{"n":19,"juz":30,"ar":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ","en":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allāh.","w":[{"ar":"يَوْمَ","tr":"yawma","en":"(The) Day","root":"يوم","lem":"يَوْم"},{"ar":"لَا","tr":"lā","en":"not"},{"ar":"تَمْلِكُ","tr":"tamliku","en":"will have power","root":"ملك","lem":"مَلَكَتْ"},{"ar":"نَفْسٌۭ","tr":"nafsun","en":"a soul","root":"نفس","lem":"نَفْس"},{"ar":"لِّنَفْسٍۢ","tr":"linafsin","en":"for a soul","root":"نفس","lem":"نَفْس"},{"ar":"شَيْـًۭٔا ۖ","tr":"shayan","en":"anything","root":"شيأ","lem":"شَىْء"},{"ar":"وَٱلْأَمْرُ","tr":"wal-amru","en":"and the Command","root":"أمر","lem":"أَمْر"},{"ar":"يَوْمَئِذٍۢ","tr":"yawma-idhin","en":"that Day","root":"يوم","lem":"يَوْم"},{"ar":"لِّلَّهِ","tr":"lillahi","en":"(will be) with Allah","root":"أله","lem":"اللَّه"}]}]}