,"tr":"fī","en":"in"},{"ar":"قُلُوبِنَا","tr":"qulūbinā","en":"our hearts","root":"قلب","lem":"قَلْب"},{"ar":"غِلًّۭا","tr":"ghillan","en":"any rancor","root":"غلل","lem":"غِلّ"},{"ar":"لِّلَّذِينَ","tr":"lilladhīna","en":"towards those who"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"believed","root":"أمن","lem":"آمَنَ"},{"ar":"رَبَّنَآ","tr":"rabbanā","en":"Our Lord","root":"ربب","lem":"رَبّ"},{"ar":"إِنَّكَ","tr":"innaka","en":"indeed You"},{"ar":"رَءُوفٌۭ","tr":"raūfun","en":"(are) Full of Kindness","root":"رأف","lem":"رَءُوف"},{"ar":"رَّحِيمٌ","tr":"raḥīmun","en":"Most Merciful","root":"رحم","lem":"رَحِيم"}]},{"n":11,"juz":28,"ar":"۞ أَلَمْ تَرَ إِلَى ٱلَّذِينَ نَافَقُوا۟ يَقُولُونَ لِإِخْوَٰنِهِمُ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ لَئِنْ أُخْرِجْتُمْ لَنَخْرُجَنَّ مَعَكُمْ وَلَا نُطِيعُ فِيكُمْ أَحَدًا أَبَدًا وَإِن قُوتِلْتُمْ لَنَنصُرَنَّكُمْ وَٱللَّهُ يَشْهَدُ إِنَّهُمْ لَكَـٰذِبُونَ","en":"Have you not considered those who practice hypocrisy, saying to their brothers [i.e., associates] who have disbelieved among the People of the Scripture, \"If you are expelled, we will surely leave with you, and we will not obey, in regard to you, anyone - ever; and if you are fought, we will surely aid you.\" But Allāh testifies that they are liars.","w":[{"ar":"۞ أَلَمْ","tr":"alam","en":"Do not"},{"ar":"تَرَ","tr":"tara","en":"you see","root":"رأي","lem":"رَأَى"},{"ar":"إِلَى","tr":"ilā","en":"[to]"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"نَافَقُوا۟","tr":"nāfaqū","en":"(were) hypocrites","root":"نفق","lem":"نافَقُ"},{"ar":"يَقُولُونَ","tr":"yaqūlūna","en":"saying","root":"قول","lem":"قالَ"},{"ar":"لِإِخْوَٰنِهِمُ","tr":"li-ikh'wānihimu","en":"to their brothers","root":"أخو","lem":"أَخ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"كَفَرُوا۟","tr":"kafarū","en":"disbelieved","root":"كفر","lem":"كَفَرَ"},{"ar":"مِنْ","tr":"min","en":"among"},{"ar":"أَهْلِ","tr":"ahli","en":"the People","root":"أهل","lem":"أَهْل"},{"ar":"ٱلْكِتَـٰبِ","tr":"l-kitābi","en":"(of) the Scripture","root":"كتب","lem":"كِتاب"},{"ar":"لَئِنْ","tr":"la-in","en":"If"},{"ar":"أُخْرِجْتُمْ","tr":"ukh'rij'tum","en":"you are expelled","root":"خرج","lem":"أَخْرَجَ"},{"ar":"لَنَخْرُجَنَّ","tr":"lanakhrujanna","en":"surely we will leave","root":"خرج","lem":"خَرَجَ"},{"ar":"مَعَكُمْ","tr":"maʿakum","en":"with you"},{"ar":"وَلَا","tr":"walā","en":"and not"},{"ar":"نُطِيعُ","tr":"nuṭīʿu","en":"we will obey","root":"طوع","lem":"أَطاعَ"},{"ar":"فِيكُمْ","tr":"fīkum","en":"concerning you"},{"ar":"أَحَدًا","tr":"aḥadan","en":"anyone","root":"أحد","lem":"أَحَد"},{"ar":"أَبَدًۭا","tr":"abadan","en":"ever","root":"أبد","lem":"أَبَدًا"},{"ar":"وَإِن","tr":"wa-in","en":"and if"},{"ar":"قُوتِلْتُمْ","tr":"qūtil'tum","en":"you are fought","root":"قتل","lem":"قاتَلَ"},{"ar":"لَنَنصُرَنَّكُمْ","tr":"lananṣurannakum","en":"certainly we will help you","root":"نصر","lem":"نَصَرَ"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"يَشْهَدُ","tr":"yashhadu","en":"bears witness","root":"شهد","lem":"شَهِدَ"},{"ar":"إِنَّهُمْ","tr":"innahum","en":"that they"},{"ar":"لَكَـٰذِبُونَ","tr":"lakādhibūna","en":"(are) surely liars","root":"كذب","lem":"كاذِب"}]},{"n":12,"juz":28,"ar":"لَئِنْ أُخْرِجُوا۟ لَا يَخْرُجُونَ مَعَهُمْ وَلَئِن قُوتِلُوا۟ لَا يَنصُرُونَهُمْ وَلَئِن نَّصَرُوهُمْ لَيُوَلُّنَّ ٱلْأَدْبَـٰرَ ثُمَّ لَا يُنصَرُونَ","en":"If they are expelled, they will not leave with them, and if they are fought, they will not aid them. And [even] if they should aid them, they will surely turn their backs; then [thereafter] they will not be aided.","w":[{"ar":"لَئِنْ","tr":"la-in","en":"If"},{"ar":"أُخْرِجُوا۟","tr":"ukh'rijū","en":"they are expelled","root":"خرج","lem":"أَخْرَجَ"},{"ar":"لَا","tr":"lā","en":"not"},{"ar":"يَخْرُجُونَ","tr":"yakhrujūna","en":"they will leave","root":"خرج","lem":"خَرَجَ"},{"ar":"مَعَهُمْ","tr":"maʿahum","en":"with them"},{"ar":"وَلَئِن","tr":"wala-in","en":"and if"},{"ar":"قُوتِلُوا۟","tr":"qūtilū","en":"they are fought","root":"قتل","lem":"قاتَلَ"},{"ar":"لَا","tr":"lā","en":"not"},{"ar":"يَنصُرُونَهُمْ","tr":"yanṣurūnahum","en":"they will help them","root":"نصر","lem":"نَصَرَ"},{"ar":"وَلَئِن","tr":"wala-in","en":"And if"},{"ar":"نَّصَرُوهُمْ","tr":"naṣarūhum","en":"they help them","root":"نصر","lem":"نَصَرَ"},{"ar":"لَيُوَلُّنَّ","tr":"layuwallunna","en":"certainly they will turn","root":"ولي","lem":"وَلَّى"},{"ar":"ٱلْأَدْبَـٰرَ","tr":"l-adbāra","en":"(their) backs","root":"دبر","lem":"دُبُر"},{"ar":"ثُمَّ","tr":"thumma","en":"then"},{"ar":"لَا","tr":"lā","en":"not"},{"ar":"يُنصَرُونَ","tr":"yunṣarūna","en":"they will be helped","root":"نصر","lem":"نَصَرَ"}]},{"n":13,"juz":28,"ar":"لَأَنتُمْ أَشَدُّ رَهْبَةً فِى صُدُورِهِم مِّنَ ٱللَّهِ ۚ ذَٰلِكَ بِأَنَّهُمْ قَوْمٌ لَّا يَفْقَهُونَ","en":"You [believers] are more fearful within their breasts than Allāh. That is because they are a people who do not understand.","w":[{"ar":"لَأَنتُمْ","tr":"la-antum","en":"Certainly you"},{"ar":"أَشَدُّ","tr":"ashaddu","en":"(are) more intense","root":"شدد","lem":"أَشَدّ"},{"ar":"رَهْبَةًۭ","tr":"rahbatan","en":"(in) fear","root":"رهب","lem":"رَهْبَة"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"صُدُورِهِم","tr":"ṣudūrihim","en":"their breasts","root":"صدر","lem":"صَدْر"},{"ar":"مِّنَ","tr":"mina","en":"than"},{"ar":"ٱللَّهِ ۚ","tr":"l-lahi","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"ذَٰلِكَ","tr":"dhālika","en":"That"},{"ar":"بِأَنَّهُمْ","tr":"bi-annahum","en":"(is) because they"},{"ar":"قَوْمٌۭ","tr":"qawmun","en":"(are) a people","root":"قوم","lem":"قَوْم"},{"ar":"لَّا","tr":"lā","en":"(who do) not"},{"ar":"يَفْقَهُونَ","tr":"yafqahūna","en":"understand","root":"فقه","lem":"يَفْقَهُ"}]},{"n":14,"juz":28,"ar":"لَا يُقَـٰتِلُونَكُمْ جَمِيعًا إِلَّا فِى قُرًى مُّحَصَّنَةٍ أَوْ مِن وَرَآءِ جُدُرٍۭ ۚ بَأْسُهُم بَيْنَهُمْ شَدِيدٌ ۚ تَحْسَبُهُمْ جَمِيعًا وَقُلُوبُهُمْ شَتَّىٰ ۚ ذَٰلِكَ بِأَنَّهُمْ قَوْمٌ لَّا يَعْقِلُونَ","en":"They will not fight you all except within fortified cities or from behind walls. Their violence [i.e., enmity] among themselves is severe. You think they are together, but their hearts are diverse. That is because they are a people who do not reason.","w":[{"ar":"لَا","tr":"lā","en":"Not"},{"ar":"يُقَـٰتِلُونَكُمْ","tr":"yuqātilūnakum","en":"will they fight you","root":"قتل","lem":"قاتَلَ"},{"ar":"جَمِيعًا","tr":"jamīʿan","en":"all","root":"جمع","lem":"جَمِيع"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"قُرًۭى","tr":"quran","en":"towns","root":"قري","lem":"قَرْيَة"},{"ar":"مُّحَصَّنَةٍ","tr":"muḥaṣṣanatin","en":"fortified","root":"حصن","lem":"مُحَصَّنَة"},{"ar":"أَوْ","tr":"aw","en":"or"},{"ar":"مِن","tr":"min","en":"from"},{"ar":"وَرَآءِ","tr":"warāi","en":"behind","root":"وري","lem":"وَراء"},{"ar":"جُدُرٍۭ ۚ","tr":"judurin","en":"walls","root":"جدر","lem":"جُدُر"},{"ar":"بَأْسُهُم","tr":"basuhum","en":"Their violence","root":"بأس","lem":"بَأْس"},{"ar":"بَيْنَهُمْ","tr":"baynahum","en":"among themselves","root":"بين","lem":"بَيْن"},{"ar":"شَدِيدٌۭ ۚ","tr":"shadīdun","en":"(is) severe","root":"شدد","lem":"شَدِيد"},{"ar":"تَحْسَبُهُمْ","tr":"taḥsabuhum","en":"You think they","root":"حسب","lem":"حَسِبَ"},{"ar":"جَمِيعًۭا","tr":"jamīʿan","en":"(are) united","root":"جمع","lem":"جَمِيع"},{"ar":"وَقُلُوبُهُمْ","tr":"waqulūbuhum","en":"but their hearts","root":"قلب","lem":"قَلْب"},{"ar":"شَتَّىٰ ۚ","tr":"shattā","en":"(are) divided","root":"شتت","lem":"شَتَّى"},{"ar":"ذَٰلِكَ","tr":"dhālika","en":"That"},{"ar":"بِأَنَّهُمْ","tr":"bi-annahum","en":"(is) because they"},{"ar":"قَوْمٌۭ","tr":"qawmun","en":"(are) a people","root":"قوم","lem":"قَوْم"},{"ar":"لَّا","tr":"lā","en":"not"},{"ar":"يَعْقِلُونَ","tr":"yaʿqilūna","en":"they reason","root":"عقل","lem":"عَقَلُ"}]},{"n":15,"juz":28,"ar":"كَمَثَلِ ٱلَّذِينَ مِن قَبْلِهِمْ قَرِيبًا ۖ ذَاقُوا۟ وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ","en":"[Theirs is] like the example of those shortly before them: they tasted the bad consequence of their affair, and they will have a painful punishment.","w":[{"ar":"كَمَثَلِ","tr":"kamathali","en":"Like (the) example","root":"مثل","lem":"مَثَل"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"(of) those"},{"ar":"مِن","tr":"min","en":"from"},{"ar":"قَبْلِهِمْ","tr":"qablihim","en":"before them","root":"قبل","lem":"قَبْل"},{"ar":"قَرِيبًۭا ۖ","tr":"qarīban","en":"shortly","root":"قرب","lem":"قَرِيب"},{"ar":"ذَاقُوا۟","tr":"dhāqū","en":"they tasted","root":"ذوق","lem":"ذاقُ"},{"ar":"وَبَالَ","tr":"wabāla","en":"(the) evil result","root":"وبل","lem":"وَبال"},{"ar":"أَمْرِهِمْ","tr":"amrihim","en":"(of) their affair","root":"أمر","lem":"أَمْر"},{"ar":"وَلَهُمْ","tr":"walahum","en":"and for them"},{"ar":"عَذَابٌ","tr":"ʿadhābun","en":"(is) a punishment","root":"عذب","lem":"عَذاب"},{"ar":"أَلِيمٌۭ","tr":"alīmun","en":"painful","root":"ألم","lem":"أَلِيم"}]},{"n":16,"juz":28,"ar":"كَمَثَلِ ٱلشَّيْطَـٰنِ إِذْ قَالَ لِلْإِنسَـٰنِ ٱكْفُرْ فَلَمَّا كَفَرَ قَالَ إِنِّى بَرِىٓءٌ مِّنكَ إِنِّىٓ أَخَافُ ٱللَّهَ رَبَّ ٱلْعَـٰلَمِينَ","en":"[The hypocrites are] like the example of Satan when he says to man, \"Disbelieve.\" But when he disbelieves, he says, \"Indeed, I am disassociated from you. Indeed, I fear Allāh, Lord of the worlds.\"","w":[{"ar":"كَمَثَلِ","tr":"kamathali","en":"Like (the) example","root":"مثل","lem":"مَثَل"},{"ar":"ٱلشَّيْطَـٰنِ","tr":"l-shayṭāni","en":"(of) the Shaitaan","root":"شطن","lem":"شَيْطان"},{"ar":"إِذْ","tr":"idh","en":"when"},{"ar":"قَالَ","tr":"qāla","en":"he says","root":"قول","lem":"قالَ"},{"ar":"لِلْإِنسَـٰنِ","tr":"lil'insāni","en":"to man","root":"أنس","lem":"إِنسان"},{"ar":"ٱكْفُرْ","tr":"uk'fur","en":"Disbelieve","root":"كفر","lem":"كَفَرَ"},{"ar":"فَلَمَّا","tr":"falammā","en":"But when"},{"ar":"كَفَرَ","tr":"kafara","en":"he disbelieves","root":"كفر","lem":"كَفَرَ"},{"ar":"قَالَ","tr":"qāla","en":"he says","root":"قول","lem":"قالَ"},{"ar":"إِنِّى","tr":"innī","en":"Indeed, I am"},{"ar":"بَرِىٓءٌۭ","tr":"barīon","en":"disassociated","root":"برأ","lem":"بَرِيء"},{"ar":"مِّنكَ","tr":"minka","en":"from you"},{"ar":"إِنِّىٓ","tr":"innī","en":"Indeed, [I]"},{"ar":"أَخَافُ","tr":"akhāfu","en":"I fear","root":"خوف","lem":"خافَ"},{"ar":"ٱللَّهَ","tr":"l-laha","en":"Allah","root":"أله","lem":"اللَّه"},{"ar":"رَبَّ","tr":"rabba","en":"(the) Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلْعَـٰلَمِينَ","tr":"l-ʿālamīna","en":"(of) the worlds","root":"علم","lem":"عالَم"}]},{"n":17,"juz":28,"ar":"فَكَانَ عَـٰقِبَتَهُمَآ أَنَّهُمَا فِى ٱلنَّارِ خَـٰلِدَيْنِ فِيهَا ۚ وَذَٰلِكَ جَزَٰٓؤُا۟ ٱلظَّـٰلِمِينَ","en":"So the outcome for both of them is that they will be in the Fire, abiding eternally therein. And that is the recompense of the wrongdoers.","w":[{"ar":"فَكَانَ","tr":"fakāna","en":"So will be","root":"كون","lem":"كانَ"},{"ar":"عَـٰقِبَتَهُمَآ","tr":"ʿāqibatahumā","en":"(the) end of both of them","root":"عقب","lem":"عاقِبَة"},{"ar":"أَنَّهُمَا","tr":"annahumā","en":"that they"},{"ar":"فِى","tr":"fī","en":"(will be) in"},{"ar":"ٱلنَّارِ","tr":"l-nāri","en":"the Fire","root":"نور","lem":"نار"},{"ar":"خَـٰلِدَيْنِ","tr":"khālidayni","en":"abiding forever","root":"خلد","lem":"خالِد"},{"ar":"فِيهَا ۚ","tr":"fīhā","en":"therein"},{"ar":"وَذَٰلِكَ","tr":"wadhālika","en":"And that"},{"ar":"جَزَٰٓؤُا۟","tr":"jazāu","en":"(is the) recompense","root":"جزي","lem":"جَزاء"},{"ar":"ٱلظَّـٰلِمِينَ","tr":"l-ẓālimīna","en":"(of) the wrongdoers","root":"ظلم","lem":"ظالِم"}]},{"n":18,"juz":28,"ar":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَلْتَنظُرْ نَفْسٌ مَّا قَدَّمَتْ لِغَدٍ ۖ وَٱتَّقُوا۟ ٱللَّهَ ۚ إِنَّ ٱللَّهَ خَبِيرٌۢ بِمَا تَعْمَلُونَ","en":"O you who have believed, fear Allāh. And let every soul look to what it has put forth for tomorrow - and fear Allāh. Indeed, Allāh is Aware of what you do.","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O","root":"أيي","lem":"أَيّ"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"you (who)"},{"ar":"ءَامَنُوا۟","tr":"āmanū","en":"believe","root":"أمن","lem":"آمَنَ"},{"