t never will Allāh delay a soul when its time has come. And Allāh is Aware of what you do.","w":[{"ar":"وَلَن","tr":"walan","en":"But never"},{"ar":"يُؤَخِّرَ","tr":"yu-akhira","en":"will (be) delayed","root":"أخر","lem":"أَخَّرَ"},{"ar":"ٱللَّهُ","tr":"l-lahu","en":"(by) Allah","root":"أله","lem":"اللَّه"},{"ar":"نَفْسًا","tr":"nafsan","en":"a soul","root":"نفس","lem":"نَفْس"},{"ar":"إِذَا","tr":"idhā","en":"when"},{"ar":"جَآءَ","tr":"jāa","en":"has come","root":"جيأ","lem":"جاءَ"},{"ar":"أَجَلُهَا ۚ","tr":"ajaluhā","en":"its term","root":"أجل","lem":"أَجَل"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"خَبِيرٌۢ","tr":"khabīrun","en":"(is) All-Aware","root":"خبر","lem":"خَبِير"},{"ar":"بِمَا","tr":"bimā","en":"of what"},{"ar":"تَعْمَلُونَ","tr":"taʿmalūna","en":"you do","root":"عمل","lem":"عَمِلَ"}]}]}