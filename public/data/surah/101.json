{"n":101,"name":"Al-Qari'ah","nameAr":"القارعة","meaning":"The Calamity","ayahs":11,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"ٱلْقَارِعَةُ","en":"The Striking Calamity -","w":[{"ar":"ٱلْقَارِعَةُ","tr":"al-qāriʿatu","en":"The Striking Calamity","root":"قرع","lem":"قارِعَة"}]},{"n":2,"juz":30,"ar":"مَا ٱلْقَارِعَةُ","en":"What is the Striking Calamity?","w":[{"ar":"مَا","tr":"mā","en":"What"},{"ar":"ٱلْقَارِعَةُ","tr":"l-qāriʿatu","en":"(is) the Striking Calamity","root":"قرع","lem":"قارِعَة"}]},{"n":3,"juz":30,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","en":"And what can make you know what is the Striking Calamity?","w":[{"ar":"وَمَآ","tr":"wamā","en":"And what"},{"ar":"أَدْرَىٰكَ","tr":"adrāka","en":"will make you know","root":"دري","lem":"أَدْرَى"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"ٱلْقَارِعَةُ","tr":"l-qāriʿatu","en":"(is) the Striking Calamity","root":"قرع","lem":"قارِعَة"}]},{"n":4,"juz":30,"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","en":"It is the Day when people will be like moths, dispersed,","w":[{"ar":"يَوْمَ","tr":"yawma","en":"(The) Day","root":"يوم","lem":"يَوْم"},{"ar":"يَكُونُ","tr":"yakūnu","en":"will be","root":"كون","lem":"كانَ"},{"ar":"ٱلنَّاسُ","tr":"l-nāsu","en":"the mankind","root":"أنس","lem":"ناس"},{"ar":"كَٱلْفَرَاشِ","tr":"kal-farāshi","en":"like moths","root":"فرش","lem":"فَراش"},{"ar":"ٱلْمَبْثُوثِ","tr":"l-mabthūthi","en":"scattered","root":"بثث","lem":"مَبْثُوث"}]},{"n":5,"juz":30,"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","en":"And the mountains will be like wool, fluffed up.","w":[{"ar":"وَتَكُونُ","tr":"watakūnu","en":"And will be","root":"كون","lem":"كانَ"},{"ar":"ٱلْجِبَالُ","tr":"l-jibālu","en":"the mountains","root":"جبل","lem":"جَبَل"},{"ar":"كَٱلْعِهْنِ","tr":"kal-ʿih'ni","en":"like wool","root":"عهن","lem":"عِهْن"},{"ar":"ٱلْمَنفُوشِ","tr":"l-manfūshi","en":"fluffed up","root":"نفش","lem":"مَنفُوش"}]},{"n":6,"juz":30,"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","en":"Then as f