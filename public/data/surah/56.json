":"وَلَقَدْ","tr":"walaqad","en":"And certainly"},{"ar":"عَلِمْتُمُ","tr":"ʿalim'tumu","en":"you know","root":"علم","lem":"عَلِمَ"},{"ar":"ٱلنَّشْأَةَ","tr":"l-nashata","en":"the creation","root":"نشأ","lem":"نَشْأَة"},{"ar":"ٱلْأُولَىٰ","tr":"l-ūlā","en":"the first","root":"أول","lem":"أَوَّل"},{"ar":"فَلَوْلَا","tr":"falawlā","en":"so why not"},{"ar":"تَذَكَّرُونَ","tr":"tadhakkarūna","en":"you take heed","root":"ذكر","lem":"تَذَكَّرَ"}]},{"n":63,"juz":27,"ar":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","en":"And have you seen that [seed] which you sow?","w":[{"ar":"أَفَرَءَيْتُم","tr":"afara-aytum","en":"And do you see","root":"رأي","lem":"رَأَى"},{"ar":"مَّا","tr":"mā","en":"what"},{"ar":"تَحْرُثُونَ","tr":"taḥruthūna","en":"you sow","root":"حرث","lem":"تَحْرُثُ"}]},{"n":64,"juz":27,"ar":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","en":"Is it you who makes it grow, or are We the grower?","w":[{"ar":"ءَأَنتُمْ","tr":"a-antum","en":"Is it you (who)"},{"ar":"تَزْرَعُونَهُۥٓ","tr":"tazraʿūnahu","en":"cause it to grow","root":"زرع","lem":"تَزْرَعُ"},{"ar":"أَمْ","tr":"am","en":"or"},{"ar":"نَحْنُ","tr":"naḥnu","en":"(are) We"},{"ar":"ٱلزَّٰرِعُونَ","tr":"l-zāriʿūna","en":"the Ones Who grow","root":"زرع","lem":"زارِع"}]},{"n":65,"juz":27,"ar":"لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ","en":"If We willed, We could make it [dry] debris, and you would remain in wonder,","w":[{"ar":"لَوْ","tr":"law","en":"If"},{"ar":"نَشَآءُ","tr":"nashāu","en":"We willed","root":"شيأ","lem":"شاءَ"},{"ar":"لَجَعَلْنَـٰهُ","tr":"lajaʿalnāhu","en":"We (would) surely, make it","root":"جعل","lem":"جَعَلَ"},{"ar":"حُطَـٰمًۭا","tr":"ḥuṭāman","en":"debris","root":"حطم","lem":"حُطام"},{"ar":"فَظَلْتُمْ","tr":"faẓaltum","en":"then you would remain","root":"ظلل","lem":"ظَلَّ"},{"ar":"تَفَكَّهُونَ","tr":"tafakkahūna","en":"wondering","root":"فكه","lem":"تَفَكَّهُ"}]},{"n":66,"juz":27,"ar":"إِنَّا لَمُغْرَمُونَ","en":"[Saying], \"Indeed, we are [now] in debt;","w":[{"ar":"إِنَّا","tr":"innā","en":"Indeed, we"},{"ar":"لَمُغْرَمُونَ","tr":"lamugh'ramūna","en":"surely are laden with debt","root":"غرم","lem":"مُغْرَم"}]},{"n":67,"juz":27,"ar":"بَلْ نَحْنُ مَحْرُومُونَ","en":"Rather, we have been deprived.\"","w":[{"ar":"بَلْ","tr":"bal","en":"Nay"},{"ar":"نَحْنُ","tr":"naḥnu","en":"we"},{"ar":"مَحْرُومُونَ","tr":"maḥrūmūna","en":"(are) deprived","root":"حرم","lem":"مَحْرُوم"}]},{"n":68,"juz":27,"ar":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","en":"And have you seen the water that you drink?","w":[{"ar":"أَفَرَءَيْتُمُ","tr":"afara-aytumu","en":"Do you see","root":"رأي","lem":"رَأَى"},{"ar":"ٱلْمَآءَ","tr":"l-māa","en":"the water","root":"موه","lem":"ماء"},{"ar":"ٱلَّذِى","tr":"alladhī","en":"which"},{"ar":"تَشْرَبُونَ","tr":"tashrabūna","en":"you drink","root":"شرب","lem":"شَرِبَ"}]},{"n":69,"juz":27,"ar":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","en":"Is it you who brought it down from the clouds, or is it We who bring it down?","w":[{"ar":"ءَأَنتُمْ","tr":"a-antum","en":"Is it you"},{"ar":"أَنزَلْتُمُوهُ","tr":"anzaltumūhu","en":"who send it down","root":"نزل","lem":"أَنزَلَ"},{"ar":"مِنَ","tr":"mina","en":"from"},{"ar":"ٱلْمُزْنِ","tr":"l-muz'ni","en":"the rain clouds","root":"مزن","lem":"مُزْن"},{"ar":"أَمْ","tr":"am","en":"or"},{"ar":"نَحْنُ","tr":"naḥnu","en":"We"},{"ar":"ٱلْمُنزِلُونَ","tr":"l-munzilūna","en":"(are) the Ones to send","root":"نزل","lem":"مُنزِل"}]},{"n":70,"juz":27,"ar":"لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ","en":"If We willed, We could make it bitter, so why are you not grateful?","w":[{"ar":"لَوْ","tr":"law","en":"If"},{"ar":"نَشَآءُ","tr":"nashāu","en":"We willed","root":"شيأ","lem":"شاءَ"},{"ar":"جَعَلْنَـٰهُ","tr":"jaʿalnāhu","en":"We (could) make it","root":"جعل","lem":"جَعَلَ"},{"ar":"أُجَاجًۭا","tr":"ujājan","en":"salty","root":"أجج","lem":"أُجاج"},{"ar":"فَلَوْلَا","tr":"falawlā","en":"then why are you not grateful"},{"ar":"تَشْكُرُونَ","tr":"tashkurūna","en":