{"n":73,"name":"Al-Muzzammil","nameAr":"المزمل","meaning":"The Enshrouded One","ayahs":20,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":29,"ar":"يَـٰٓأَيُّهَا ٱلْمُزَّمِّلُ","en":"O you who wraps himself [in clothing]","w":[{"ar":"يَـٰٓأَيُّهَا","tr":"yāayyuhā","en":"O you","root":"أيي","lem":"أَيّ"},{"ar":"ٱلْمُزَّمِّلُ","tr":"l-muzamilu","en":"who wraps himself","root":"زمل","lem":"مُزَّمِّل"}]},{"n":2,"juz":29,"ar":"قُمِ ٱلَّيْلَ إِلَّا قَلِيلًا","en":"Arise [to pray] the night, except for a little -","w":[{"ar":"قُمِ","tr":"qumi","en":"Stand","root":"قوم","lem":"قامَ"},{"ar":"ٱلَّيْلَ","tr":"al-layla","en":"(in) the night","root":"ليل","lem":"لَيْل"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"قَلِيلًۭا","tr":"qalīlan","en":"a little","root":"قلل","lem":"قَلِيل"}]},{"n":3,"juz":29,"ar":"نِّصْفَهُۥٓ أَوِ ٱنقُصْ مِنْهُ قَلِيلًا","en":"Half of it - or subtract from it a little","w":[{"ar":"نِّصْفَهُۥٓ","tr":"niṣ'fahu","en":"Half of it","root":"نصف","lem":"نِصْف"},{"ar":"أَوِ","tr":"awi","en":"or"},{"ar":"ٱنقُصْ","tr":"unquṣ","en":"lessen","root":"نقص","lem":"يُنقَصُ"},{"ar":"مِنْهُ","tr":"min'hu","en":"from it"},{"ar":"قَلِيلًا","tr":"qalīlan","en":"a little","root":"قلل","lem":"قَلِيل"}]},{"n":4,"juz":29,"ar":"أَوْ زِدْ عَلَيْهِ وَرَتِّلِ ٱلْقُرْءَانَ تَرْتِيلًا","en":"Or add to it, and recite the Qur’ān with measured recitation.","w":[{"ar":"أَوْ","tr":"aw","en":"Or"},{"ar":"زِدْ","tr":"zid","en":"add","root":"زيد","lem":"زادَ"},{"ar":"عَلَيْهِ","tr":"ʿalayhi","en":"to it"},{"ar":"وَرَتِّلِ","tr":"warattili","en":"and recite","root":"رتل","lem":"رَتَّلْ"},{"ar":"ٱلْقُرْءَانَ","tr":"l-qur'āna","en":"the Quran","root":"قرأ","lem":"قُرْءان"},{"ar":"تَرْتِيلًا","tr":"tartīlan","en":"(with) measured rhythmic recitation","root":"رتل","lem":"تَرْتِيل"}]},{"n":5,"juz":29,"ar":"إِنَّا سَنُلْقِى عَلَيْكَ قَوْلًا ثَقِيلًا","en":"Indeed, We will cast upon you a heavy word.","w":[{"ar":"إِنَّا","tr":"innā","en":"Indeed, We"},{"ar":"سَنُلْقِى","tr":"sanul'qī","en":"will cast","root":"لقي","lem":"أَلْقَى"},{"ar":"عَلَيْكَ","tr":"ʿalayka","en":"upon you"},{"ar":"قَوْلًۭا","tr":"qawlan","en":"a Word","root":"قول","lem":"قَوْل"},{"ar":"ثَقِيلًا","tr":"thaqīlan","en":"heavy","root":"ثقل","lem":"ثَقِيل"}]},{"n":6,"juz":29,"ar":"إِنَّ نَاشِئَةَ ٱلَّيْلِ هِىَ أَشَدُّ وَطْـًٔا وَأَقْوَمُ قِيلًا","en":"Indeed, the hours of the night are more effective for concurrence [of heart and tongue] and more suitable for words.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"نَاشِئَةَ","tr":"nāshi-ata","en":"(the) rising","root":"نشأ","lem":"ناشِئَة"},{"ar":"ٱلَّيْلِ","tr":"al-layli","en":"(at) the night","root":"ليل","lem":"لَيْل"},{"ar":"هِىَ","tr":"hiya","en":"it"},{"ar":"أَشَدُّ","tr":"ashaddu","en":"(is) very hard","root":"شدد","lem":"أَشَدّ"},{"ar":"وَطْـًۭٔا","tr":"waṭan","en":"and most potent","root":"وطأ","lem":"وَطْء"},{"ar":"وَأَقْوَمُ","tr":"wa-aqwamu","en":"and more suitable","root":"قوم","lem":"أَقْوَم"},{"ar":"قِيلًا","tr":"qīlan","en":"(for) Word","root":"قول","lem":"قِيل"}]},{"n":7,"juz":29,"ar":"إِنَّ لَكَ فِى ٱلنَّهَارِ سَبْحًا طَوِيلًا","en":"Indeed, for you by day is prolonged occupation.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"لَكَ","tr":"laka","en":"for you"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"ٱلنَّهَارِ","tr":"l-nahāri","en":"the day","root":"نهر","lem":"نَهار"},{"ar":"سَبْحًۭا","tr":"sabḥan","en":"(is) occupation","root":"سبح","lem":"سَبْح"},{"ar":"طَوِيلًۭا","tr":"ṭawīlan","en":"prolonged","root":"طول","lem":"طَوِيل"}]},{"n":8,"juz":29,"ar":"وَٱذْكُرِ ٱسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًا","en":"And remember the name of your Lord and devote yourself to Him with [complete] devotion.","w":[{"ar":"وَٱذْكُرِ","tr":"wa-udh'kuri","en":"And remember","root":"ذكر","lem":"ذَكَرَ"},{"ar":"ٱسْمَ","tr":"is'ma","en":"(the) name","root":"سمو","lem":"اسْم"},{"ar":"رَبِّكَ","tr":"rabbika","en":"(of) your Lord","root":"ربب","lem":"رَبّ"},{"ar":"وَتَبَتَّلْ","tr":"watabattal","en":"and devote yourself","root":"بتل","lem":"تَبَتَّلْ"},{"ar":"إِلَيْهِ","tr":"ilayhi","en":"to Him"},{"ar":"تَبْتِيلًۭا","tr":"tabtīlan","en":"(with) devotion","root":"بتل","lem":"تَبْتِيل"}]},{"n":9,"juz":29,"ar":"رَّبُّ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ لَآ إِلَـٰهَ إِلَّا هُوَ فَٱتَّخِذْهُ وَكِيلًا","en":"[He is] the Lord of the East and the West; there is no deity except Him, so take Him as Disposer of [your] affairs.","w":[{"ar":"رَّبُّ","tr":"rabbu","en":"(The) Lord","root":"ربب","lem":"رَبّ"},{"ar":"ٱلْمَشْرِقِ","tr":"l-mashriqi","en":"(of) the east","root":"شرق","lem":"مَشْرِق"},{"ar":"وَٱلْمَغْرِبِ","tr":"wal-maghribi","en":"and the west","root":"غرب","lem":"مَغْرِب"},{"ar":"لَآ","tr":"lā","en":"(there is) no"},{"ar":"إِلَـٰهَ","tr":"ilāha","en":"god","root":"أله","lem":"إِلٰه"},{"ar":"إِلَّا","tr":"illā","en":"except"},{"ar":"هُوَ","tr":"huwa","en":"Him"},{"ar":"فَٱتَّخِذْهُ","tr":"fa-ittakhidh'hu","en":"so take Him","root":"أخذ","lem":"اتَّخَذَ"},{"ar":"وَكِيلًۭا","tr":"wakīlan","en":"(as) Disposer of Affairs","root":"وكل","lem":"وَكِيل"}]},{"n":10,"juz":29,"ar":"وَٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَٱهْجُرْهُمْ هَجْرًا جَمِيلًا","en":"And be patient over what they say and avoid them with gracious avoidance.","w":[{"ar":"وَٱصْبِرْ","tr":"wa-iṣ'bir","en":"And be patient","root":"صبر","lem":"صَبَرَ"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"over"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"يَقُولُونَ","tr":"yaqūlūna","en":"they say","root":"قول","lem":"قالَ"},{"ar":"وَٱهْجُرْهُمْ","tr":"wa-uh'jur'hum","en":"and avoid them","root":"هجر","lem":"اهْجُرْ"},{"ar":"هَجْرًۭا","tr":"hajran","en":"an avoidance","root":"هجر","lem":"هَجْر"},{"ar":"جَمِيلًۭا","tr":"jamīlan","en":"gracious","root":"جمل","lem":"جَمِيل"}]},{"n":11,"juz":29,"ar":"وَذَرْنِى وَٱلْمُكَذِّبِينَ أُو۟لِى ٱلنَّعْمَةِ وَمَهِّلْهُمْ قَلِيلًا","en":"And leave Me with [the matter of] the deniers, those of ease [in life], and allow them respite a little.","w":[{"ar":"وَذَرْنِى","tr":"wadharnī","en":"And leave Me","root":"وذر","lem":"يَذَرَ"},{"ar":"وَٱلْمُكَذِّبِينَ","tr":"wal-mukadhibīna","en":"and the deniers","root":"كذب","lem":"مُكَذِّب"},{"ar":"أُو۟لِى","tr":"ulī","en":"possessors"},{"ar":"ٱلنَّعْمَةِ","tr":"l-naʿmati","en":"(of) the ease","root":"نعم","lem":"نَعْمَة"},{"ar":"وَمَهِّلْهُمْ","tr":"wamahhil'hum","en":"and allow them respite ","root":"مهل","lem":"مَهِّلِ"},{"ar":"قَلِيلًا","tr":"qalīlan","en":"a little","root":"قلل","lem":"قَلِيل"}]},{"n":12,"juz":29,"ar":"إِنَّ لَدَيْنَآ أَنكَالًا وَجَحِيمًا","en":"Indeed, with Us [for them] are shackles and burning fire.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"لَدَيْنَآ","tr":"ladaynā","en":"with Us"},{"ar":"أَنكَالًۭا","tr":"ankālan","en":"(are) shackles","root":"نكل","lem":"أَنكال"},{"ar":"وَجَحِيمًۭا","tr":"wajaḥīman","en":"and burning fire","root":"جحم","lem":"جَحِيم"}]},{"n":13,"juz":29,"ar":"وَطَعَامًا ذَا غُصَّةٍ وَعَذَابًا أَلِيمًا","en":"And food that chokes and a painful punishment -","w":[{"ar":"وَطَعَامًۭا","tr":"waṭaʿāman","en":"And food","root":"طعم","lem":"طَعام"},{"ar":"ذَا","tr":"dhā","en":"that"},{"ar":"غُصَّةٍۢ","tr":"ghuṣṣatin","en":"chokes","root":"غصص","lem":"غُصَّة"},{"ar":"وَعَذَابًا","tr":"waʿadhāban","en":"and a punishment","root":"عذب","lem":"عَذاب"},{"ar":"أَلِيمًۭا","tr":"alīman","en":"painful","root":"ألم","lem":"أَلِيم"}]},{"n":14,"juz":29,"ar":"يَوْمَ تَرْجُفُ ٱلْأَرْضُ وَٱلْجِبَالُ وَكَانَتِ ٱلْجِبَالُ كَثِيبًا مَّهِيلًا","en":"On the Day the earth and the mountains will convulse and the mountains will become a heap of sand pouring down.","w":[{"ar":"يَوْمَ","tr":"yawma","en":"(On the) Day","root":"يوم","lem":"يَوْم"},{"ar":"تَرْجُفُ","tr":"tarjufu","en":"will quake","root":"رجف","lem":"تَرْجُفُ"},{"ar":"ٱلْأَرْضُ","tr":"l-arḍu","en":"the earth","root":"أرض","lem":"أَرْض"},{"ar":"وَٱلْجِبَالُ","tr":"wal-jibālu","en":"and the mountains","root":"جبل","lem":"جَبَل"},{"ar":"وَكَانَتِ","tr":"wakānati","en":"and will become","root":"كون","lem":"كانَ"},{"ar":"ٱلْجِبَالُ","tr":"l-jibālu","en":"the mountains","root":"جبل","lem":"جَبَل"},{"ar":"كَثِيبًۭا","tr":"kathīban","en":"a heap of sand","root":"كثب","lem":"كَثِيب"},{"ar":"مَّهِيلًا","tr":"mahīlan","en":"pouring down","root":"هيل","lem":"مَهِيل"}]},{"n":15,"juz":29,"ar":"إِنَّآ أَرْسَلْنَآ إِلَيْكُمْ رَسُولًا شَـٰهِدًا عَلَيْكُمْ كَمَآ أَرْسَلْنَآ إِلَىٰ فِرْعَوْنَ رَسُولًا","en":"Indeed, We have sent to you a Messenger as a witness upon you just as We sent to Pharaoh a messenger.","w":[{"ar":"إِنَّآ","tr":"innā","en":"Indeed, We"},{"ar":"أَرْسَلْنَآ","tr":"arsalnā","en":"[We] have sent","root":"رسل","lem":"أَرْسَلَ"},{"ar":"إِلَيْكُمْ","tr":"ilaykum","en":"to you"},{"ar":"رَسُولًۭا","tr":"rasūlan","en":"a Messenger","root":"رسل","lem":"رَسُول"},{"ar":"شَـٰهِدًا","tr":"shāhidan","en":"(as) a witness","root":"شهد","lem":"شاهِد"},{"ar":"عَلَيْكُمْ","tr":"ʿalaykum","en":"upon you"},{"ar":"كَمَآ","tr":"kamā","en":"as"},{"ar":"أَرْسَلْنَآ","tr":"arsalnā","en":"We sent","root":"رسل","lem":"أَرْسَلَ"},{"ar":"إِلَىٰ","tr":"ilā","en":"to"},{"ar":"فِرْعَوْنَ","tr":"fir'ʿawna","en":"Firaun"},{"ar":"رَسُولًۭا","tr":"rasūlan","en":"a Messenger","root":"رسل","lem":"رَسُول"}]},{"n":16,"juz":29,"ar":"فَعَصَىٰ فِرْعَوْنُ ٱلرَّسُولَ فَأَخَذْنَـٰهُ أَخْذًا وَبِيلًا","en":"But Pharaoh disobeyed the messenger, so We seized him with a ruinous seizure.","w":[{"ar":"فَعَصَىٰ","tr":"faʿaṣā","en":"But disobeyed","root":"عصي","lem":"عَصا"},{"ar":"فِرْعَوْنُ","tr":"fir'ʿawnu","en":"Firaun"},{"ar":"ٱلرَّسُولَ","tr":"l-rasūla","en":"the Messenger","root":"رسل","lem":"رَسُول"},{"ar":"فَأَخَذْنَـٰهُ","tr":"fa-akhadhnāhu","en":"so We seized him","root":"أخذ","lem":"أَخَذَ"},{"ar":"أَخْذًۭا","tr":"akhdhan","en":"(with) a seizure","root":"أخذ","lem":"أَخْذ"},{"ar":"وَبِيلًۭا","tr":"wabīlan","en":"ruinous","root":"وبل","lem":"وَبِيل"}]},{"n":17,"juz":29,"ar":"فَكَيْفَ تَتَّقُونَ إِن كَفَرْتُمْ يَوْمًا يَجْعَلُ ٱلْوِلْدَٰنَ شِيبًا","en":"Then how can you fear, if you disbelieve, a Day that will make the children white-haired?","w":[{"ar":"فَكَيْفَ","tr":"fakayfa","en":"Then how","root":"كيف","lem":"كَيْف"},{"ar":"تَتَّقُونَ","tr":"tattaqūna","en":"will you guard yourselves","root":"وقي","lem":"اتَّقَى"},{"ar":"إِن","tr":"in","en":"if"},{"ar":"كَفَرْتُمْ","tr":"kafartum","en":"you disbelieve","root":"كفر","lem":"كَفَرَ"},{"ar":"يَوْمًۭا","tr":"yawman","en":"a Day","root":"يوم","lem":"يَوْم"},{"ar":"يَجْعَلُ","tr":"yajʿalu","en":"(that) will make","root":"جعل","lem":"جَعَلَ"},{"ar":"ٱلْوِلْدَٰنَ","tr":"l-wil'dāna","en":"the children","root":"ولد","lem":"وَلِيد"},{"ar":"شِيبًا","tr":"shīban","en":"gray-haired","root":"شيب","lem":"شِيب"}]},{"n":18,"juz":29,"ar":"ٱلسَّمَآءُ مُنفَطِرٌۢ بِهِۦ ۚ كَانَ وَعْدُهُۥ مَفْعُولًا","en":"The heaven will break apart therefrom; ever is His promise fulfilled.","w":[{"ar":"ٱلسَّمَآءُ","tr":"al-samāu","en":"The heaven","root":"سمو","lem":"سَماء"},{"ar":"مُنفَطِرٌۢ","tr":"munfaṭirun","en":"(will) break apart","root":"فطر","lem":"مُنفَطِر"},{"ar":"بِهِۦ ۚ","tr":"bihi","en":"therefrom"},{"ar":"كَانَ","tr":"kāna","en":"is","root":"كون","lem":"كانَ"},{"ar":"وَعْدُهُۥ","tr":"waʿduhu","en":"His Promise","root":"وعد","lem":"وَعْد"},{"ar":"مَفْعُولًا","tr":"mafʿūlan","en":"to be fulfilled","root":"فعل","lem":"مَفْعُول"}]},{"n":19,"juz":29,"ar":"إِنَّ هَـٰذِهِۦ تَذْكِرَةٌ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا","en":"Indeed, this is a reminder, so whoever wills may take to his Lord a way.","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"هَـٰذِهِۦ","tr":"hādhihi","en":"this"},{"ar":"تَذْكِرَةٌۭ ۖ","tr":"tadhkiratun","en":"(is) a Reminder","root":"ذكر","lem":"تَذْكِرَة"},{"ar":"فَمَن","tr":"faman","en":"then whoever"},{"ar":"شَآءَ","tr":"shāa","en":"wills","root":"شيأ","lem":"شاءَ"},{"ar":"ٱتَّخَذَ","tr":"ittakhadha","en":"(let him) take","root":"أخذ","lem":"اتَّخَذَ"},{"ar":"إِلَىٰ","tr":"ilā","en":"to"},{"ar":"رَبِّهِۦ","tr":"rabbihi","en":"his Lord","root":"ربب","lem":"رَبّ"},{"ar":"سَبِيلًا","tr":"sabīlan","en":"a way","root":"سبل","lem":"سَبِيل"}]},{"n":20,"juz":29,"ar":"۞ إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَىٰ مِن ثُلُثَىِ ٱلَّيْلِ وَنِصْفَهُۥ وَثُلُثَهُۥ وَطَآئِفَةٌ مِّنَ ٱلَّذِينَ مَعَكَ ۚ وَٱللَّهُ يُقَدِّرُ ٱلَّيْلَ وَٱلنَّهَارَ ۚ عَلِمَ أَن لَّن تُحْصُوهُ فَتَابَ عَلَيْكُمْ ۖ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنَ ٱلْقُرْءَانِ ۚ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرْضَىٰ ۙ وَءَاخَرُونَ يَضْرِبُونَ فِى ٱلْأَرْضِ يَبْتَغُونَ مِن فَضْلِ ٱللَّهِ ۙ وَءَاخَرُونَ يُقَـٰتِلُونَ فِى سَبِيلِ ٱللَّهِ ۖ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنْهُ ۚ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَقْرِضُوا۟ ٱللَّهَ قَرْضًا حَسَنًا ۚ وَمَا تُقَدِّمُوا۟ لِأَنفُسِكُم مِّنْ خَيْرٍ تَجِدُوهُ عِندَ ٱللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًا ۚ وَٱسْتَغْفِرُوا۟ ٱللَّهَ ۖ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌۢ","en":"Indeed, your Lord knows, [O Muḥammad], that you stand [in prayer] almost two thirds of the night or half of it or a third of it, and [so do] a group of those with you. And Allāh determines [the extent of] the night and the day. He has known that you [Muslims] will not be able to do it and has turned to you in forgiveness, so recite what is easy [for you] of the Qur’ān. He has known that there will be among you those who are ill and others traveling throughout the land seeking [something] of the bounty of Allāh and others fighting for the cause of Allāh. So recite what is easy from it and establish prayer and give zakāh and loan Allāh a goodly loan. And whatever good you put forward for yourselves - you will find it with Allāh. It is better and greater in reward. And seek forgiveness of Allāh. Indeed, Allāh is Forgiving and Merciful.","w":[{"ar":"۞ إِنَّ","tr":"inna","en":"Indeed"},{"ar":"رَبَّكَ","tr":"rabbaka","en":"your Lord","root":"ربب","lem":"رَبّ"},{"ar":"يَعْلَمُ","tr":"yaʿlamu","en":"knows","root":"علم","lem":"عَلِمَ"},{"ar":"أَنَّكَ","tr":"annaka","en":"that you"},{"ar":"تَقُومُ","tr":"taqūmu","en":"stand","root":"قوم","lem":"قامَ"},{"ar":"أَدْنَىٰ","tr":"adnā","en":"(a little) less","root":"دنو","lem":"أَدْنَى"},{"ar":"مِن","tr":"min","en":"than"},{"ar":"ثُلُثَىِ","tr":"thuluthayi","en":"two-thirds","root":"ثلث","lem":"ثُلُث"},{"ar":"ٱلَّيْلِ","tr":"al-layli","en":"(of) the night","root":"ليل","lem":"لَيْل"},{"ar":"وَنِصْفَهُۥ","tr":"waniṣ'fahu","en":"and half of it","root":"نصف","lem":"نِصْف"},{"ar":"وَثُلُثَهُۥ","tr":"wathuluthahu","en":"and a third of it","root":"ثلث","lem":"ثُلُث"},{"ar":"وَطَآئِفَةٌۭ","tr":"waṭāifatun","en":"and (so do) a group","root":"طوف","lem":"طائِفَة"},{"ar":"مِّنَ","tr":"mina","en":"of"},{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"those who"},{"ar":"مَعَكَ ۚ","tr":"maʿaka","en":"(are) with you"},{"ar":"وَٱللَّهُ","tr":"wal-lahu","en":"And Allah","root":"أله","lem":"اللَّه"},{"ar":"يُقَدِّرُ","tr":"yuqaddiru","en":"determines","root":"قدر","lem":"قَدَّرَ"},{"ar":"ٱلَّيْلَ","tr":"al-layla","en":"the night","root":"ليل","lem":"لَيْل"},{"ar":"وَٱلنَّهَارَ ۚ","tr":"wal-nahāra","en":"and the day","root":"نهر","lem":"نَهار"},{"ar":"عَلِمَ","tr":"ʿalima","en":"He knows","root":"علم","lem":"عَلِمَ"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"لَّن","tr":"lan","en":"not"},{"ar":"تُحْصُوهُ","tr":"tuḥ'ṣūhu","en":"you count it","root":"حصي","lem":"أَحْصَى"},{"ar":"فَتَابَ","tr":"fatāba","en":"so He has turned","root":"توب","lem":"تابَ"},{"ar":"عَلَيْكُمْ ۖ","tr":"ʿalaykum","en":"to you"},{"ar":"فَٱقْرَءُوا۟","tr":"fa-iq'raū","en":"so recite","root":"قرأ","lem":"قَرَأَ"},{"ar":"مَا","tr":"mā","en":"what"},{"ar":"تَيَسَّرَ","tr":"tayassara","en":"is easy","root":"يسر","lem":"تَيَسَّرَ"},{"ar":"مِنَ","tr":"mina","en":"of"},{"ar":"ٱلْقُرْءَانِ ۚ","tr":"l-qur'āni","en":"the Quran","root":"قرأ","lem":"قُرْءان"},{"ar":"عَلِمَ","tr":"ʿalima","en":"He knows","root":"علم","lem":"عَلِمَ"},{"ar":"أَن","tr":"an","en":"that"},{"ar":"سَيَكُونُ","tr":"sayakūnu","en":"there will be","root":"كون","lem":"كانَ"},{"ar":"مِنكُم","tr":"minkum","en":"among you"},{"ar":"مَّرْضَىٰ ۙ","tr":"marḍā","en":"sick","root":"مرض","lem":"مَرِيض"},{"ar":"وَءَاخَرُونَ","tr":"waākharūna","en":"and others","root":"أخر","lem":"آخ