{"n":99,"name":"Az-Zalzalah","nameAr":"الزلزلة","meaning":"The Earthquake","ayahs":8,"place":"madinah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","en":"When the earth is shaken with its [final] earthquake","w":[{"ar":"إِذَا","tr":"idhā","en":"When"},{"ar":"زُلْزِلَتِ","tr":"zul'zilati","en":"is shaken","root":"زلزل","lem":"زُلْزِلُ"},{"ar":"ٱلْأَرْضُ","tr":"l-arḍu","en":"the earth","root":"أرض","lem":"أَرْض"},{"ar":"زِلْزَالَهَا","tr":"zil'zālahā","en":"(with) its earthquake","root":"زلزل","lem":"زِلْزال"}]},{"n":2,"juz":30,"ar":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","en":"And the earth discharges its burdens","w":[{"ar":"وَأَخْرَجَتِ","tr":"wa-akhrajati","en":"And brings forth","root":"خرج","lem":"أَخْرَجَ"},{"ar":"ٱلْأَرْضُ","tr":"l-arḍu","en":"the earth","root":"أرض","lem":"أَرْض"},{"ar":"أَثْقَالَهَا","tr":"athqālahā","en":"its burdens","root":"ثقل","lem":"ثَقَل"}]},{"n":3,"juz":30,"ar":"وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا","en":"And man says, \"What is [wrong] with it?\" -","w":[{"ar":"وَقَالَ","tr":"waqāla","en":"And says","root":"قول","lem":"قالَ"},{"ar":"ٱلْإِنسَـٰنُ","tr":"l-insānu","en":"man","root":"أنس","lem":"إِنسان"},{"ar":"مَا","tr":"mā","en":"What"},{"ar":"لَهَا","tr":"lahā","en":"(is) with it"}]},{"n":4,"juz":30,"ar":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا","en":"That Day, it will report its news","w":[{"ar":"يَوْمَئِذٍۢ","tr":"yawma-idhin","en":"That Day","root":"يوم","lem":"يَوْم"},{"ar":"تُحَدِّثُ","tr":"tuḥaddithu","en":"it will report","root":"حدث","lem":"تُحَدِّثُ"},{"ar":"أَخْبَارَهَا","tr":"akhbārahā","en":"its news","root":"خبر","lem":"أَخْبار"}]},{"n":5,"juz":30,"ar":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","en":"Because your Lord has inspired [i.e., commanded] it.","w":[{"ar":"بِأَنَّ","tr":"bi-anna","en":"Because"},{"ar":"رَبَّكَ","tr":"rabbaka","en":"your Lord","root":"ربب","lem":"رَبّ"},{"ar":"أَوْحَىٰ","tr":"awḥā","en":"inspired","root":"وحي","lem":"أَوْحَى"},{"ar":"لَهَا","tr":"lahā","en":"[to] it"}]},{"n":6,"juz":30,"ar":"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ","en":"That Day, the people will depart separated [into categories] to be shown [the result of] their deeds.","w":[{"ar":"يَوْمَئِذٍۢ","tr":"yawma-idhin","en":"That Day","root":"يوم","lem":"يَوْم"},{"ar":"يَصْدُرُ","tr":"yaṣduru","en":"will proceed","root":"صدر","lem":"يَصْدُرُ"},{"ar":"ٱلنَّاسُ","tr":"l-nāsu","en":"the mankind","root":"أنس","lem":"ناس"},{"ar":"أَشْتَاتًۭا","tr":"ashtātan","en":"(in) scattered groups","root":"شتت","lem":"أَشْتات"},{"ar":"لِّيُرَوْا۟","tr":"liyuraw","en":"to be shown","root":"رأي","lem":"أَرَيْ"},{"ar":"أَعْمَـٰلَهُمْ","tr":"aʿmālahum","en":"their deeds","root":"عمل","lem":"عَمَل"}]},{"n":7,"juz":30,"ar":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ","en":"So whoever does an atom's weight of good will see it,","w":[{"ar":"فَمَن","tr":"faman","en":"So whoever"},{"ar":"يَعْمَلْ","tr":"yaʿmal","en":"does","root":"عمل","lem":"عَمِلَ"},{"ar":"مِثْقَالَ","tr":"mith'qāla","en":"(equal to the) weight","root":"ثقل","lem":"مِثْقال"},{"ar":"ذَرَّةٍ","tr":"dharratin","en":"(of) an atom","root":"ذرر","lem":"ذَرَّة"},{"ar":"خَيْرًۭا","tr":"khayran","en":"good","root":"خير","lem":"خَيْر"},{"ar":"يَرَهُۥ","tr":"yarahu","en":"will see it","root":"رأي","lem":"رَأَى"}]},{"n":8,"juz":30,"ar":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ","en":"And whoever does an atom's weight of evil will see it.","w":[{"ar":"وَمَن","tr":"waman","en":"And whoever"},{"ar":"يَعْمَلْ","tr":"yaʿmal","en":"does","root":"عمل","lem":"عَمِلَ"},{"ar":"مِثْقَالَ","tr":"mith'qāla","en":"(equal to the) weight","root":"ثقل","lem":"مِثْقال"},{"ar":"ذَرَّةٍۢ","tr":"dharratin","en":"(of) an atom","root":"ذرر","lem":"ذَرَّة"},{"ar":"شَرًّۭا","tr":"sharran","en":"evil","root":"شرر","lem":"شَرّ"},{"ar":"يَرَهُۥ","tr":"yarahu","en":"will see it","root":"رأي","lem":"رَأَى"}]}]}