","en":"they say","root":"قول","lem":"قالَ"},{"ar":"وَمَآ","tr":"wamā","en":"and not"},{"ar":"أَنتَ","tr":"anta","en":"(are) you"},{"ar":"عَلَيْهِم","tr":"ʿalayhim","en":"over them"},{"ar":"بِجَبَّارٍۢ ۖ","tr":"bijabbārin","en":"the one to compel","root":"جبر","lem":"جَبّار"},{"ar":"فَذَكِّرْ","tr":"fadhakkir","en":"But remind","root":"ذكر","lem":"ذُكِّرَ"},{"ar":"بِٱلْقُرْءَانِ","tr":"bil-qur'āni","en":"with the Quran","root":"قرأ","lem":"قُرْءان"},{"ar":"مَن","tr":"man","en":"whoever"},{"ar":"يَخَافُ","tr":"yakhāfu","en":"fears","root":"خوف","lem":"خافَ"},{"ar":"وَعِيدِ","tr":"waʿīdi","en":"My threat","root":"وعد","lem":"وَعِيد"}]}]}