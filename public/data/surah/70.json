":"the man","root":"أنس","lem":"إِنسان"},{"ar":"خُلِقَ","tr":"khuliqa","en":"was created","root":"خلق","lem":"خَلَقَ"},{"ar":"هَلُوعًا","tr":"halūʿan","en":"anxious ","root":"هلع","lem":"هَلُوع"}]},{"n":20,"juz":29,"ar":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا","en":"When evil touches him, impatient,","w":[{"ar":"إِذَا","tr":"idhā","en":"When"},{"ar":"مَسَّهُ","tr":"massahu","en":"touches him","root":"مسس","lem":"مَسَّ"},{"ar":"ٱلشَّرُّ","tr":"l-sharu","en":"the evil","root":"شرر","lem":"شَرّ"},{"ar":"جَزُوعًۭا","tr":"jazūʿan","en":"distressed","root":"جزع","lem":"جَزُوع"}]},{"n":21,"juz":29,"ar":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","en":"And when good touches him, withholding [of it],","w":[{"ar":"وَإِذَا","tr":"wa-idhā","en":"And when"},{"ar":"مَسَّهُ","tr":"massahu","en":"touches him","root":"مسس","lem":"مَسَّ"},{"ar":"ٱلْخَيْرُ","tr":"l-khayru","en":"the good","root":"خير","lem":"خَيْر"},{"ar":"مَنُوعًا","tr":"manūʿan","en":"withholding","root":"منع","lem":"مَنُوع"}]},{"n":22,"juz":29,"ar":"إِلَّا ٱلْمُصَلِّينَ","en":"Except the observers of prayer -","w":[{"ar":"إِلَّا","tr":"illā","en":"Except"},{"ar":"ٱلْمُصَلِّينَ","tr":"l-muṣalīna","en":"those who pray ","root":"صلو","lem":"مُصَلّي"}]},{"n":23,"juz":29,"ar":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ","en":"Those who are constant in their prayer","w":[{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"Those who"},{"ar":"هُمْ","tr":"hum","en":"[they]"},{"ar":"عَلَىٰ","tr":"ʿalā","en":"at"},{"ar":"صَلَاتِهِمْ","tr":"ṣalātihim","en":"their prayer","root":"صلو","lem":"صَلاة"},{"ar":"دَآئِمُونَ","tr":"dāimūna","en":"(are) constant","root":"دوم","lem":"دائِم"}]},{"n":24,"juz":29,"ar":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ","en":"And those within whose wealth is a known right","w":[{"ar":"وَٱلَّذِينَ","tr":"wa-alladhīna","en":"And those who"},{"ar":"فِىٓ","tr":"fī","en":"in"},{"ar":"أَمْوَٰلِهِمْ","tr":"amwālihim","en":"their wealth","root":"مول","lem":"مال"},{"ar":"حَقٌّۭ","tr":"ḥaqqun","en":"(is) a right","root":"حق