{"n":83,"name":"Al-Mutaffifin","nameAr":"المطففين","meaning":"The Defrauding","ayahs":36,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":30,"ar":"وَيْلٌ لِّلْمُطَفِّفِينَ","en":"Woe to those who give less [than due],","w":[{"ar":"وَيْلٌۭ","tr":"waylun","en":"Woe"},{"ar":"لِّلْمُطَفِّفِينَ","tr":"lil'muṭaffifīna","en":"to those who give less","root":"طفف","lem":"مُطَفِّف"}]},{"n":2,"juz":30,"ar":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","en":"Who, when they take a measure from people, take in full.","w":[{"ar":"ٱلَّذِينَ","tr":"alladhīna","en":"Those who"},{"ar":"إِذَا","tr":"idhā","en":"when"},{"ar":"ٱكْتَالُوا۟","tr":"ik'tālū","en":"they take a measure","root":"كيل","lem":"اكْتالُ"},{"ar":"عَلَى","tr":"ʿalā","en":"from"},{"ar":"ٱلنَّاسِ","tr":"l-nāsi","en":"the people","root":"أنس","lem":"ناس"},{"ar":"يَسْتَوْفُونَ","tr":"yastawfūna","en":"they take in full","root":"وفي","lem":"يَسْتَوْفُ"}]},{"n":3,"juz":30,"ar":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","en":"But if they give by measure or by weight to them, they cause loss.","w":[{"ar":"وَإِذَا","tr":"wa-idhā","en":"But when"},{"ar":"كَالُوهُمْ","tr":"kālūhum","en":"they give by measure (to) them","root":"كيل","lem":"كالُ"},{"ar":"أَو","tr":"aw","en":"or"},{"ar":"وَّزَنُوهُمْ","tr":"wazanūhum","en":"they weigh (for) them","root":"وزن","lem":"وَزَنُ"},{"ar":"يُخْسِرُونَ","tr":"yukh'sirūna","en":"they give less","root":"خسر","lem":"يُخْسِرُ"}]},{"n":4,"juz":30,"ar":"أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","en":"Do they not think that they will be resurrected","w":[{"ar":"أَلَا","tr":"alā","en":"Do not"},{"ar":"يَظُنُّ","tr":"yaẓunnu","en":"think","root":"ظنن","lem":"ظَنَّ"},{"ar":"أُو۟لَـٰٓئِكَ","tr":"ulāika","en":"those"},{"ar":"أَنَّهُم","tr":"annahum","en":"that they"},{"ar":"مَّبْعُوثُونَ","tr":"mabʿūthūna","en":"(will be) resurrected","root":"بعث","lem":"مَبْعُوث"}]},{"n":5,"juz":30,"ar":"لِيَوْمٍ عَظِيمٍ","en":"For a tremendous Day -","w":[{"ar":"لِيَوْمٍ","tr":"liy