"en":"On"},{"ar":"ٱلْأَرَآئِكِ","tr":"l-arāiki","en":"thrones","root":"أرك","lem":"أَرائِك"},{"ar":"يَنظُرُونَ","tr":"yanẓurūna","en":"observing","root":"نظر","lem":"نَظَرَ"}]},{"n":24,"juz":30,"ar":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","en":"You will recognize in their faces the radiance of pleasure.","w":[{"ar":"تَعْرِفُ","tr":"taʿrifu","en":"You will recognize","root":"عرف","lem":"عَرَفَ"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"وُجُوهِهِمْ","tr":"wujūhihim","en":"their faces","root":"وجه","lem":"وَجْه"},{"ar":"نَضْرَةَ","tr":"naḍrata","en":"(the) radiance","root":"نضر","lem":"نَضْرَة"},{"ar":"ٱلنَّعِيمِ","tr":"l-naʿīmi","en":"(of) bliss","root":"نعم","lem":"نَعِيم"}]},{"n":25,"juz":30,"ar":"يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ","en":"They will be given to drink [pure] wine [which was] sealed.","w":[{"ar":"يُسْقَوْنَ","tr":"yus'qawna","en":"They will be given to drink","root":"سقي","lem":"أَسْقَيْ"},{"ar":"مِن","tr":"min","en":"of"},{"ar":"رَّحِيقٍۢ","tr":"raḥīqin","en":"a pure wine","root":"رحق","lem":"رَحِيق"},{"ar":"مَّخْتُومٍ","tr":"makhtūmin","en":"sealed","root":"ختم","lem":"مَخْتُوم"}]},{"n":26,"juz":30,"ar":"خِتَـٰمُهُۥ مِسْكٌ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَـٰفِسُونَ","en":"The last of it is musk. So for this let the competitors compete.","w":[{"ar":"خِتَـٰمُهُۥ","tr":"khitāmuhu","en":"Its seal","root":"ختم","lem":"خِتام"},{"ar":"مِسْكٌۭ ۚ","tr":"mis'kun","en":"(will be of) musk","root":"مسك","lem":"مِسْك"},{"ar":"وَفِى","tr":"wafī","en":"And for"},{"ar":"ذَٰلِكَ","tr":"dhālika","en":"that"},{"ar":"فَلْيَتَنَافَسِ","tr":"falyatanāfasi","en":"let aspire","root":"نفس","lem":"يَتَنافَسِ"},{"ar":"ٱلْمُتَنَـٰفِسُونَ","tr":"l-mutanāfisūna","en":"the aspirers","root":"نفس","lem":"مُتَنافِس"}]},{"n":27,"juz":30,"ar":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","en":"And its mixture is of Tasneem,","w":[{"ar":"وَمِزَاجُهُۥ","tr":"wamizājuhu","en":"And its mixture","root":"مزج","lem":"مِزاج"},{"ar":"مِن","tr":"min","en":"(is) of"},{"ar":"تَسْنِيمٍ","tr":"tasnīmin