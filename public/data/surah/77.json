{"n":77,"name":"Al-Mursalat","nameAr":"المرسلات","meaning":"The Emissaries","ayahs":50,"place":"makkah","bismillah":true,"ayat":[{"n":1,"juz":29,"ar":"وَٱلْمُرْسَلَـٰتِ عُرْفًا","en":"By those [winds] sent forth in gusts","w":[{"ar":"وَٱلْمُرْسَلَـٰتِ","tr":"wal-mur'salāti","en":"By the ones sent forth","root":"رسل","lem":"مُرْسَلَة"},{"ar":"عُرْفًۭا","tr":"ʿur'fan","en":"one after another","root":"عرف","lem":"عُرْف"}]},{"n":2,"juz":29,"ar":"فَٱلْعَـٰصِفَـٰتِ عَصْفًا","en":"And the winds that blow violently","w":[{"ar":"فَٱلْعَـٰصِفَـٰتِ","tr":"fal-ʿāṣifāti","en":"And the winds that blow","root":"عصف","lem":"عاصِفَة"},{"ar":"عَصْفًۭا","tr":"ʿaṣfan","en":"violently","root":"عصف","lem":"عَصْف"}]},{"n":3,"juz":29,"ar":"وَٱلنَّـٰشِرَٰتِ نَشْرًا","en":"And [by] the winds that spread [clouds]","w":[{"ar":"وَٱلنَّـٰشِرَٰتِ","tr":"wal-nāshirāti","en":"And the ones that scatter","root":"نشر","lem":"ناشِرَة"},{"ar":"نَشْرًۭا","tr":"nashran","en":"far and wide","root":"نشر","lem":"نَشْر"}]},{"n":4,"juz":29,"ar":"فَٱلْفَـٰرِقَـٰتِ فَرْقًا","en":"And those [angels] who bring criterion","w":[{"ar":"فَٱلْفَـٰرِقَـٰتِ","tr":"fal-fāriqāti","en":"And those who separate","root":"فرق","lem":"فارِقَة"},{"ar":"فَرْقًۭا","tr":"farqan","en":"(by the) Criterion","root":"فرق","lem":"فَرْق"}]},{"n":5,"juz":29,"ar":"فَٱلْمُلْقِيَـٰتِ ذِكْرًا","en":"And those [angels] who deliver a message.","w":[{"ar":"فَٱلْمُلْقِيَـٰتِ","tr":"fal-mul'qiyāti","en":"And those who bring down","root":"لقي","lem":"مُلْقِيَة"},{"ar":"ذِكْرًا","tr":"dhik'ran","en":"(the) Reminder","root":"ذكر","lem":"ذِكْر"}]},{"n":6,"juz":29,"ar":"عُذْرًا أَوْ نُذْرًا","en":"As justification or warning,","w":[{"ar":"عُذْرًا","tr":"ʿudh'ran","en":"(As) justification","root":"عذر","lem":"عُذْر"},{"ar":"أَوْ","tr":"aw","en":"or"},{"ar":"نُذْرًا","tr":"nudh'ran","en":"warning","root":"نذر","lem":"نُذْر"}]},{"n":7,"juz":29,"ar":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ","en":"Indeed, what you are promised is to occur.","w":[{"ar":"إِنَّمَا","tr":"