}]},{"n":18,"juz":30,"ar":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا","en":"The Day the Horn is blown and you will come forth in multitudes","w":[{"ar":"يَوْمَ","tr":"yawma","en":"(The) Day","root":"يوم","lem":"يَوْم"},{"ar":"يُنفَخُ","tr":"yunfakhu","en":"(in which) shall be blown","root":"نفخ","lem":"نَفَخَ"},{"ar":"فِى","tr":"fī","en":"in"},{"ar":"ٱلصُّورِ","tr":"l-ṣūri","en":"the trumpet","root":"صور","lem":"صُور"},{"ar":"فَتَأْتُونَ","tr":"fatatūna","en":"and you will come forth","root":"أتي","lem":"أَتَى"},{"ar":"أَفْوَاجًۭا","tr":"afwājan","en":"(in) crowds","root":"فوج","lem":"فَوْج"}]},{"n":19,"juz":30,"ar":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا","en":"And the heaven is opened and will become gateways.","w":[{"ar":"وَفُتِحَتِ","tr":"wafutiḥati","en":"And is opened","root":"فتح","lem":"فَتَحَ"},{"ar":"ٱلسَّمَآءُ","tr":"l-samāu","en":"the heaven","root":"سمو","lem":"سَماء"},{"ar":"فَكَانَتْ","tr":"fakānat","en":"and becomes","root":"كون","lem":"كانَ"},{"ar":"أَبْوَٰبًۭا","tr":"abwāban","en":"gateways","root":"بوب","lem":"باب"}]},{"n":20,"juz":30,"ar":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","en":"And the mountains are removed and will be [but] a mirage.","w":[{"ar":"وَسُيِّرَتِ","tr":"wasuyyirati","en":"And are moved","root":"سير","lem":"سُيِّرَتْ"},{"ar":"ٱلْجِبَالُ","tr":"l-jibālu","en":"the mountains","root":"جبل","lem":"جَبَل"},{"ar":"فَكَانَتْ","tr":"fakānat","en":"and become","root":"كون","lem":"كانَ"},{"ar":"سَرَابًا","tr":"sarāban","en":"a mirage","root":"سرب","lem":"سَراب"}]},{"n":21,"juz":30,"ar":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","en":"Indeed, Hell has been lying in wait","w":[{"ar":"إِنَّ","tr":"inna","en":"Indeed"},{"ar":"جَهَنَّمَ","tr":"jahannama","en":"Hell"},{"ar":"كَانَتْ","tr":"kānat","en":"is","root":"كون","lem":"كانَ"},{"ar":"مِرْصَادًۭا","tr":"mir'ṣādan","en":"lying in wait","root":"رصد","lem":"مِرْصاد"}]},{"n":22,"juz":30,"ar":"لِّلطَّـٰغِينَ مَـَٔابًا","en":"For the transgressors, a place of return,","w":[{"ar":"لّ